{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(~/.secrets)",
      "Edit(~/.secrets)",
      "Read(~/.secrets.*)",
      "Edit(~/.secrets.*)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/git/credentials)",
      "Edit(~/.config/git/credentials)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(//**/.env)",
      "Edit(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env.*)",
      "Read(//**/*.env)",
      "Edit(//**/*.env)",
      "Read(//**/.secrets)",
      "Edit(//**/.secrets)",
      "Read(//**/.secrets.*)",
      "Edit(//**/.secrets.*)",
      "Read(//**/secrets/**)",
      "Edit(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Bash(* .env*)",
      "Bash(* .secrets*)",
      "Bash(*git-credentials*)",
      "Bash(*config/git/credentials*)",
      "Bash(*.netrc*)",
      "Bash(*ssh/id_*)",
      "Bash(*ssh/*.pem*)",
      "Bash(*~/.secrets*)",
      "Bash(*~/.ssh*)",
      "Bash(*~/.gnupg*)",
      "Bash(*~/.aws*)",
      "Bash(*~/.kube*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv *)",
      "Bash(*_TOKEN*)",
      "Bash(*_SECRET*)",
      "Bash(*_API_KEY*)",
      "Bash(*APIKEY*)",
      "Bash(*SJEL_AGENT=0*)",
      "Bash(*capability-auth comms*)",
      "Bash(*capability-auth)",
      "Bash(*capability-auth\")",
      "Bash(*capability-auth |*)",
      "Bash(*capability-auth >*)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(shred *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(git push *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit --visibility public *)"
    ]
  },
  "sandbox": {
    "enabledPlatforms": [
      "linux",
      "macos"
    ],
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.secrets",
        "~/.secrets.*",
        "~/**/secrets/**",
        "~/.git-credentials",
        "~/.config/git/credentials",
        "~/.netrc",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.kube/**",
        "~/**/.env",
        "~/**/.env.*",
        "~/**/*.env",
        "~/**/.secrets",
        "~/**/.secrets.*",
        "~/**/*.pem",
        "~/**/*.key"
      ],
      "denyWrite": [
        "/etc/**",
        "/usr/**",
        "/bin/**",
        "/sbin/**",
        "/lib/**",
        "/lib64/**",
        "~/**/secrets/**",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.kube/**",
        "~/**/.env",
        "~/**/.env.*",
        "~/**/*.env",
        "~/**/.secrets",
        "~/**/.secrets.*",
        "~/**/*.pem",
        "~/**/*.key"
      ],
      "allowManagedReadPathsOnly": true
    },
    "credentials": {
      "files": [
        {
          "path": "~/.secrets",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.config/git/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.kube",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "localhost",
        "127.0.0.1"
      ]
    }
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [
    { "serverCommand": ["${HOME}/.local/bin/sjel", "mcp"] }
  ],
  "disableSideloadFlags": true
}
