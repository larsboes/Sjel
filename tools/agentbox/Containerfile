# The agentbox image: one agent binary, the handful of CLI tools its bash tool
# reaches for, a non-root user, nothing else.
#
# Agent-neutral by construction — which agent, which version, which archive all
# arrive as build args from `agentbox build`. Nothing in here names pi.
#
# No network operation happens during this build except apt. The agent archive is
# fetched on the HOST by `agentbox build` and verified there against the release's own
# published SHA256SUMS, then handed in as the build context — so the only thing that enters
# the image is a file whose checksum was checked where you can see it, and checked again
# below.

# Rolling, not a dated tag (Q77, 2026-09-02). `trixie-slim` is Debian's own channel for
# the current stable slim image: `agentbox build` takes each rebuild the day it is published,
# which is where the base layer's CVE fixes arrive. It named trixie-20260713-slim until then,
# and that literal went stale the first time Debian rebuilt under it.
ARG BASE_IMAGE=docker.io/library/debian:trixie-slim

FROM ${BASE_IMAGE}

# git and ripgrep back the agent's bash tool; ca-certificates is there for the day
# a task legitimately needs TLS. A small surface is part of the security argument.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git \
      ripgrep \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# UID/GID come from the invoking host user, so files the agent writes into the
# mounted project are owned by that user instead of landing as a foreign uid 1000.
# The group may already exist (macOS gid 20 is `dialout` on Debian), hence the guard.
ARG AGENT_UID=1000
ARG AGENT_GID=1000
RUN if ! getent group "${AGENT_GID}" >/dev/null; then groupadd --gid "${AGENT_GID}" agent; fi \
 && useradd --uid "${AGENT_UID}" --gid "${AGENT_GID}" --create-home --shell /bin/bash agent

ARG AGENT_NAME
ARG AGENT_VERSION
ARG ARCHIVE
ARG ARCHIVE_ROOT
ARG BIN_PATH
ARG ARCHIVE_SHA256
COPY ${ARCHIVE} /tmp/agent.tar.gz
RUN echo "${ARCHIVE_SHA256}  /tmp/agent.tar.gz" | sha256sum -c - \
 && mkdir -p /opt/agent \
 && tar xzf /tmp/agent.tar.gz -C /opt/agent --strip-components=1 "${ARCHIVE_ROOT}" \
 && rm /tmp/agent.tar.gz \
 && ln -s "/opt/agent/${BIN_PATH}" "/usr/local/bin/${AGENT_NAME}" \
 && ln -s "/opt/agent/${BIN_PATH}" /usr/local/bin/agent

LABEL org.opencontainers.image.title="agentbox/${AGENT_NAME}"
LABEL dev.axon.agent="${AGENT_NAME}"
# Which release these bytes are. The profile records no version since Q77 (2026-09-02),
# so the image carries it and `agentbox doctor` reads it back from here.
LABEL dev.axon.agent-version="${AGENT_VERSION}"
LABEL dev.axon.archive-sha256="${ARCHIVE_SHA256}"

USER agent
WORKDIR /workspace

# The container IS the agent: everything appended to `docker run` becomes its
# arguments. The config directory arrives as a mount, never baked in.
ENTRYPOINT ["/usr/local/bin/agent"]
