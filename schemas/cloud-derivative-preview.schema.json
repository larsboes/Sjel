{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/schemas/cloud-derivative-preview.schema.json",
  "title": "Sjel Cloud Derivative Preview",
  "description": "A locally generated, bounded document that must be reviewed before it can be staged and queued for cloud processing.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "id",
    "source_revision",
    "preview_hash",
    "original_data_class",
    "derivative_data_class",
    "transformation",
    "document",
    "redaction_count",
    "redactions",
    "entity_detection",
    "truncated",
    "approval_required",
    "provider_calls",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "cloud-derivative-preview-v1" },
    "source": { "enum": ["feed", "mail"] },
    "id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preview_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "original_data_class": { "enum": ["c0", "c1", "c2", "c3"] },
    "derivative_data_class": { "enum": ["c0", "c1"] },
    "transformation": {
      "description": "bounded-public-v1 for c0; deterministic-entity-redaction-v3 (destructive markers) or reversible-pseudonymize-v1 (typed tokens, PRD §6.2c) for c1.",
      "enum": ["bounded-public-v1", "deterministic-entity-redaction-v3", "reversible-pseudonymize-v1"]
    },
    "document": { "type": "string", "maxLength": 16000 },
    "redaction_count": { "type": "integer", "minimum": 0 },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_type", "marker", "count"],
        "properties": {
          "entity_type": { "type": "string", "minLength": 1 },
          "marker": {
            "description": "A destructive marker such as [person], or a reversible token family such as <TRAVELER_nn>.",
            "type": "string",
            "pattern": "^(\\[.+\\]|<[A-Z]+_nn>)$"
          },
          "count": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "redaction_receipt": {
      "description": "PRD Q9b: the sentence shown on a reduced call; null when nothing was removed.",
      "type": ["string", "null"]
    },
    "entity_detection": { "enum": ["not-required", "local-deterministic-v3", "local-reversible-v1"] },
    "truncated": { "type": "boolean" },
    "approval_required": { "const": true },
    "provider_calls": { "const": 0 },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
