#!/bin/bash
# tools/harnesses — Packs across every agent harness at once.
#
# Launcher only. The whole tool moved to tools/sjel-cli/src/harnesses/ — `list`, `status` and
# `drift` on 2026-10-02, `sync`, `use`, `promote` and `accept` on 2026-10-04. `tools/harnesses.ts`
# is deleted. `tools/harnesses -h` prints the usage.
#
# SJEL_ROOT is set here and tools/lib/paths.sh is NOT sourced, for the reason tools/doctor's
# launcher gives: paths.sh treats an exported SJEL_OVERLAY_ROOT as a per-invocation override
# that skips axon.local.toml's `machine =` line. The Rust side resolves the overlay itself.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

SJEL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
export SJEL_ROOT
# shellcheck source=tools/lib/toml.sh
. "$SJEL_ROOT/tools/lib/toml.sh"       # toml_get_in, for the missing-cargo install hint
# shellcheck source=tools/lib/sjel-cli.sh
. "$SJEL_ROOT/tools/lib/sjel-cli.sh"
sjel_cli_exec harnesses "$@"
