#!/usr/bin/env python3
"""Validate, reload, and verify an existing Home Assistant deployment."""

import argparse
import json
import os
import subprocess
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter
from pathlib import Path

BW_ITEM = os.environ.get("HA_BW_ITEM", "home-assistant/ha")


def die(message: str) -> None:
    raise SystemExit(f"ha-deploy: {message}")


def overlay_root() -> Path:
    raw = (
        os.environ.get("SJEL_HOME_ROOT")
        or os.environ.get("SJEL_OVERLAY_ROOT")
        or os.environ.get("SJEL_PERSONAL_ROOT")
    )
    if not raw:
        die("overlay is unresolved; source tools/lib/paths.sh or set SJEL_OVERLAY_ROOT")
    return Path(raw).expanduser()


def scalar(value: str) -> str:
    value = value.strip()
    if value[:1] in ('"', "'"):
        end = value.find(value[0], 1)
        return value[1:end] if end != -1 else value[1:]
    return value.split(" #", 1)[0].strip()


def config_value(key: str) -> str:
    path = overlay_root() / "config/home-assistant.vars"
    if not path.exists():
        die(f"overlay config is missing: {path}")
    values = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped.startswith("-") or ":" not in stripped:
            continue
        name, _, value = stripped.partition(":")
        values[name.strip()] = scalar(value)
    value = values.get(key, "")
    if not value or value.startswith("TODO-"):
        die(f"overlay config is missing {key}")
    return value


def secret_value(field: str) -> str:
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION is not set; unlock Bitwarden interactively first")
    result = subprocess.run(
        ["bw", "get", "item", BW_ITEM, "--session", session],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        die(f"cannot read configured Bitwarden item: {result.stderr.strip() or 'unknown error'}")
    fields = {entry.get("name"): entry.get("value") for entry in json.loads(result.stdout).get("fields", [])}
    if not fields.get(field):
        die(f"configured Bitwarden item is missing field {field}")
    return fields[field]


class HomeAssistant:
    def __init__(self) -> None:
        raw = config_value("HA_URL").rstrip("/")
        parsed = urllib.parse.urlparse(raw)
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password:
            die("HA_URL must be an http(s) URL with a host and no embedded credentials")
        self.base_url = raw
        self.token = secret_value("HA_TOKEN")

    def call(self, path: str, method: str = "GET", payload=None):
        data = json.dumps(payload).encode() if payload is not None else None
        request = urllib.request.Request(
            f"{self.base_url}/api/{path.lstrip('/')}", data=data, method=method
        )
        request.add_header("Authorization", f"Bearer {self.token}")
        request.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(request, timeout=30) as response:  # nosemgrep
                body = response.read().decode()
                return json.loads(body) if body.strip() else {}
        except urllib.error.HTTPError as error:
            die(f"HTTP {error.code} on {path}: {error.read().decode()[:200]}")
        except urllib.error.URLError as error:
            die(f"cannot reach Home Assistant: {error.reason}")


def check(client: HomeAssistant) -> None:
    result = client.call("config/core/check_config", method="POST")
    if result.get("result") != "valid":
        die(f"configuration is invalid: {result.get('errors')}")
    print("OK config valid")


def reload_all(client: HomeAssistant) -> None:
    client.call("services/homeassistant/reload_all", method="POST", payload={})
    print("OK reload_all completed")


def verify(client: HomeAssistant) -> None:
    config = client.call("config")
    automations = [row for row in client.call("states") if row["entity_id"].startswith("automation.")]
    print(f"state: {config.get('state')}  version: {config.get('version')}")
    print(f"automations: {dict(Counter(row['state'] for row in automations))}")
    if config.get("state") != "RUNNING":
        die("Home Assistant is not RUNNING")
    print("OK verified")


def main() -> int:
    parser = argparse.ArgumentParser(prog="ha-deploy")
    parser.add_argument("command", choices=("check", "reload", "verify"))
    args = parser.parse_args()
    client = HomeAssistant()
    if args.command == "check":
        check(client)
    elif args.command == "reload":
        reload_all(client)
    else:
        verify(client)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
