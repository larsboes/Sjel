#!/usr/bin/env bash
# tools/demo-site — assemble everything that gets published (#168).
#
#   site/
#     index.html      a redirect to docs/self-model.html
#     docs/           tools/generate-docs and tools/generate-site — reference pages, self-model
#     fixtures/       tools/demo-record     — what the seeded capabilities answered
#
# Every step is a tool that also runs on its own; this is the order they go in and the one
# place the base path is decided. It does NOT start capabilities or seed them — tools/demo-up
# does that, because a build step that quietly writes to a database is a build step nobody can
# read. Run demo-up first, or point SJEL_DEMO_FIXTURES at a recording you already have.
#
# The gate at the end is not optional and not a warning. Nothing here uploads, so the last
# thing this script can do for a mistake is refuse to leave the bytes behind.
#
#   tools/demo-site                       build into site/, base path /
#   tools/demo-site --base /Sjel          build for a GitHub Pages project site
#   tools/demo-site --out <dir>
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SJEL_ROOT="$(cd "$_here/.." && pwd)"

OUT="$SJEL_ROOT/site"
# Empty means the site is served from a domain root. A GitHub Pages PROJECT site is served
# from /<repo>, and a static SPA has to be told: its asset URLs and router links are baked in.
BASE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --out)  OUT="$2"; shift 2 ;;
    --base) BASE="${2%/}"; shift 2 ;;
    -h|--help) echo "usage: demo-site [--out <dir>] [--base /prefix]"; exit 0 ;;
    *) echo "demo-site: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

FIXTURES="${SJEL_DEMO_FIXTURES:-$SJEL_ROOT/demo/fixtures}"
if [ ! -f "$FIXTURES/index.json" ]; then
  echo "demo-site: no recording at $FIXTURES/index.json — run tools/demo-up first." >&2
  exit 1
fi

# Before the bundle is built, not after: this is the last moment a manifest/recording mismatch
# is cheap. Past here it is bytes in site/, and past THAT it is a 501 on the published page
# read by a visitor. Both halves — no path may name a route its capability does not serve, and
# every declared path must be in the recording being copied, which is the half that catches a
# fixture set older than the manifest beside it (SJEL_DEMO_FIXTURES makes that reachable).
echo "demo-site: demo.toml against $FIXTURES"
"$_here/demo-check-paths" --fixtures "$FIXTURES"

rm -rf "$OUT"
mkdir -p "$OUT"

cp -R "$FIXTURES" "$OUT/fixtures"
cp "$_here/lib/site-favicon.svg" "$OUT/favicon.svg"
printf '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0; url=docs/self-model.html"><a href="docs/self-model.html">Sjel</a>\n' > "$OUT/index.html"

echo "demo-site: reference pages"
"$_here/generate-docs" --out "$OUT/docs" --fixtures "$FIXTURES"

echo "demo-site: self-model page"
"$_here/generate-site" --out "$OUT/docs" --name self-model.html

# GitHub Pages runs Jekyll unless told not to, and Jekyll drops directories that begin with `_`.
touch "$OUT/.nojekyll"

echo "demo-site: hygiene gate"
"$_here/check-site-payload.sh" "$OUT"

echo "demo-site: $(du -sh "$OUT" | cut -f1) in $OUT"
