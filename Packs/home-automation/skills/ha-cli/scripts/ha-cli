#!/usr/bin/env python3
"""ha-cli — Home Assistant REST API CLI (pure Python 3 stdlib, no deps).

Queries and controls a Home Assistant instance over its REST API. Split source of truth:
the non-secret connection fact (HA_URL) comes from the committed overlay config
(<overlay>/config/home-assistant.vars). The secret (HA_TOKEN, a long-lived access token)
comes from Bitwarden at runtime — never hardcoded, never printed.

`entries` used to read config entries over SSH from a `.storage` path, on the belief that
the REST API did not expose them. It does: `/api/config/config_entries/entry` answers 200
with the full list to an admin token, verified 2026-08-06. The SSH hop and HA_CFG_PATH are
gone with it, which is what had quietly broken the command — that path went empty in the
overlay on 2026-07-28 and nothing noticed.

The registries are the genuine exception. `/api/config/{device,entity,area}_registry/list`
all answer 404; those live on the WebSocket API, so `--remove` opens one to say what a
deletion takes with it. That client is shared with ha-dashboard from the Pack's lib/.

Requires an unlocked Bitwarden session in $BW_SESSION (the user unlocks interactively;
this tool never sees the master password). See SKILL.md.

Commands:
  config                       HA version, run state, location, component count
  domains                      entity-count breakdown per domain
  states [DOMAIN]              list states; optional domain prefix filter (e.g. automation)
  get ENTITY_ID                full state + attributes for one entity
  automations                  automation states grouped (on / off / unavailable)
  unavailable                  every entity whose state is unavailable/unknown
  entries [--add H|--remove ID] config entries: list, add via config flow, or remove
  call DOMAIN SERVICE [JSON]   call a service, e.g. call switch turn_on '{"entity_id":"switch.x"}'
  reload-automations           POST automation/reload (apply YAML changes without HA restart)
"""
import argparse
import json
import os
import socket
import ssl
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BW_ITEM = os.environ.get("HA_BW_ITEM", "home-assistant/ha")
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg: str) -> None:
    print(f"ha-cli: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _http_base_url(raw: str, label: str) -> str:
    value = raw.strip().rstrip("/")
    parsed = urllib.parse.urlparse(value)
    if (parsed.scheme not in ("http", "https") or not parsed.hostname
            or parsed.username is not None or parsed.password is not None):
        die(f"{label} must be an http(s) URL with a host and no embedded credentials")
    return value


def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def bw_secret(field: str) -> str:
    """Fetch a single secret field from the Bitwarden item. Never prints the value."""
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool).")
    r = subprocess.run(["bw", "get", "item", BW_ITEM, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {BW_ITEM}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION passes the presence check above and `bw` still exits 0, printing a
    # plain-text complaint instead of JSON — so the parse, not the return code, is where a
    # locked vault actually surfaces. Say so, instead of raising JSONDecodeError at the caller.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {BW_ITEM}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in item.get("fields", [])}
    if not fields.get(field):
        die(f"bw item '{BW_ITEM}' is missing secret field: {field}")
    return fields[field]


class HA:
    def __init__(self, url: str, token: str):
        self.url = _http_base_url(url, "HA_URL")
        self.token = token

    def api(self, path: str, method: str = "GET", payload=None):
        url = f"{self.url}/api/{path.lstrip('/')}"
        data = json.dumps(payload).encode() if payload is not None else None
        req = urllib.request.Request(url, data=data, method=method)
        req.add_header("Authorization", f"Bearer {self.token}")
        req.add_header("Content-Type", "application/json")
        try:
            # HA_URL is operator-owned and constrained before request construction.
            with urllib.request.urlopen(req, timeout=15) as resp:  # nosemgrep: python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected
                body = resp.read().decode()
                return json.loads(body) if body.strip() else {}
        except urllib.error.HTTPError as e:
            die(f"HTTP {e.code} on {path}: {e.read().decode()[:200]}")
        except urllib.error.URLError as e:
            die(f"cannot reach {self.url}: {e.reason} (is HA_URL right and the host reachable?)")


def ha_client() -> HA:
    """Compose the client: non-secret URL from the committed overlay config, token from Bitwarden."""
    (url,) = cfg("HA_URL")
    return HA(url, bw_secret("HA_TOKEN"))


# --- Shared WebSocket transport ------------------------------------------------
#
# Only the registries need this; everything else here is REST. `realpath`, not
# `abspath`: skills are installed by symlinking this directory into
# ~/.claude/skills, so the script's own path runs through that symlink and only
# realpath resolves back into the Pack. See ../../../lib/ha_ws.py.
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "lib"))
from ha_ws import HAWebSocket, WSError  # noqa: E402


def ws_client() -> HAWebSocket:
    (url,) = cfg("HA_URL")
    ws = HAWebSocket(url, bw_secret("HA_TOKEN"))
    try:
        ws.connect_and_auth()
    except WSError as e:
        die(str(e))
    except (socket.gaierror, socket.timeout, ConnectionError, ssl.SSLError, OSError) as e:
        die(f"cannot reach HA over WebSocket: {e} (is HA_URL right and the host reachable?)")
    return ws


def require_result(msg: dict, what: str) -> dict:
    if not msg.get("success"):
        die(f"{what} failed: {json.dumps(msg.get('error', msg), ensure_ascii=False)}")
    return msg.get("result")


def cmd_config(args) -> int:
    d = ha_client().api("config")
    if args.json:
        print(json.dumps(d, indent=2, ensure_ascii=False))
        return 0
    print(f"version:    {d.get('version')}")
    print(f"state:      {d.get('state')}")
    print(f"location:   {d.get('location_name')}")
    print(f"components: {len(d.get('components', []))}")
    return 0


def cmd_domains(args) -> int:
    from collections import Counter
    c = Counter(s["entity_id"].split(".")[0] for s in ha_client().api("states"))
    if args.json:
        print(json.dumps(dict(c), ensure_ascii=False, indent=2))
        return 0
    for dom, n in sorted(c.items(), key=lambda x: -x[1]):
        print(f"  {n:4} {dom}")
    print(f"  ---- {sum(c.values())} total")
    return 0


def cmd_states(args) -> int:
    pref = (args.domain + ".") if args.domain else ""
    rows = [s for s in ha_client().api("states") if s["entity_id"].startswith(pref)]
    rows.sort(key=lambda x: x["entity_id"])
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    for s in rows:
        print(f"  {s['state'][:18]:18} {s['entity_id']}")
    print(f"  ---- {len(rows)} entities")
    return 0


def cmd_get(args) -> int:
    s = ha_client().api(f"states/{args.entity_id}")
    print(json.dumps(s, indent=2, ensure_ascii=False))
    return 0


def cmd_automations(args) -> int:
    from collections import defaultdict
    g = defaultdict(list)
    for s in ha_client().api("states"):
        if s["entity_id"].startswith("automation."):
            g[s["state"]].append(s["entity_id"])
    if args.json:
        print(json.dumps({k: sorted(v) for k, v in g.items()}, ensure_ascii=False, indent=2))
        return 0
    for state in ("on", "off", "unavailable", "unknown"):
        if g[state]:
            print(f"== {state} ({len(g[state])}) ==")
            for e in sorted(g[state]):
                print(f"   {e}")
    return 0


def cmd_unavailable(args) -> int:
    rows = sorted(s["entity_id"] for s in ha_client().api("states")
                  if s["state"] in ("unavailable", "unknown"))
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    for e in rows:
        print(f"   {e}")
    print(f"  ---- {len(rows)} unavailable/unknown")
    return 0


def _registry_owned_by(entry_id: str):
    """Devices and entities that belong to one config entry.

    WebSocket, because the registries are the one part of this command REST
    cannot answer: `/api/config/{device,entity,area}_registry/list` all return
    404, while config entries themselves are plain REST. Verified against a live
    instance on 2026-08-06.
    """
    ws = ws_client()
    try:
        devices = require_result(
            ws.command({"type": "config/device_registry/list"}), "device_registry/list")
        entities = require_result(
            ws.command({"type": "config/entity_registry/list"}), "entity_registry/list")
    finally:
        ws.close()
    mine_dev = [d for d in devices if entry_id in (d.get("config_entries") or [])]
    mine_ent = [e for e in entities if e.get("config_entry_id") == entry_id]
    return mine_dev, mine_ent


def cmd_entries(args) -> int:
    ha = ha_client()
    if args.list_handlers:
        for h in sorted(ha.api("config/config_entries/flow_handlers")):
            print(f"  {h}")
        return 0
    if args.add:
        return _entries_add(ha, args)
    if args.remove:
        return _entries_remove(ha, args)

    rows = ha.api("config/config_entries/entry")
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return 0
    for x in sorted(rows, key=lambda x: (x["domain"], x.get("title") or "")):
        state = x.get("state") or ""
        # `loaded` is the boring case and printing it on 40 lines buries the
        # two that are not loaded, which are the only ones worth looking at.
        flag = "" if state == "loaded" else f"  [{state}]"
        print(f"  {x['domain']:<24} {(x.get('title') or '')[:40]:<42} {x['entry_id']}{flag}")
    print(f"  ---- {len(rows)} config entr{'y' if len(rows) == 1 else 'ies'}")
    return 0


def _entries_add(ha: "HA", args) -> int:
    """Walk a config flow far enough to finish the single-step confirm case.

    Deliberately not a general form-filler. A flow that wants real input wants
    field names, types and validation this cannot know, and guessing at them
    produces a half-created integration that has to be cleaned up by hand. It
    refuses and says which step it stopped on instead.
    """
    handlers = ha.api("config/config_entries/flow_handlers")
    if args.add not in handlers:
        near = [h for h in handlers if args.add in h][:8]
        die(f"unknown handler '{args.add}'"
            + (f"; did you mean: {', '.join(near)}" if near else
               f" ({len(handlers)} available, try --list-handlers)"))

    step = ha.api("config/config_entries/flow", "POST",
                  {"handler": args.add, "show_advanced_options": False})
    for _ in range(8):  # a bounded walk; no legitimate confirm flow is this deep
        kind = step.get("type")
        if kind == "create_entry":
            title = step.get("title") or step.get("result", {}).get("title") or args.add
            print(f"created: {title}")
            return 0
        if kind == "abort":
            reason = step.get("reason", "unknown")
            # already_configured is the ordinary re-run case, not a failure.
            print(f"aborted: {reason}")
            return 0 if reason == "already_configured" else 1
        if kind == "form":
            schema = step.get("data_schema") or []
            required = [f.get("name") for f in schema if f.get("required")]
            if required:
                die(f"step '{step.get('step_id')}' needs input this cannot supply: "
                    f"{', '.join(str(r) for r in required)}. Finish it in the UI.")
            # An empty-schema form is the confirm step: submit nothing.
            step = ha.api(f"config/config_entries/flow/{step['flow_id']}", "POST", {})
            continue
        die(f"unexpected flow step type: {kind}")
    die("flow did not finish within 8 steps; finish it in the UI")


def _entries_remove(ha: "HA", args) -> int:
    """Delete a config entry, after saying what goes with it.

    HA removes the entry's devices and entities along with it. That is the whole
    reason this asks first: the count is usually larger than expected, and the
    delete is not undoable from here.
    """
    rows = ha.api("config/config_entries/entry")
    entry = next((x for x in rows if x["entry_id"] == args.remove), None)
    if entry is None:
        die(f"no config entry with id '{args.remove}' (try `ha-cli entries` for the list)")

    devices, entities = _registry_owned_by(args.remove)
    print(f"  entry:    {entry['domain']}  {entry.get('title') or ''}")
    print(f"  state:    {entry.get('state')}")
    print(f"  removes:  {len(devices)} device(s), {len(entities)} entit{'y' if len(entities) == 1 else 'ies'}")
    for e in entities[:10]:
        print(f"              {e.get('entity_id')}")
    if len(entities) > 10:
        print(f"              ... and {len(entities) - 10} more")

    if not args.yes:
        # Interactive by default. A destructive call that needs no confirmation
        # is one somebody eventually makes by pressing up-arrow.
        if not sys.stdin.isatty():
            die("refusing to delete without a terminal to confirm at; pass --yes if you mean it")
        if input("  delete this entry? [y/N] ").strip().lower() not in ("y", "yes"):
            print("  left alone")
            return 0

    ha.api(f"config/config_entries/entry/{args.remove}", "DELETE")
    print(f"  deleted {args.remove}")
    return 0


def cmd_call(args) -> int:
    try:
        payload = json.loads(args.json_payload) if args.json_payload else {}
    except json.JSONDecodeError as e:
        die(f"invalid JSON payload: {e}")
    res = ha_client().api(f"services/{args.domain}/{args.service}", method="POST", payload=payload)
    print(f"OK {args.domain}.{args.service} called")
    if res:
        print(json.dumps(res, indent=2, ensure_ascii=False)[:800])
    return 0


def cmd_reload_automations(args) -> int:
    ha_client().api("services/automation/reload", method="POST", payload={})
    print("OK automations reloaded")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="ha-cli", description="Query and control Home Assistant over its REST API.")
    sub = p.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("config", help="HA version, run state, component count")
    c.add_argument("--json", "-j", action="store_true")
    c.set_defaults(fn=cmd_config)

    d = sub.add_parser("domains", help="entity-count breakdown per domain")
    d.add_argument("--json", "-j", action="store_true")
    d.set_defaults(fn=cmd_domains)

    s = sub.add_parser("states", help="list states; optional domain prefix filter")
    s.add_argument("domain", nargs="?", help="domain prefix, e.g. automation")
    s.add_argument("--json", "-j", action="store_true")
    s.set_defaults(fn=cmd_states)

    g = sub.add_parser("get", help="full state + attributes for one entity")
    g.add_argument("entity_id")
    g.set_defaults(fn=cmd_get)

    a = sub.add_parser("automations", help="automation states grouped (on/off/unavailable)")
    a.add_argument("--json", "-j", action="store_true")
    a.set_defaults(fn=cmd_automations)

    u = sub.add_parser("unavailable", help="every entity whose state is unavailable/unknown")
    u.add_argument("--json", "-j", action="store_true")
    u.set_defaults(fn=cmd_unavailable)

    e = sub.add_parser("entries", help="config entries: list, add via config flow, or remove")
    e.add_argument("--add", metavar="HANDLER",
                   help="start a config flow for HANDLER (single-step confirm flows only)")
    e.add_argument("--remove", metavar="ENTRY_ID",
                   help="delete a config entry, with its devices and entities")
    e.add_argument("--yes", "-y", action="store_true",
                   help="skip the confirmation prompt on --remove")
    e.add_argument("--list-handlers", action="store_true",
                   help="print every config-flow handler this instance offers")
    e.add_argument("--json", "-j", action="store_true")
    e.set_defaults(fn=cmd_entries)

    cl = sub.add_parser("call", help="call a service, e.g. call switch turn_on '{\"entity_id\":\"switch.x\"}'")
    cl.add_argument("domain")
    cl.add_argument("service")
    cl.add_argument("json_payload", nargs="?", help="JSON service data")
    cl.set_defaults(fn=cmd_call)

    r = sub.add_parser("reload-automations", help="apply YAML automation changes without an HA restart")
    r.set_defaults(fn=cmd_reload_automations)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
