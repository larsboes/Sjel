[Unit]
Description=Sjel schedule for __CAPABILITY__

[Timer]
Unit=axon-__CAPABILITY__.service
# Pairs with the launchd plist's RunAtLoad: the first run comes shortly after boot rather than a
# whole interval later. 1min, not 0, so a cold boot isn't racing the network and every other
# capability coming up at once.
OnBootSec=1min
# ...ActiveSec, not ...UnitInactiveSec: the oneshot service stays "activating" for the whole run,
# so the interval measures from when the last run finished.
OnUnitActiveSec=__INTERVAL_SECONDS__s
# A laptop that was asleep through a tick runs it on wake instead of silently skipping it. The
# launchd side gets the same from StartCalendarInterval (StartInterval would skip it; see
# tools/sjel-cli/src/persist.rs launchd_trigger), so Persistent keeps the two backends alike.
Persistent=true

[Install]
WantedBy=timers.target
