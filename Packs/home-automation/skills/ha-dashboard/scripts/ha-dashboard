#!/usr/bin/env python3
"""ha-dashboard — deploy & back up Home Assistant Lovelace dashboards (pure Python 3 stdlib, no deps).

Lovelace dashboard config lives behind Home Assistant's WebSocket API, not its REST
API, so this tool speaks WebSocket over a minimal stdlib client (socket + ssl +
base64 + hashlib) — no `websockets` package, no pip install.

Split source of truth: the non-secret HA_URL (the WebSocket URL is derived from it)
comes from the committed overlay config (<overlay>/config/home-assistant.vars). The
secret HA_TOKEN (a long-lived access token) comes from Bitwarden at runtime — never
hardcoded, never printed. Requires an unlocked Bitwarden session in $BW_SESSION (the
user unlocks interactively; this tool never sees the master password). See SKILL.md.

Commands:
  list                          existing dashboards (url_path / title / mode)
  backup [--url-path SLUG]      dump a dashboard's config to a file (-o, default timestamped .json)
  deploy FILE [--url-path SLUG] push a config file (.json, or .yaml/.yml if PyYAML is present) to a dashboard
  create SLUG --title T         create a new storage-mode dashboard (sidebar entry)

Omit --url-path to target the default (Overview) dashboard; pass a slug for a named one.
"""
import argparse
import json
import os
import socket
import ssl
import subprocess
import sys
from datetime import datetime
from pathlib import Path

BW_ITEM = os.environ.get("HA_BW_ITEM", "home-assistant/ha")
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg: str) -> None:
    print(f"ha-dashboard: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --- Split credential fetch: non-secret from overlay config, secret from Bitwarden ---

def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def bw_secret(field: str) -> str:
    """Fetch a single secret field from the Bitwarden item. Never prints the value."""
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool).")
    r = subprocess.run(["bw", "get", "item", BW_ITEM, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {BW_ITEM}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION passes the presence check above and `bw` still exits 0, printing a
    # plain-text complaint instead of JSON — so the parse, not the return code, is where a
    # locked vault actually surfaces. Say so, instead of raising JSONDecodeError at the caller.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {BW_ITEM}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in item.get("fields", [])}
    if not fields.get(field):
        die(f"bw item '{BW_ITEM}' is missing secret field: {field}")
    return fields[field]


# --- Shared WebSocket transport ------------------------------------------------
#
# Lives in the Pack's lib/ so ha-cli can use the same client rather than carry a
# second hand-rolled RFC 6455 implementation. `realpath`, not `abspath`: skills
# are installed by symlinking this directory into ~/.claude/skills, so the
# script's own path runs through that symlink and only realpath resolves back
# into the Pack. See ../../../lib/ha_ws.py.
sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.realpath(__file__)), "..", "..", "..", "lib"))
from ha_ws import HAWebSocket, WSError  # noqa: E402


def ws_client() -> HAWebSocket:
    (url,) = cfg("HA_URL")            # non-secret; the WS URL is derived from it
    token = bw_secret("HA_TOKEN")    # secret; from Bitwarden
    ws = HAWebSocket(url, token)
    try:
        ws.connect_and_auth()
    except WSError as e:
        die(str(e))
    except (socket.gaierror, socket.timeout, ConnectionError, ssl.SSLError, OSError) as e:
        die(f"cannot reach HA over WebSocket: {e} (is HA_URL right and the host reachable?)")
    return ws


def require_result(msg: dict, what: str) -> dict:
    if not msg.get("success"):
        err = msg.get("error", msg)
        die(f"{what} failed: {json.dumps(err, ensure_ascii=False)}")
    return msg.get("result")


# --- Config file I/O (JSON native; YAML only if PyYAML is importable) ---------

def _yaml():
    try:
        import yaml
        return yaml
    except ImportError:
        return None


def load_config(path: str):
    try:
        text = open(path, encoding="utf-8").read()
    except OSError as e:
        die(f"cannot read {path}: {e}")
    if path.endswith((".yaml", ".yml")):
        y = _yaml()
        if y is None:
            die(f"{path} is YAML but PyYAML isn't installed — convert it to JSON, "
                "or `pip install pyyaml` (this tool needs no deps for JSON).")
        return y.safe_load(text)
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        die(f"{path} is not valid JSON: {e}")


def write_config(config, path: str) -> None:
    if path.endswith((".yaml", ".yml")):
        y = _yaml()
        if y is None:
            die("YAML output needs PyYAML — pass a .json output path instead (`-o file.json`).")
        with open(path, "w", encoding="utf-8") as f:
            y.dump(config, f, allow_unicode=True, default_flow_style=False, sort_keys=False)
    else:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(config, f, ensure_ascii=False, indent=2)


# --- Commands -----------------------------------------------------------------

def cmd_list(args) -> int:
    ws = ws_client()
    try:
        rows = require_result(ws.command({"type": "lovelace/dashboards/list"}), "list") or []
    finally:
        ws.close()
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    print("  (default)            Overview / default dashboard (no url_path)")
    for d in sorted(rows, key=lambda x: x.get("url_path") or ""):
        print(f"  {d.get('url_path',''):20} {d.get('title','')}  [{d.get('mode','?')}]")
    print(f"  ---- {len(rows)} named dashboard(s) + default")
    return 0


def cmd_backup(args) -> int:
    ws = ws_client()
    try:
        # HA's get command is `lovelace/config`. It was `lovelace/config/get` here, which HA
        # answers with unknown_command — so backup failed while deploy (`lovelace/config/save`,
        # a real command) succeeded. Following SKILL.md's "back up first" then overwrote a
        # dashboard with no copy taken.
        payload = {"type": "lovelace/config"}
        if args.url_path:
            payload["url_path"] = args.url_path
        config = require_result(ws.command(payload), "config")
    finally:
        ws.close()
    if not config:
        die(f"{args.url_path or '(default)'} returned no config — refusing to write an empty "
            f"backup. An auto-generated (strategy) dashboard has no stored config to back up.")
    out = args.output
    if not out:
        tag = args.url_path or "default"
        out = f"{tag}_dashboard_{datetime.now():%Y%m%d_%H%M%S}.json"
    write_config(config, out)
    print(f"Saved {args.url_path or '(default)'} -> {out}")
    return 0


def cmd_deploy(args) -> int:
    config = load_config(args.file)
    ws = ws_client()
    try:
        payload = {"type": "lovelace/config/save", "config": config}
        if args.url_path:
            payload["url_path"] = args.url_path
        msg = ws.command(payload)
    finally:
        ws.close()
    if not msg.get("success"):
        err = msg.get("error", msg)
        hint = ""
        if args.url_path:
            hint = (f"\n  If '{args.url_path}' doesn't exist yet, create it first: "
                    f"`ha-dashboard create {args.url_path} --title <Title>`.")
        die(f"deploy failed: {json.dumps(err, ensure_ascii=False)}{hint}")
    print(f"Deployed {args.file} -> {args.url_path or '(default)'}")
    return 0


def cmd_create(args) -> int:
    ws = ws_client()
    try:
        payload = {
            "type": "lovelace/dashboards/create",
            "mode": "storage",
            "url_path": args.slug,
            "title": args.title,
            "require_admin": False,
            "show_in_sidebar": not args.no_sidebar,
        }
        if args.icon:
            payload["icon"] = args.icon
        require_result(ws.command(payload), "dashboards/create")
    finally:
        ws.close()
    print(f"Created dashboard '{args.slug}' (title: {args.title})")
    return 0


def cmd_resources(args) -> int:
    """List or register Lovelace resources — the JS/CSS a dashboard loads before its cards.

    A vendored frontend file under www/ is inert until it is registered here, so this is the
    other half of a pinned `kind = "lovelace"` entry, not a convenience."""
    ws = ws_client()
    try:
        items = require_result(ws.command({"type": "lovelace/resources"}), "resources") or []
        if not args.url:
            if args.json:
                print(json.dumps(items, ensure_ascii=False, indent=2))
            else:
                for r in items:
                    print(f"  {r.get('type','?'):<8} {r.get('url','')}")
                print(f"  ---- {len(items)} resource(s)")
            return 0
        # Registering the same URL twice gives HA two entries for one file and the dashboard
        # loads it twice. Say it is already there instead.
        if any(r.get("url") == args.url for r in items):
            print(f"Already registered: {args.url}")
            return 0
        require_result(
            ws.command({"type": "lovelace/resources/create", "res_type": args.type, "url": args.url}),
            "resources/create",
        )
    finally:
        ws.close()
    print(f"Registered {args.type}: {args.url}")
    return 0


def _restored(ws) -> dict:
    """entity_id -> friendly name, for every entity the registry still lists but no integration
    provides. HA marks exactly these with attributes.restored, which is the only reliable way to
    tell a dead registry row from an entity that is merely offline right now."""
    states = require_result(ws.command({"type": "get_states"}), "get_states") or []
    return {
        s["entity_id"]: (s.get("attributes", {}).get("friendly_name") or s["entity_id"])
        for s in states
        if s.get("attributes", {}).get("restored") is True
    }


def cmd_entities(args) -> int:
    ws = ws_client()
    try:
        ghosts = _restored(ws)
        if not args.remove:
            if args.json:
                print(json.dumps(ghosts, ensure_ascii=False, indent=2))
                return 0
            by_domain: dict[str, list[tuple[str, str]]] = {}
            for eid, name in sorted(ghosts.items()):
                by_domain.setdefault(eid.split(".")[0], []).append((eid, name))
            for domain, rows in sorted(by_domain.items()):
                print(f"  {domain} ({len(rows)})")
                for eid, name in rows:
                    print(f"    {eid:<52} {name}")
            print(f"  ---- {len(ghosts)} restored entit{'y' if len(ghosts) == 1 else 'ies'}")
            return 0
        # An entity that is merely offline looks identical in the UI and deleting it throws away
        # a live registry row — its history, its area, its custom name. Refuse rather than warn.
        live = [e for e in args.remove if e not in ghosts]
        if live:
            die("refusing to remove entities that are not restored (an integration still "
                f"provides them): {', '.join(live)}")
        for eid in args.remove:
            require_result(
                ws.command({"type": "config/entity_registry/remove", "entity_id": eid}),
                f"entity_registry/remove {eid}",
            )
            print(f"Removed {eid}  ({ghosts[eid]})")
    finally:
        ws.close()
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="ha-dashboard",
        description="Deploy and back up Home Assistant Lovelace dashboards over the WebSocket API.")
    sub = p.add_subparsers(dest="cmd", required=True)

    ls = sub.add_parser("list", help="existing dashboards (url_path / title / mode)")
    ls.add_argument("--json", "-j", action="store_true")
    ls.set_defaults(fn=cmd_list)

    bk = sub.add_parser("backup", help="dump a dashboard's config to a file")
    bk.add_argument("--url-path", help="dashboard slug; omit for the default dashboard")
    bk.add_argument("--output", "-o", help="output path (default: <slug>_dashboard_<ts>.json)")
    bk.set_defaults(fn=cmd_backup)

    dp = sub.add_parser("deploy", help="push a config file to a dashboard")
    dp.add_argument("file", help="config file (.json, or .yaml/.yml if PyYAML is present)")
    dp.add_argument("--url-path", help="dashboard slug; omit for the default dashboard")
    dp.set_defaults(fn=cmd_deploy)

    cr = sub.add_parser("create", help="create a new storage-mode dashboard")
    cr.add_argument("slug", help="url_path slug for the new dashboard")
    cr.add_argument("--title", required=True, help="sidebar title")
    cr.add_argument("--icon", help="mdi icon, e.g. mdi:home")
    cr.add_argument("--no-sidebar", action="store_true", help="don't show in the sidebar")
    cr.set_defaults(fn=cmd_create)

    rs = sub.add_parser("resources", help="list dashboard resources, or register one (no URL = list)")
    rs.add_argument("url", nargs="?", help="resource URL, e.g. /local/scheduler-card.js")
    rs.add_argument("--type", default="module", choices=("module", "css"), help="resource type (default: module)")
    rs.add_argument("--json", "-j", action="store_true")
    rs.set_defaults(fn=cmd_resources)

    en = sub.add_parser("entities", help="list registry ghosts (restored entities), or remove them")
    en.add_argument("--remove", nargs="+", metavar="ENTITY_ID",
                    help="delete these registry entries; refuses anything not restored")
    en.add_argument("--json", "-j", action="store_true")
    en.set_defaults(fn=cmd_entities)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
