#!/usr/bin/env bun
/**
 * ha-dashgen — generate Home Assistant dashboards from an overlay-owned house model.
 *
 * Public mechanism, private inventory, same split as homectl: this Pack owns every card,
 * layout and deploy decision and knows no entity ID; the active overlay owns the model.
 *
 *   ha-dashgen build            model -> JSON, written into the overlay
 *   ha-dashgen check            every entity reference must exist on the live instance
 *   ha-dashgen ensure           create any dashboard that does not exist yet
 *   ha-dashgen deploy [--yes]   back up, then push. Never pushes without a backup.
 *   ha-dashgen diff             what deploy would change, against the live config
 *
 * Paths resolve from $SJEL_HOME_ROOT / $SJEL_OVERLAY_ROOT, as everything else here does.
 */

import { existsSync, mkdirSync, readdirSync, writeFileSync } from "node:fs";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";
import { familyViews, technicalViews } from "../lib/compose.ts";
import { dashboard } from "../lib/views.ts";

const HERE = dirname(fileURLToPath(import.meta.url));
const PACK_HA_CLI = join(HERE, "..", "..", "ha-cli", "scripts", "ha-cli");
const PACK_HA_DASH = join(HERE, "..", "..", "ha-dashboard", "scripts", "ha-dashboard");

const die = (msg: string): never => {
  console.error(`ha-dashgen: ${msg}`);
  process.exit(1);
};

const overlayRoot = (): string => {
  const raw =
    process.env.SJEL_HOME_ROOT || process.env.SJEL_OVERLAY_ROOT || process.env.SJEL_PERSONAL_ROOT;
  if (!raw) die("overlay is unresolved; set SJEL_HOME_ROOT");
  return raw!.replace(/^~/, process.env.HOME ?? "~");
};

/** slug -> what the dashboard is and where its JSON lands. */
// Home Assistant rejects a url_path without a hyphen, which is why the dashboard this
// replaces is called "raum-ansicht". The title is what the sidebar shows; the slug is URL only.
const TARGETS = [
  { slug: "mein-zuhause", title: "Zuhause", icon: "mdi:home-heart", admin: false, wall: false },
  // wall:false on purpose. The four-column layout this flag switches on renders the whole
  // dashboard blank on 2026.6.3, isolated by the fact that mein-zuhause and wand-tablet are
  // byte-identical apart from it. The tablet therefore ships the same verified two-column
  // layout as the phones; what still distinguishes it is the Glas theme and the ?kiosk URL.
  // Wide layout is a follow-up, not a blocker for a wall tablet that has to work tonight.
  { slug: "wand-tablet", title: "Wand", icon: "mdi:tablet-dashboard", admin: false, wall: false },
  { slug: "technik-netzwerk", title: "Netzwerk", icon: "mdi:lan", admin: true, wall: false },
] as const;

const outDir = () => join(overlayRoot(), "config/home-assistant/dashboards");

async function loadModel(): Promise<Record<string, unknown>> {
  const path = join(overlayRoot(), "capabilities/home-assistant/dashboards/model.ts");
  if (!existsSync(path)) die(`no model at ${path}`);
  const mod = await import(path);
  if (!mod.house) die("model.ts must export `house`");
  return mod.house;
}

/** Every entity ID mentioned anywhere in a generated dashboard, including inside templates. */
function entityRefs(obj: unknown): Set<string> {
  const found = new Set<string>();
  const DOMAINS =
    /\b(sensor|binary_sensor|light|switch|scene|automation|script|input_boolean|input_number|input_select|input_text|timer|vacuum|lawn_mower|valve|camera|event|weather|person|number|select|update|button|climate|cover|media_player|siren|todo|calendar|image|device_tracker)\.[a-z0-9_]+\b/g;
  // `perform_action: "light.turn_off"` and `service: "scene.turn_on"` are domain.name shaped
  // and are NOT entities. Skipping the key rather than blacklisting verbs: a service list goes
  // stale, the key does not.
  const NOT_AN_ENTITY = new Set(["perform_action", "service", "action"]);
  const walk = (v: unknown, key?: string): void => {
    if (typeof v === "string") {
      if (key && NOT_AN_ENTITY.has(key)) return;
      for (const m of v.matchAll(DOMAINS)) found.add(m[0]);
    } else if (Array.isArray(v)) v.forEach((x) => walk(x, key));
    else if (v && typeof v === "object") {
      for (const [k, val] of Object.entries(v)) walk(val, k);
    }
  };
  walk(obj);
  return found;
}

/**
 * Count real cards, meaning things that occupy space on the page.
 *
 * Only objects sitting in a `cards:` array count. Walking every object with a `type` key
 * instead — which is the obvious implementation and the one this had first — counts tile
 * features, chips, badges and tap actions as cards and reports roughly double. The number
 * exists to be compared against the pre-rebuild baseline, so it has to mean the same thing
 * on both sides.
 */
function countCards(dash: Record<string, unknown>): { cards: number; markdown: number } {
  let cards = 0;
  let markdown = 0;
  const walkCardList = (list: unknown): void => {
    if (!Array.isArray(list)) return;
    for (const c of list) {
      if (!c || typeof c !== "object") continue;
      const card = c as Record<string, unknown>;
      cards++;
      if (card.type === "markdown") markdown++;
      walkCardList(card.cards); // vertical-stack, grid, horizontal-stack
      if (card.card) walkCardList([card.card]); // conditional
    }
  };
  for (const v of (dash.views ?? []) as Record<string, unknown>[]) {
    walkCardList(v.cards); // masonry views
    for (const s of (v.sections ?? []) as Record<string, unknown>[]) walkCardList(s.cards);
    const header = v.header as Record<string, unknown> | undefined;
    if (header?.card) walkCardList([header.card]);
  }
  return { cards, markdown };
}

async function build(): Promise<Record<string, Record<string, unknown>>> {
  const house = await loadModel();
  const out: Record<string, Record<string, unknown>> = {};
  for (const t of TARGETS) {
    const views = t.admin
      ? technicalViews(house as never)
      : familyViews(house as never, t.wall, t.slug);
    out[t.slug] = dashboard(t.title, views, { kiosk: t.wall });
  }
  const dir = outDir();
  mkdirSync(dir, { recursive: true });
  for (const [slug, cfg] of Object.entries(out)) {
    const file = join(dir, `${slug}.json`);
    writeFileSync(file, JSON.stringify(cfg, null, 1) + "\n");
    const { cards, markdown } = countCards(cfg);
    const views = (cfg.views as unknown[]).length;
    console.log(`  ${slug.padEnd(10)} ${views} views  ${String(cards).padStart(3)} cards  ${markdown} markdown  -> ${file}`);
  }
  // The baseline is the whole point of the rebuild: same measure, both sides, out loud.
  const baseDir = join(dir, "baseline-2026-08-11");
  if (existsSync(baseDir)) {
    let bc = 0;
    let bm = 0;
    let bv = 0;
    for (const f of readdirSync(baseDir).filter((f) => f.endsWith(".json"))) {
      const cfg = JSON.parse(await Bun.file(join(baseDir, f)).text());
      if (!cfg.views) continue;
      const c = countCards(cfg);
      bc += c.cards;
      bm += c.markdown;
      bv += cfg.views.length;
    }
    const now = Object.values(out).reduce(
      (a, c) => {
        const k = countCards(c);
        return { cards: a.cards + k.cards, markdown: a.markdown + k.markdown, views: a.views + (c.views as unknown[]).length };
      },
      { cards: 0, markdown: 0, views: 0 },
    );
    console.log(
      `\n  baseline ${bv} views ${bc} cards ${bm} markdown  ->  now ${now.views} views ${now.cards} cards ${now.markdown} markdown`,
    );
  }
  return out;
}

function liveStates(): Set<string> {
  const p = Bun.spawnSync([PACK_HA_CLI, "states", "-j"], { stdout: "pipe", stderr: "pipe" });
  if (p.exitCode !== 0) die(`ha-cli states failed: ${p.stderr.toString().slice(0, 200)}`);
  const rows = JSON.parse(p.stdout.toString()) as { entity_id: string }[];
  return new Set(rows.map((r) => r.entity_id));
}

async function check(): Promise<number> {
  const built = await build();
  const live = liveStates();
  let bad = 0;
  for (const [slug, cfg] of Object.entries(built)) {
    const refs = [...entityRefs(cfg)].sort();
    const missing = refs.filter((r) => !live.has(r));
    console.log(`  ${slug.padEnd(10)} ${refs.length} entities referenced, ${missing.length} missing`);
    for (const m of missing) {
      console.log(`      MISSING  ${m}`);
      bad++;
    }
  }
  // Duplication was the actual defect in the dashboard this replaces: the EV charge plan on
  // three views, the automation control plane on two, "Geräte im Netzwerk" twice on ONE view.
  // An entity that a family member can reach from two places has two states in their head.
  // Controls only — a sensor legitimately appears as a badge and again in a detail view.
  //
  // "start" is excluded on purpose. It is a shortcut surface, so a favourite tile there is
  // MEANT to point at a light that also lives in Räume — that is what a favourite is. The
  // defect was a full panel repeated among peer views, which is what this measures.
  const CONTROL = /^(light|switch|scene|valve|vacuum|lawn_mower|automation|input_boolean|climate|cover|media_player)\./;
  for (const [slug, cfg] of Object.entries(built)) {
    const seen = new Map<string, string[]>();
    for (const v of ((cfg.views as Record<string, unknown>[]) ?? []).filter((v) => v.path !== "start")) {
      for (const e of entityRefs(v.sections ?? v.cards)) {
        if (!CONTROL.test(e)) continue;
        seen.set(e, [...(seen.get(e) ?? []), v.path as string]);
      }
    }
    const dupes = [...seen.entries()].filter(([, vs]) => vs.length > 1);
    if (dupes.length) {
      console.log(`\n  ${slug}: ${dupes.length} control(s) on more than one peer view`);
      for (const [e, vs] of dupes) console.log(`      DUPLICATE ${e}  ->  ${vs.join(", ")}`);
      bad += dupes.length;
    } else {
      console.log(`  ${slug.padEnd(10)} no control on two peer views`);
    }
  }

  // A dashboard is also wrong if it silently drops a control the old one had.
  const baseDir = join(outDir(), "baseline-2026-08-11");
  if (existsSync(baseDir)) {
    const oldRefs = new Set<string>();
    for (const f of readdirSync(baseDir).filter((f) => f.endsWith(".json"))) {
      entityRefs(JSON.parse(await Bun.file(join(baseDir, f)).text())).forEach((r) => oldRefs.add(r));
    }
    const newRefs = new Set<string>();
    Object.values(built).forEach((c) => entityRefs(c).forEach((r) => newRefs.add(r)));
    // A drop is fine as long as it is a decision. model.ts records each one with a reason;
    // anything dropped without an entry there is an accident and fails the check.
    const house = await loadModel();
    const declared = new Map<string, string>(
      ((house.deliberatelyDropped as { entity: string; why: string }[]) ?? []).map((d) => [
        d.entity,
        d.why,
      ]),
    );
    const dropped = [...oldRefs].filter((r) => live.has(r) && !newRefs.has(r)).sort();
    const undeclared = dropped.filter((d) => !declared.has(d));
    console.log(
      `\n  coverage vs baseline: ${oldRefs.size} old refs, ${dropped.length} dropped ` +
        `(${dropped.length - undeclared.length} declared, ${undeclared.length} unexplained)`,
    );
    for (const d of dropped) {
      if (declared.has(d)) console.log(`      dropped (ok)  ${d}`);
      else {
        console.log(`      DROPPED, NO REASON  ${d}`);
        bad++;
      }
    }
    // A stale entry is its own bug: it claims a decision about something already back.
    for (const [e] of declared) {
      if (newRefs.has(e)) {
        console.log(`      STALE deliberatelyDropped entry, entity is on a view again: ${e}`);
        bad++;
      }
    }
  }
  return bad;
}

function existing(): { url_path: string | null; title: string }[] {
  const p = Bun.spawnSync([PACK_HA_DASH, "list", "-j"], { stdout: "pipe", stderr: "pipe" });
  if (p.exitCode !== 0) die(`ha-dashboard list failed: ${p.stderr.toString().slice(0, 200)}`);
  return JSON.parse(p.stdout.toString());
}

function ensure(): void {
  const have = new Set(existing().map((d) => d.url_path));
  for (const t of TARGETS) {
    if (have.has(t.slug)) {
      console.log(`  ${t.slug.padEnd(10)} exists`);
      continue;
    }
    const args = [PACK_HA_DASH, "create", t.slug, "--title", t.title, "--icon", t.icon];
    const p = Bun.spawnSync(args, { stdout: "pipe", stderr: "pipe" });
    console.log(
      `  ${t.slug.padEnd(10)} ${p.exitCode === 0 ? "created" : "FAILED " + p.stderr.toString().slice(0, 160)}`,
    );
  }
}

function deploy(): void {
  const dir = outDir();
  const backupDir = join(dir, "pre-deploy");
  mkdirSync(backupDir, { recursive: true });
  const have = new Set(existing().map((d) => d.url_path));
  for (const t of TARGETS) {
    const file = join(dir, `${t.slug}.json`);
    if (!existsSync(file)) die(`${file} missing — run build first`);
    if (!have.has(t.slug)) {
      console.log(`  ${t.slug.padEnd(10)} SKIPPED, dashboard does not exist — run ensure first`);
      continue;
    }
    // Back up first, always. lovelace/config/save overwrites in one shot with no undo.
    const bk = join(backupDir, `${t.slug}.json`);
    const b = Bun.spawnSync([PACK_HA_DASH, "backup", "--url-path", t.slug, "-o", bk], {
      stdout: "pipe",
      stderr: "pipe",
    });
    const backedUp = b.exitCode === 0;
    const d = Bun.spawnSync([PACK_HA_DASH, "deploy", file, "--url-path", t.slug], {
      stdout: "pipe",
      stderr: "pipe",
    });
    console.log(
      `  ${t.slug.padEnd(10)} backup=${backedUp ? "ok" : "none(new)"} deploy=${
        d.exitCode === 0 ? "ok" : "FAILED " + d.stderr.toString().slice(0, 200)
      }`,
    );
  }
}

const cmd = process.argv[2] ?? "build";
if (cmd === "build") {
  console.log("build:");
  await build();
} else if (cmd === "check") {
  console.log("check:");
  process.exit((await check()) > 0 ? 1 : 0);
} else if (cmd === "ensure") {
  console.log("ensure:");
  ensure();
} else if (cmd === "deploy") {
  console.log("build:");
  await build();
  console.log("deploy:");
  deploy();
} else {
  die(`unknown command '${cmd}' — build | check | ensure | deploy`);
}
