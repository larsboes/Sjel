#!/bin/bash
# The operator CLI. Builds its binary on first use; originals and metadata stay local.
set -euo pipefail
_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"
BIN="${CARGO_TARGET_DIR:-$SJEL_ROOT/target}/release/documents"
if [ ! -x "$BIN" ]; then
  echo "documents: building (first run)…" >&2
  (cd "$SJEL_ROOT" && cargo build --locked --release --bin documents) >&2
fi
exec "$BIN" "$@"
