#!/bin/bash
# tools/audit — the one command, and the only two scanners Axon still runs itself.
#
#   tools/audit        # no arguments, no flags
#
#   gitleaks     secret scan over this repository's git history AND the private overlay's.
#                GitHub secret scanning with push protection already covers the public repo;
#                the overlay is a private repository, where that is a paid feature, so the
#                overlay half is the one scan nothing else does.
#   osv-scanner  dependency CVEs over every lockfile here, reading osv-scanner.toml's dated
#                exceptions. Dependabot alerts watch the same lockfiles continuously; this is
#                the answer before a push rather than after it.
#
# NOT here: container images (.github/workflows/security.yml runs `grype registry:` against
# every image a service.toml declares, weekly and on push, whether or not this Mac is awake --
# report-only since Q77, with the Critical/High counts in that run's summary) and Axon's own
# source (.github/workflows/codeql.yml).
#
# Exit 0 clean · 1 a finding · 2 a scanner is not installed. A missing binary is a setup
# error, never a finding: it must not read as clean and must not read as a leak. A finding
# outranks a missing scanner, so a run with both exits 1. bash 3.2-safe.
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"   # SJEL_ROOT, SJEL_PERSONAL_ROOT

case "${1:-}" in
  "")        ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
  *)         echo "audit: takes no arguments (got '$1')" >&2; exit 2 ;;
esac

fail=0    # a scanner reported something
setup=0   # a scanner is not installed

echo "Axon audit · $(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)"

# ---- gitleaks: secret scan over Axon + the private overlay's git history ----
echo
echo "▸ gitleaks · secret scan (git history)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "  ⚠ gitleaks not installed — install: brew install gitleaks"
  setup=1
else
  # The overlay's path is never printed. A label is enough to act on, and this output reaches
  # terminals, transcripts and CI logs that the overlay's coordinate must not.
  scan_git_history() {
    label="$1"; repo="$2"
    if [ -z "$repo" ]; then echo "  · $label — not configured"; return; fi
    if [ ! -e "$repo" ]; then echo "  ✗ $label — not reachable"; fail=1; return; fi
    # A linked worktree has a .git FILE, not a directory, so ask git rather than test a path.
    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "  ✗ $label — not a Git repository"; fail=1; return
    fi
    if gitleaks detect -s "$repo" --redact --no-banner --exit-code 1 >/dev/null 2>&1; then
      echo "  ✓ $label — clean"
    else
      rc=$?
      if [ "$rc" -eq 1 ]; then
        echo "  ✗ $label — leak(s) found (details withheld; run gitleaks there yourself for redacted triage)"
      else
        echo "  ? $label — gitleaks errored (exit $rc; details withheld)"
      fi
      fail=1
    fi
  }
  scan_git_history "Axon" "$SJEL_ROOT"
  scan_git_history "private overlay" "${SJEL_PERSONAL_ROOT:-}"
fi

# ---- osv-scanner: dependency CVEs over every lockfile in the repo ----
echo
echo "▸ osv-scanner · dependency CVEs"
if ! command -v osv-scanner >/dev/null 2>&1; then
  echo "  ⚠ osv-scanner not installed — install: brew install osv-scanner"
  setup=1
else
  # Build-artifact dirs stay out: generated, not code, and capabilities/*/target alone runs to
  # thousands of files (6879 measured in scouting/target). Same set .gitignore excludes.
  # to-integrate/ joins them for the reason .gitignore excludes it
  # (README.md#scratch-is-not-documentation): pre-git scratch holding whole vendored projects,
  # not Axon's code. bazel-* stays listed after PRD Q44 retired Bazel — the symlinks it left
  # still point at multi-gigabyte trees on existing checkouts.
  args="scan source -r --config $SJEL_ROOT/osv-scanner.toml"
  for d in target bazel-bin bazel-out bazel-testlogs node_modules to-integrate; do
    args="$args --experimental-exclude $d"
  done
  # osv-scanner enforces osv-scanner.toml's ignoreUntil dates itself and names a lapsed entry
  # under "unused ignores", which is why Axon carries no clock of its own any more.
  osv-scanner $args "$SJEL_ROOT"
  rc=$?
  case "$rc" in
    0) echo "  ✓ clean" ;;
    1) echo "  ✗ vulnerabilities found above"; fail=1 ;;
    *) echo "  ? osv-scanner errored (exit $rc)"; fail=1 ;;
  esac
fi

echo
[ "$setup" -eq 1 ] && echo "── a scanner is not installed; its surface was not scanned ──"
if [ "$fail" -ne 0 ]; then
  echo "── audit: finding(s) — see above ──"
  exit 1
fi
[ "$setup" -ne 0 ] && exit 2
echo "── audit: clean ──"
exit 0
