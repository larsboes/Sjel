#!/bin/bash
# capabilities/cv/check — exercise every cv verb against a throwaway overlay built from the
# schema skeleton. Touches no real overlay and no network.
set -euo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export SJEL_OVERLAY_ROOT="$tmp"
mkdir -p "$tmp/data/cv/linkedin"
cp "$_dir/master_cv.schema.yaml" "$tmp/data/cv/master_cv.yaml"
cv="$_dir/cv"

fail() { echo "check: FAIL: $*" >&2; exit 1; }

"$cv" build --profile swe --lang de >/dev/null
[ -s "$tmp/data/cv/dist/CV_swe_de.pdf" ] || fail "build wrote no PDF"
if "$cv" build --profile nope >/dev/null 2>&1; then fail "unknown profile built"; fi

"$cv" app new acme --company "Acme" --role "Engineer" --profile swe >/dev/null
if "$cv" app new acme --company x --role y >/dev/null 2>&1; then fail "app new overwrote"; fi
if "$cv" app new "Bad Slug" --company x --role y >/dev/null 2>&1; then fail "bad slug accepted"; fi
printf 'title: {en: "OVERRIDE TITLE", de: "X"}\n' >> "$tmp/data/cv/applications/acme.yaml"
"$cv" app build acme >/dev/null
[ -s "$tmp/data/cv/dist/apps/CV_acme_en.pdf" ] || fail "app build wrote no PDF"
if command -v pdftotext >/dev/null; then
  pdftotext "$tmp/data/cv/dist/apps/CV_acme_en.pdf" - | grep -q "OVERRIDE TITLE" || fail "title override not rendered"
fi

# hide and pin: an application hides one item by id and pins a priority-3 item past auto-fit.
yq -i '.sections[0].entries[0].id = "ev1" | .sections[0].entries[0].label = "HIDE ME" |
  .sections[0].entries += [{"id": "ev2", "label": "PIN ME", "priority": 3}]' "$tmp/data/cv/master_cv.yaml"
"$cv" build --profile default >/dev/null
pdftotext "$tmp/data/cv/dist/CV_default_en.pdf" - | grep -q "PIN ME" || fail "priority-3 item dropped from a CV that fits"
printf 'hide: [ev1]\npin: [ev2]\n' >> "$tmp/data/cv/applications/acme.yaml"
"$cv" app build acme >/dev/null
pdftotext "$tmp/data/cv/dist/apps/CV_acme_en.pdf" - | grep -q "HIDE ME" && fail "hidden item rendered"
pdftotext "$tmp/data/cv/dist/apps/CV_acme_en.pdf" - | grep -q "PIN ME" || fail "pinned item missing"

"$cv" app status acme applied "via portal" >/dev/null
"$cv" app status acme interview >/dev/null
if "$cv" app status acme bogus >/dev/null 2>&1; then fail "bogus status accepted"; fi
[ "$(yq -r '.status' "$tmp/data/cv/applications/acme.yaml")" = interview ] || fail "status not set"
[ "$(yq -r '.log | length' "$tmp/data/cv/applications/acme.yaml")" = 3 ] || fail "log not appended"
[ "$(yq -r '.log[1].note' "$tmp/data/cv/applications/acme.yaml")" = "via portal" ] || fail "note lost"
[ "$(yq -r '.log[2] | has("note")' "$tmp/data/cv/applications/acme.yaml")" = false ] || fail "empty note stored"

json="$("$cv" status --json)"
[ "$(echo "$json" | jq '.applications | length')" = 1 ] || fail "status --json applications"
[ "$(echo "$json" | jq '[.pdfs[].name] | index("apps/CV_acme_en.pdf") != null')" = true ] || fail "status --json pdfs"

yq -i '.experience[0].role = {"en": "Role EN", "de": "Rolle DE"}' "$tmp/data/cv/master_cv.yaml"
"$cv" linkedin sheet | grep -q '^HEADLINE' || fail "sheet has no headline"
"$cv" linkedin sheet --lang de | grep -q '^Rolle DE @' || fail "sheet did not localize the role"

echo '[{"Headline": "Old headline", "Summary": "x"}]' > "$tmp/data/cv/linkedin/PROFILE.json"
echo '[{"Company Name": "Employer Name", "Title": "Dev", "Started On": "Jan 2024"}]' > "$tmp/data/cv/linkedin/POSITIONS.json"
echo '[{"Name": "Item A"}, {"Name": "Only On LinkedIn"}]' > "$tmp/data/cv/linkedin/SKILLS.json"
diff_out="$("$cv" linkedin diff)"
echo "$diff_out" | grep -q "linkedin: Old headline" || fail "diff headline"
echo "$diff_out" | sed -n '/only on LinkedIn/,/only in master/p' | grep -q "only on linkedin" || fail "diff skills"

# import: a CSV export fills the same snapshot without a token.
mkdir -p "$tmp/export"
printf 'Name\nPython\n' > "$tmp/export/Skills.csv"
cat > "$tmp/export/Positions.csv" <<'CSV'
Company Name,Title,Location,Started On,Finished On,Description
Acme,Dev,Bonn,Jan 2024,,"Line one, with a comma
line two"
CSV
"$cv" linkedin import "$tmp/export" | grep -q "POSITIONS: 1 record(s)" || fail "import positions"
[ "$(jq -r '.[0].Description' "$tmp/data/cv/linkedin/POSITIONS.json")" = "Line one, with a comma
line two" ] || fail "import lost a quoted description"
[ "$(cat "$tmp/data/cv/linkedin/SOURCE")" = export ] || fail "import did not record its source"
[ "$(jq -r '.[0].Name' "$tmp/data/cv/linkedin/SKILLS.json")" = Python ] || fail "import skills"
if "$cv" linkedin import "$tmp" >/dev/null 2>&1; then fail "import accepted a directory with no export"; fi

# edit: a broken put leaves the file unchanged, a good put replaces it.
before="$(cat "$tmp/data/cv/master_cv.yaml")"
if printf 'name: [unclosed\n' | "$cv" edit put >/dev/null 2>&1; then fail "invalid YAML accepted"; fi
if printf 'name: "X"\n' | "$cv" edit put >/dev/null 2>&1; then fail "unrenderable master accepted"; fi
[ "$(cat "$tmp/data/cv/master_cv.yaml")" = "$before" ] || fail "rejected put changed the master"
"$cv" edit get | sed 's/Firstname Lastname/Edited Name/' | "$cv" edit put >/dev/null
"$cv" edit get | grep -q "Edited Name" || fail "edit put did not save"
[ "$(stat -f %Lp "$tmp/data/cv/master_cv.yaml" 2>/dev/null || stat -c %a "$tmp/data/cv/master_cv.yaml")" = 644 ] || fail "edit put changed the file mode"

# model: the typed JSON round-trips without a change, and a JSON edit lands in the YAML.
"$cv" model get | "$cv" model put >/dev/null   # first put normalizes the hand-written fixture
[ "$("$cv" model get | "$cv" model put)" = "cv: no change" ] || fail "model round-trip changed the master"
[ "$("$cv" model get acme | "$cv" model put acme)" = "cv: no change" ] || fail "model round-trip changed the application"
"$cv" model get | jq '.name = "JSON Name"' | "$cv" model put >/dev/null
grep -q 'JSON Name' "$tmp/data/cv/master_cv.yaml" || fail "model put did not save"
if "$cv" model get | jq '.skills[0].priority = 7' | "$cv" model put >/dev/null 2>&1; then fail "priority 7 accepted"; fi

echo "check: ok"
