#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["fritzconnection>=1.15"]
# ///
"""fritz — query an AVM Fritz!Box over two transports.

TR-064 (via fritzconnection) gives the authoritative host table. The AVM JSON API
(`login_sid.lua` + `data.lua`, stdlib only) gives what TR-064 cannot: per-client RSSI,
MCS index, negotiated rate, serving AP, mesh topology, the timestamped event log, and
CPU load. Diagnosing a slow WLAN needs the second one.

Split source of truth: non-secret connection facts (FRITZBOX_HOST, FRITZBOX_USERNAME) come from the
committed overlay config (<overlay>/config/home-assistant.vars). The secret (FRITZBOX_PASSWORD) comes
from Bitwarden at runtime — never hardcoded, never printed. Needs an unlocked session in $BW_SESSION
(the user unlocks interactively; this tool never sees the master password). See SKILL.md.

Read-only by contract: every request is a GET or an `xhr=1` data fetch. Nothing here writes
configuration, and no subcommand should ever be added that does.
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path

def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"
BW_ITEM_DEFAULT = "home-assistant/fritz"
TIMEOUT = int(os.environ.get("FRITZ_TIMEOUT", "20"))


def die(msg: str) -> None:
    print(f"fritz: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained auth failure."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def cfg(*keys):
    """Read non-secret scalar values. An env var of the same name wins over the overlay file —
    the precedence `netmon` already documents in this pack, so the two skills behave alike."""
    vals = {}
    if VARS_FILE.exists():
        for line in VARS_FILE.read_text().splitlines():
            s = line.strip()
            if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
                continue
            k, _, v = s.partition(":")
            vals[k.strip()] = _scalar(v)
    for k in keys:                       # env wins per key, not all-or-nothing
        if os.environ.get(k):
            vals[k] = os.environ[k]
    if not vals and not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def cfg_opt(key: str):
    """Optional config lookup — env, then the overlay file, then None. Unlike cfg() this is
    silent when the key is absent: an optional setting has no business printing an error."""
    if os.environ.get(key):
        return os.environ[key]
    if not VARS_FILE.exists():
        return None
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        if k.strip() == key:
            val = _scalar(v)
            return val if val and not val.startswith("TODO-") else None
    return None


def bw_secret(field: str, login_fallback: bool = False) -> str:
    """Fetch a secret from the Bitwarden item. Never prints the value.

    Looks in the item's custom fields first (the documented convention), then — when
    `login_fallback` is set — in the item's own password slot. Vault items created through
    the browser extension put the password there and carry no custom fields at all, so
    insisting on the convention would reject a perfectly good credential.
    """
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool). "
            "Note: an unlocked desktop app does NOT unlock the CLI; they hold separate vault state.")
    item_name = cfg_opt("FRITZ_BW_ITEM") or BW_ITEM_DEFAULT
    r = subprocess.run(["bw", "get", "item", item_name, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {item_name}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION still exits 0 here with a plain-text complaint instead of JSON, so
    # the parse is where a locked vault surfaces — not the return code checked above.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {item_name}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in (item.get("fields") or [])}
    if fields.get(field):
        return fields[field]
    if login_fallback and (item.get("login") or {}).get("password"):
        return item["login"]["password"]
    die(f"bw item '{item_name}' has neither a custom field '{field}' nor a login password. "
        f"Set FRITZ_BW_ITEM (env or the overlay vars file) to the item that holds the credential.")


def bw_creds() -> dict:
    """Compose creds: non-secret host/user from the committed overlay config, password from Bitwarden."""
    host, user = cfg("FRITZBOX_HOST", "FRITZBOX_USERNAME")
    return {"FRITZBOX_HOST": host, "FRITZBOX_USERNAME": user,
            "FRITZBOX_PASSWORD": bw_secret("FRITZBOX_PASSWORD", login_fallback=True)}


# ── TR-064 transport ────────────────────────────────────────────────────────────

def _hosts(creds):
    from fritzconnection.lib.fritzhosts import FritzHosts
    return FritzHosts(address=creds["FRITZBOX_HOST"],
                      user=creds["FRITZBOX_USERNAME"],
                      password=creds["FRITZBOX_PASSWORD"])


# ── JSON API transport (login_sid.lua + data.lua) ───────────────────────────────

INVALID_SID = "0000000000000000"


class Box:
    """An authenticated JSON-API session against the box. Read-only by contract."""

    def __init__(self, creds: dict):
        self.base = f"http://{creds['FRITZBOX_HOST']}"
        self.user = creds["FRITZBOX_USERNAME"]
        self.sid = self._login(creds["FRITZBOX_PASSWORD"])

    def _get(self, path: str, data: bytes = None) -> str:
        req = urllib.request.Request(self.base + path, data=data)
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                return r.read().decode("utf-8", "replace")
        except Exception as e:
            die(f"{self.base}{path}: {type(e).__name__}: {e} — is the box reachable on this network?")

    @staticmethod
    def _response(challenge: str, password: str) -> str:
        """AVM challenge-response. `2$…` is PBKDF2 (FRITZ!OS 7.24+); anything else is legacy MD5."""
        if challenge.startswith("2$"):
            _, it1, salt1, it2, salt2 = challenge.split("$")
            h1 = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt1), int(it1))
            h2 = hashlib.pbkdf2_hmac("sha256", h1, bytes.fromhex(salt2), int(it2))
            return f"{salt2}${h2.hex()}"
        digest = hashlib.md5(f"{challenge}-{password}".encode("utf-16-le")).hexdigest()
        return f"{challenge}-{digest}"

    def _login(self, password: str) -> str:
        xml = self._get("/login_sid.lua?version=2")
        challenge = re.search(r"<Challenge>(.*?)</Challenge>", xml)
        blocktime = re.search(r"<BlockTime>(\d+)</BlockTime>", xml)
        if blocktime and int(blocktime.group(1)) > 0:
            die(f"box is rate-limiting logins for {blocktime.group(1)}s (earlier bad password) — wait it out.")
        if not challenge:
            die("no <Challenge> in /login_sid.lua — unexpected FRITZ!OS response shape.")
        body = urllib.parse.urlencode({
            "username": self.user,
            "response": self._response(challenge.group(1), password),
        }).encode()
        xml = self._get("/login_sid.lua?version=2", data=body)
        sid = re.search(r"<SID>(.*?)</SID>", xml)
        if not sid or sid.group(1) == INVALID_SID:
            die(f"login rejected for user '{self.user}' — wrong password, or that user lacks "
                f"the 'FRITZ!Box Einstellungen' right. (The password is never printed.)")
        return sid.group(1)

    def data(self, page: str, **params) -> dict:
        """Fetch one data.lua page. Returns the parsed `data` object."""
        body = urllib.parse.urlencode({"xhr": 1, "sid": self.sid, "lang": "de",
                                       "page": page, "xhrId": "all", **params}).encode()
        raw = self._get("/data.lua", data=body)
        try:
            doc = json.loads(raw)
        except json.JSONDecodeError:
            die(f"data.lua page='{page}' did not return JSON (session expired, or page unknown to this FRITZ!OS)")
        return doc.get("data", doc)

    def first_page(self, *pages, key=None):
        """Try candidate page names, return (page, data) for the first that yields usable data.

        FRITZ!OS renames data.lua pages between versions; this keeps the opinionated
        subcommands working without pinning them to one firmware. `fritz api` is the
        escape hatch when none of the candidates match.
        """
        for page in pages:
            d = self.data(page)
            if d and (key is None or d.get(key)):
                return page, d
        return None, {}


def _n(v, default="?"):
    """Render a value that AVM sometimes omits, sometimes returns as an empty string."""
    return default if v in (None, "", "-") else v


# ── TR-064 subcommands ──────────────────────────────────────────────────────────

def cmd_devices(args) -> int:
    hosts = _hosts(bw_creds()).get_hosts_info()
    rows = [h for h in hosts if args.all or h.get("status")]
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    print(f"{'IP':<15} {'MAC':<18} {'IF':<10} {'ACTIVE':<7} NAME")
    for h in sorted(rows, key=lambda x: (not x.get("status"), x.get("ip", ""))):
        print(f"{h.get('ip',''):<15} {h.get('mac',''):<18} "
              f"{str(h.get('interface_type','')):<10} "
              f"{'yes' if h.get('status') else 'no':<7} {h.get('name','')}")
    print(f"\n{len(rows)} device(s){'' if args.all else ' (active only; --all for inactive)'}")
    return 0


def cmd_guest(args) -> int:
    from fritzconnection.lib.fritzwlan import FritzGuestWLAN
    c = bw_creds()
    g = FritzGuestWLAN(address=c["FRITZBOX_HOST"], user=c["FRITZBOX_USERNAME"], password=c["FRITZBOX_PASSWORD"])
    state = "enabled" if g.is_enabled else "disabled"
    print(json.dumps({"guest_wlan": state}) if args.json else f"Guest WLAN: {state}")
    return 0


# ── JSON-API subcommands ────────────────────────────────────────────────────────

def cmd_wlan(args) -> int:
    """WLAN clients. --detail uses the JSON API for RSSI/MCS/rate/serving-AP; plain uses TR-064."""
    if not args.detail:
        from fritzconnection.lib.fritzwlan import FritzWLAN
        c = bw_creds()
        fw = FritzWLAN(address=c["FRITZBOX_HOST"], user=c["FRITZBOX_USERNAME"], password=c["FRITZBOX_PASSWORD"])
        clients = fw.get_hosts_info()
        if args.json:
            print(json.dumps({"ssid": fw.ssid, "clients": clients}, ensure_ascii=False, indent=2))
            return 0
        print(f"SSID: {fw.ssid}   associated clients: {len(clients)}")
        for c in clients:
            print(f"  {c.get('mac',''):<18} {c.get('ip',''):<15} signal={_n(c.get('signal'))} speed={_n(c.get('speed'))}")
        print("\n(TR-064 view — no MCS, no serving AP. Use --detail for the router's own radio view.)")
        return 0

    creds = bw_creds()
    rows = _assoc(creds)
    tree = _topology(Box(creds))
    by_ip = {d.get("ipinfo"): d for d in tree["devices"].values() if d.get("ipinfo")}
    for r in rows:
        d = by_ip.get(r["ip"])
        r["name"] = _dname(d) if d else None
        r["served_by"] = _pname(d, tree) if d else None
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    if not rows:
        die("no associated WLAN clients reported by TR-064.")
    print(f"{'CLIENT':<26} {'IP':<16} {'BAND':<7} {'SPEED':>7} {'SIGNAL':>7} {'WIDTH':>6}  SERVED BY")
    for r in sorted(rows, key=lambda x: (x["speed"] if x["speed"] is not None else 10**9)):
        flag = "  <-- airtime hog" if (r["speed"] or 0) and r["speed"] <= 30 else ""
        print(f"{_n(r['name'],'?')[:26]:<26} {_n(r['ip'],'-'):<16} {_n(r['band']):<7} "
              f"{_n(r['speed']):>5} Mb {_n(r['signal']):>6}% {_n(r['width']):>4}MHz  "
              f"{_n(r['served_by'],'-')}{flag}")
    slow = [r for r in rows if (r["speed"] or 0) and r["speed"] <= 30]
    print(f"\n{len(rows)} client(s) associated directly to the box "
          f"(clients behind a repeater are served by it and do not appear here).")
    if slow:
        print(f"{len(slow)} at 30 Mbit/s or below. A client transmitting at a tenth of the rate "
              f"holds the medium roughly ten times longer per byte — the airtime anomaly. Hunt "
              f"these before touching channel settings.")
    print("Signal is AVM's 0–100 % scale, not dBm. For dBm/MCS read the client side "
          "(`system_profiler SPAirPortDataType` on macOS).")
    return 0


def _assoc(creds) -> list:
    """Per-client radio view over TR-064.

    `data.lua` does not carry speed, signal or channel width — but TR-064 does, via
    `GetGenericAssociatedDeviceInfo` on each WLANConfiguration service. Same box, different
    transport: when one API looks empty, check the other before concluding the firmware
    withholds the data.
    """
    from fritzconnection import FritzConnection
    fc = FritzConnection(address=creds["FRITZBOX_HOST"], user=creds["FRITZBOX_USERNAME"],
                         password=creds["FRITZBOX_PASSWORD"])
    rows = []
    for i in (1, 2, 3):
        svc = f"WLANConfiguration{i}"
        if svc not in fc.services:
            continue
        try:
            band = fc.call_action(svc, "GetInfo").get("NewX_AVM-DE_FrequencyBand")
            total = fc.call_action(svc, "GetTotalAssociations")["NewTotalAssociations"]
        except Exception:
            continue
        label = {"2400": "2.4GHz", "5000": "5GHz"}.get(str(band), str(band))
        for idx in range(total):
            try:
                d = fc.call_action(svc, "GetGenericAssociatedDeviceInfo", NewAssociatedDeviceIndex=idx)
            except Exception:
                continue
            rows.append({"mac": d.get("NewAssociatedDeviceMACAddress"),
                         "ip": d.get("NewAssociatedDeviceIPAddress"), "band": label,
                         "speed": d.get("NewX_AVM-DE_Speed"),
                         "signal": d.get("NewX_AVM-DE_SignalStrength"),
                         "width": d.get("NewX_AVM-DE_ChannelWidth")})
    return rows


def _topology(box) -> dict:
    """The homeNet device graph, keyed by UID, with the mesh root identified."""
    h = box.data("homeNet")
    devices = {d["UID"]: d for d in (h.get("devices") or []) if isinstance(d, dict) and d.get("UID")}
    root = ((h.get("topology") or {}).get("rootuid")
            or next((u for u, d in devices.items() if d.get("master")), None))
    return {"devices": devices, "root": root}


def _dname(d: dict) -> str:
    return (d.get("nameinfo") or {}).get("name") or d.get("UID", "?")


def _pname(d: dict, tree: dict) -> str:
    p = tree["devices"].get(d.get("parent") or "")
    return _dname(p) if p else "-"


def _is_wlan_child(d: dict, tree: dict) -> bool:
    p = tree["devices"].get(d.get("parent") or "")
    return bool(p) and bool(p.get("children")) and d.get("conn") == "wlan"


def cmd_mesh(args) -> int:
    """The mesh tree, and how many clients sit behind each access point.

    The client count per AP is the airtime story: every client behind a wirelessly-backhauled
    repeater spends its traffic twice on the air — once repeater-to-client, once repeater-to-box.
    """
    box = Box(bw_creds())
    tree = _topology(box)
    devs = tree["devices"]
    if args.raw:
        print(json.dumps(devs, ensure_ascii=False, indent=2))
        return 0
    aps = {u: d for u, d in devs.items() if d.get("children")}
    if not aps:
        die("no access points with children found — inspect with `fritz api homeNet`.")
    out = []
    for u, d in sorted(aps.items(), key=lambda kv: -len(kv[1].get("children") or [])):
        out.append({"ap": _dname(d), "ip": d.get("ipinfo"), "uplink": d.get("conn"),
                    "is_root": bool(d.get("master")), "clients": len(d.get("children") or []),
                    "parent": _pname(d, tree)})
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    print(f"{'ACCESS POINT':<28} {'IP':<16} {'UPLINK':<8} {'CLIENTS':>7}  PARENT")
    for r in out:
        note = "  (mesh root)" if r["is_root"] else ""
        print(f"{r['ap'][:28]:<28} {_n(r['ip'],'-'):<16} {_n(r['uplink']):<8} {r['clients']:>7}  "
              f"{r['parent']}{note}")
    wireless = [r for r in out if not r["is_root"] and r["uplink"] == "wlan"]
    if wireless:
        behind = sum(r["clients"] for r in wireless)
        print(f"\n{len(wireless)} repeater(s) backhaul over WLAN, carrying {behind} client(s) between "
              f"them. That traffic crosses the air twice and competes with the root AP's own clients. "
              f"A wired backhaul returns the whole radio to serving clients.")
    return 0


# ── canonical state, snapshot and drift ─────────────────────────────────────────

STATE_FILE_DEFAULT = "config/network-state.md"


def _state(box) -> dict:
    """The box's whole diagnosable state as one comparable object.

    Everything here is a setting or a topology fact — deliberately no live counters (load,
    uptime, client rates), because drift detection must fire on "someone changed something",
    not on "the network is busy right now".
    """
    st, chan, wset = box.data("wStat"), box.data("chan"), box.data("wSet")
    w = wset.get("wlanSettings") or {}
    fos, net = st.get("fritzos") or {}, st.get("net") or {}
    bands = {}
    for band in ("24ghz", "5ghz"):
        b = chan.get(band) or {}
        act = [x for x in (b.get("channels") or []) if x.get("active")]
        bands[band] = {
            "channels": [x.get("value") for x in act],
            "width_mhz": sorted({str(x.get("channelwidth")) for x in act}),
            "dfs_channels": [x.get("value") for x in act if x.get("dfs")],
            "weather_radar_channels": [x.get("value") for x in act if x.get("weather")],
        }
    tree = _topology(box)
    aps = sorted(
        ({"ap": _dname(d), "ip": d.get("ipinfo"), "uplink": d.get("conn"),
          "is_root": bool(d.get("master")), "clients": len(d.get("children") or [])}
         for d in tree["devices"].values() if d.get("children")),
        key=lambda r: (not r["is_root"], r["ap"]))
    return {
        "model": fos.get("Productname"), "fritzos": fos.get("nspver"),
        "ssid_24": w.get("ssid"), "ssid_5": w.get("ssidScnd"),
        "split_ssids": bool(w.get("differentSSIDs")),
        "channel_select_mode": chan.get("channelSelectMode"),
        "ht160_active": (chan.get("ht160") or {}).get("active"),
        "band_steering": (chan.get("bandSteering") or {}).get("on"),
        "coexistence": (chan.get("coexist") or {}).get("on"),
        "bands": bands,
        "access_points": aps,
        "devices_active": net.get("active_count"),
        "any_unmeshed": net.get("anyUnmeshedDevices"),
    }


def _state_path() -> Path:
    root = _home_overlay_root()
    return Path(cfg_opt("NETWORK_STATE_FILE") or (root / STATE_FILE_DEFAULT))


def _render_state(s: dict, when: str) -> str:
    """Human-readable state plus the canonical JSON that `drift` compares against.

    Both live in one file on purpose: a generated document whose machine-readable half sits
    somewhere else is two things that can disagree.
    """
    L = [f"""---
last_updated: {when}
last_updated_by: fritz snapshot
convention: pai-freshness-v1
generator: Axon/Packs/home-automation/skills/fritz/scripts/fritz
---

# Network state — generated

> **Do not edit.** Regenerate with `fritz snapshot --write`; check with `fritz drift`.
> Interpretation, doctrine and the runbook live in `network.md` — this file is only what the
> box reports about itself.

| | |
|---|---|
| Model | {_n(s['model'])} (FRITZ!OS {_n(s['fritzos'])}) |
| SSIDs | `{_n(s['ssid_24'])}` (2.4) / `{_n(s['ssid_5'])}` (5) — split: {s['split_ssids']} |
| Channel selection | {_n(s['channel_select_mode'])} |
| 160 MHz active | {s['ht160_active']} |
| Band steering | {s['band_steering']}{' (inert — split SSIDs)' if s['band_steering'] and s['split_ssids'] else ''} |
| 2.4 GHz coexistence | {s['coexistence']} |
| Active devices | {_n(s['devices_active'])} |
| Unmeshed devices | {s['any_unmeshed']} |

## Radio

| Band | Channels | Width | DFS | Weather radar |
|---|---|---|---|---|"""]
    for band, b in s["bands"].items():
        L.append(f"| {band} | {b['channels'] or '-'} | {'/'.join(b['width_mhz']) or '-'} MHz "
                 f"| {b['dfs_channels'] or '—'} | {b['weather_radar_channels'] or '—'} |")
    L.append("\n## Access points\n\n| AP | IP | Uplink | Clients |\n|---|---|---|---|")
    for a in s["access_points"]:
        L.append(f"| {a['ap']}{' (root)' if a['is_root'] else ''} | {_n(a['ip'],'-')} "
                 f"| {_n(a['uplink'])} | {a['clients']} |")
    L.append("\n## Canonical state\n\n```json\n" + json.dumps(s, ensure_ascii=False, indent=2) + "\n```")
    return "\n".join(L) + "\n"


def _stored_state(path: Path):
    """Pull the canonical JSON back out of a previously written snapshot."""
    if not path.exists():
        return None
    m = re.search(r"## Canonical state\s*\n+```json\n(.*?)\n```", path.read_text(), re.S)
    return json.loads(m.group(1)) if m else None


# Facts that change on their own and must never make drift fire. `devices_active` moves every
# time a phone joins; `clients` per AP moves as devices roam. Both were in the compared set on
# the first live run and drift fired seconds after its own snapshot — the failure this list fixes.
VOLATILE_TOP = {"devices_active", "any_unmeshed"}
VOLATILE_LEAF = {"clients"}


def _comparable(s: dict) -> dict:
    """The subset of state that drift compares: settings and topology identity, never counters."""
    out = {k: v for k, v in s.items() if k not in VOLATILE_TOP}
    out["access_points"] = [{k: v for k, v in ap.items() if k not in VOLATILE_LEAF}
                            for ap in s.get("access_points", [])]
    return out


def _flatten(o, prefix=""):
    if isinstance(o, dict):
        for k, v in o.items():
            yield from _flatten(v, f"{prefix}.{k}" if prefix else k)
    elif isinstance(o, list) and any(isinstance(x, dict) for x in o):
        for i, v in enumerate(o):
            yield from _flatten(v, f"{prefix}[{i}]")
    else:
        yield prefix, o


def cmd_snapshot(args) -> int:
    box = Box(bw_creds())
    s = _state(box)
    if args.json:
        print(json.dumps(s, ensure_ascii=False, indent=2))
        return 0
    when = box.data("wStat").get("fritzos", {}).get("boxDate") or "unknown"
    text = _render_state(s, when)
    if not args.write:
        print(text)
        print(f"# not written — pass --write to update {_state_path()}", file=sys.stderr)
        return 0
    p = _state_path()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text)
    print(f"wrote {p}")
    return 0


INVENTORY_FILE_DEFAULT = "config/network-devices.md"


def cmd_inventory(args) -> int:
    """The device table, generated from the box.

    Deliberately NOT part of `snapshot`/`drift`: phones and laptops come and go, so a device
    list would make drift fire constantly and train everyone to ignore it. Settings drift is
    signal; a guest's iPhone leaving is not.
    """
    creds = bw_creds()
    hosts = _hosts(creds).get_hosts_info()
    tree = _topology(Box(creds))
    served = {}
    for d in tree["devices"].values():
        ip = d.get("ipinfo")
        if ip:
            served[ip] = _pname(d, tree)
    rows = sorted(hosts, key=lambda h: (not h.get("status"),
                                        [int(x) for x in (h.get("ip") or "0.0.0.0").split(".")]))
    if args.json:
        print(json.dumps([{**h, "served_by": served.get(h.get("ip"))} for h in rows],
                         ensure_ascii=False, indent=2))
        return 0
    active = [h for h in rows if h.get("status")]
    L = [f"""---
last_updated_by: fritz inventory
convention: pai-freshness-v1
generator: Axon/Packs/home-automation/skills/fritz/scripts/fritz
---

# Network devices — generated

> **Do not edit.** Regenerate with `fritz inventory --write`.
> What a device *is for* — and the open "what even is this" questions — belong in `network.md`,
> not here: the box knows addresses, not purposes.

{len(active)} active of {len(rows)} known devices.

| IP | Name | MAC | Link | Served by | Active |
|---|---|---|---|---|---|"""]
    for h in rows:
        L.append(f"| {_n(h.get('ip'),'-')} | {_n(h.get('name'),'-')} | `{_n(h.get('mac'),'-')}` "
                 f"| {_n(h.get('interface_type'),'-')} | {_n(served.get(h.get('ip')),'-')} "
                 f"| {'yes' if h.get('status') else 'no'} |")
    text = "\n".join(L) + "\n"
    if not args.write:
        print(text)
        return 0
    root = _home_overlay_root()
    p = Path(cfg_opt("NETWORK_INVENTORY_FILE") or (root / INVENTORY_FILE_DEFAULT))
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text)
    print(f"wrote {p}  ({len(active)} active / {len(rows)} known)")
    return 0


def cmd_drift(args) -> int:
    """Fail when the recorded state and the box disagree.

    This exists because a hand-maintained file cannot notice it has gone stale: `network.md`
    described channel 48 at 80 MHz while the box ran channel 100 at 160 MHz, and nothing
    surfaced it until someone happened to look.
    """
    p = _state_path()
    old = _stored_state(p)
    if old is None:
        die(f"no snapshot at {p} — run `fritz snapshot --write` first to record a baseline.")
    new = _state(Box(bw_creds()))
    a, b = dict(_flatten(_comparable(old))), dict(_flatten(_comparable(new)))
    diffs = [(k, a.get(k), b.get(k)) for k in sorted(set(a) | set(b)) if a.get(k) != b.get(k)]
    if args.json:
        print(json.dumps([{"key": k, "recorded": o, "box": n} for k, o, n in diffs],
                         ensure_ascii=False, indent=2))
        return 1 if diffs else 0
    if not diffs:
        print(f"no drift — {p.name} matches the box")
        return 0
    print(f"{len(diffs)} difference(s) between {p.name} and the box:\n")
    for k, o, n in diffs:
        print(f"  {k}\n    recorded: {o}\n    box:      {n}")
    print(f"\nRegenerate with `fritz snapshot --write` once you know which side is right.")
    return 1


# ── writes (D-5: dry-run by default, diff shown, read-back mandatory) ───────────

def _wlan_svc(fc, band: str) -> str:
    """Resolve '2.4'/'5' to the WLANConfiguration service that actually carries that band.
    The index-to-band mapping is conventional, not guaranteed — ask the box."""
    want = {"2.4": "2400", "5": "5000"}[band]
    for i in (1, 2, 3):
        svc = f"WLANConfiguration{i}"
        if svc in fc.services and str(fc.call_action(svc, "GetInfo").get("NewX_AVM-DE_FrequencyBand")) == want:
            return svc
    die(f"no WLANConfiguration service reports the {band} GHz band on this box.")


def cmd_set_channel(args) -> int:
    """Pin a band's channel over TR-064's documented `SetChannel` action.

    Channel is settable over TR-064; **channel width is not** — no Set action on any
    WLANConfiguration service takes a width argument (only Get actions report it per client).
    Turning 160 MHz off therefore still needs the web UI, and this tool says so rather than
    guessing at data.lua form fields it has never seen.
    """
    from fritzconnection import FritzConnection
    creds = bw_creds()
    fc = FritzConnection(address=creds["FRITZBOX_HOST"], user=creds["FRITZBOX_USERNAME"],
                         password=creds["FRITZBOX_PASSWORD"])
    svc = _wlan_svc(fc, args.band)
    before = fc.call_action(svc, "GetInfo")
    old = before.get("NewChannel")
    print(f"transport: TR-064 {svc}.SetChannel   band: {args.band} GHz   SSID: {before.get('NewSSID')}")
    print(f"  channel: {old}  ->  {args.channel}")
    if old == args.channel:
        print("already set — nothing to do.")
        return 0
    if not args.apply:
        print(f"\nDRY RUN — nothing sent. Re-run with --apply to fire:")
        print(f"  fritz set-channel {args.band} {args.channel} --apply")
        return 0
    print(f"\napplying… (clients on this band will briefly disassociate)")
    fc.call_action(svc, "SetChannel", NewChannel=args.channel)
    after = fc.call_action(svc, "GetInfo").get("NewChannel")
    print(f"read-back: channel is now {after}")
    if after != args.channel:
        die(f"READ-BACK MISMATCH — asked for {args.channel}, box reports {after}. "
            f"The change did not take effect as intended.")
    print("verified: box agrees with intent.")
    print("Next: `fritz snapshot --write` to record the new state, then `fritz drift` to confirm clean.")
    return 0


def cmd_log(args) -> int:
    box = Box(bw_creds())
    params = {"filter": args.filter} if args.filter else {}
    d = box.data("log", **params)
    entries = d.get("log") or d.get("filter_" + (args.filter or "")) or []
    if args.json:
        print(json.dumps(entries, ensure_ascii=False, indent=2))
        return 0
    if not entries:
        die("event log came back empty — try `fritz api log --raw` (page shape varies by FRITZ!OS).")
    for e in entries[: args.limit]:
        if isinstance(e, dict):
            print(f"{_n(e.get('date'))} {_n(e.get('time'))}  {_n(e.get('msg') or e.get('message'),'')}")
        elif isinstance(e, list) and len(e) >= 3:
            print(f"{e[0]} {e[1]}  {e[2]}")
    print(f"\n{min(len(entries), args.limit)} of {len(entries)} entries"
          f"{f' (filter={args.filter})' if args.filter else ''}")
    return 0


def cmd_overview(args) -> int:
    """Box identity, device count, mesh health and subsystem load.

    Note the page name: FRITZ!OS 8.25 serves this payload from `wStat` and returns plain HTML
    for `page=overview`, which is why the obvious name is not the one used here.
    """
    box = Box(bw_creds())
    st = box.data("wStat")
    energy = box.data("energy")
    fos, net = st.get("fritzos") or {}, st.get("net") or {}
    load = {x.get("name"): x.get("actPerc") for x in (energy.get("drain") or []) if isinstance(x, dict)}
    uptime = next((x.get("statuses") for x in (energy.get("drain") or [])
                   if isinstance(x, dict) and "Gesamtsystem" in str(x.get("name"))), None)
    out = {"model": fos.get("Productname"), "fritzos": fos.get("nspver"), "box_date": fos.get("boxDate"),
           "devices_active": net.get("active_count"), "unmeshed_devices": net.get("anyUnmeshedDevices"),
           "uptime": uptime, "load": load}
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    print(f"Model:            {_n(out['model'])}  (FRITZ!OS {_n(out['fritzos'])})")
    print(f"Box time:         {_n(out['box_date'])}")
    print(f"Uptime:           {_n(out['uptime'])}")
    print(f"Active devices:   {_n(out['devices_active'])}")
    print(f"Unmeshed devices: {_n(out['unmeshed_devices'])}")
    for name, pct in load.items():
        print(f"  power {name:<26} {pct}%")
    print("\nThese come from the box's ENERGY monitor (`page=energy` → `drain`): share of power "
          "draw per subsystem, NOT utilisation. A WLAN row at 100 % means the radios are fully "
          "powered, not that the medium is congested — do not read it as saturation. Real airtime "
          "utilisation lives in the UI under WLAN → Funkkanal → 'Auslastung des aktuellen Funkkanals'.")
    return 0


def cmd_chan(args) -> int:
    """Which channel each band actually runs on, how wide, and whether that lands in DFS.

    This is the setting that decides whether the 5 GHz network can be evicted by radar, and
    it is the one a web UI makes hardest to read at a glance.
    """
    box = Box(bw_creds())
    c = box.data("chan")
    w = (box.data("wSet") or {}).get("wlanSettings") or {}
    out = {"channel_select": c.get("channelSelectMode"), "ht160": (c.get("ht160") or {}).get("active"),
           "band_steering": (c.get("bandSteering") or {}).get("on"),
           "split_ssids": bool(w.get("differentSSIDs")), "coexist": (c.get("coexist") or {}).get("on"),
           "bands": {}}
    for band in ("24ghz", "5ghz"):
        b = c.get(band) or {}
        active = [x for x in (b.get("channels") or []) if x.get("active")]
        out["bands"][band] = [{"channel": x.get("value"), "width": x.get("channelwidth"),
                               "dfs": x.get("dfs"), "weather_radar": x.get("weather"),
                               "interference": x.get("interference")} for x in active]
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
        return 0
    print(f"Channel selection: {_n(out['channel_select'])}   160 MHz active: {out['ht160']}   "
          f"coexistence: {out['coexist']}")
    for band, chans in out["bands"].items():
        if not chans:
            continue
        widths = sorted({str(x["width"]) for x in chans})
        dfs = [x["channel"] for x in chans if x["dfs"]]
        wx = [x["channel"] for x in chans if x["weather_radar"]]
        print(f"\n{band}: channels {[x['channel'] for x in chans]} @ {'/'.join(widths)} MHz")
        if dfs:
            print(f"  DFS (radar can evict):        {dfs}")
        if wx:
            print(f"  weather-radar sub-band:       {wx}   <-- strictest rules, longest check")
        intf = [x["channel"] for x in chans if x["interference"]]
        if intf:
            print(f"  interference reported on:     {intf}")
    if out["band_steering"] and out["split_ssids"]:
        print("\nBand steering is ON but the two bands use different SSIDs — steering cannot act. "
              "Enabled-and-inert reads as configured, which is worse than off.")
    return 0


def cmd_api(args) -> int:
    """Escape hatch: fetch any data.lua page verbatim. This is what keeps the tool
    useful when AVM renames a page — no need to resurrect a throwaway script."""
    box = Box(bw_creds())
    extra = dict(kv.split("=", 1) for kv in args.param) if args.param else {}
    print(json.dumps(box.data(args.page, **extra), ensure_ascii=False, indent=2))
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="fritz", description="Query an AVM Fritz!Box (TR-064 + JSON API). Read-only.")
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("devices", help="[TR-064] host table (ip/name/mac/interface/active)")
    d.add_argument("--all", "-a", action="store_true", help="include inactive hosts")
    d.add_argument("--json", "-j", action="store_true")
    d.set_defaults(fn=cmd_devices)

    w = sub.add_parser("wlan", help="WLAN clients; --detail adds RSSI/MCS/rate/serving-AP via the JSON API")
    w.add_argument("--detail", "-d", action="store_true", help="router's radio view (RSSI, MCS, rate, AP)")
    w.add_argument("--json", "-j", action="store_true")
    w.set_defaults(fn=cmd_wlan)

    g = sub.add_parser("guest", help="[TR-064] guest-WLAN enabled status")
    g.add_argument("--json", "-j", action="store_true")
    g.set_defaults(fn=cmd_guest)

    m = sub.add_parser("mesh", help="[JSON] mesh topology — nodes, clients, backhaul rates")
    m.add_argument("--json", "-j", action="store_true")
    m.add_argument("--raw", action="store_true", help="dump the whole page")
    m.set_defaults(fn=cmd_mesh)

    l = sub.add_parser("log", help="[JSON] timestamped event log — dates a sudden-onset problem")
    l.add_argument("--filter", "-f", choices=["sys", "net", "wlan", "usb", "fon"], help="event class")
    l.add_argument("--limit", "-n", type=int, default=40)
    l.add_argument("--json", "-j", action="store_true")
    l.set_defaults(fn=cmd_log)

    o = sub.add_parser("overview", help="[JSON] model, FRITZ!OS, uptime, device count, unmeshed flag, subsystem load")
    o.add_argument("--json", "-j", action="store_true")
    o.set_defaults(fn=cmd_overview)

    c = sub.add_parser("chan", help="[JSON] active channel + width per band, and whether that sits in DFS")
    c.add_argument("--json", "-j", action="store_true")
    c.set_defaults(fn=cmd_chan)

    sn = sub.add_parser("snapshot", help="[JSON] record the box's settings + topology as a generated doc")
    sn.add_argument("--write", "-w", action="store_true", help="write to the overlay instead of stdout")
    sn.add_argument("--json", "-j", action="store_true")
    sn.set_defaults(fn=cmd_snapshot)

    sc = sub.add_parser("set-channel", help="[TR-064] pin a band's channel — DRY RUN unless --apply")
    sc.add_argument("band", choices=["2.4", "5"])
    sc.add_argument("channel", type=int)
    sc.add_argument("--apply", action="store_true", help="actually send it (clients will disassociate)")
    sc.set_defaults(fn=cmd_set_channel)

    iv = sub.add_parser("inventory", help="[both] generated device table (IP/name/MAC/link/serving AP)")
    iv.add_argument("--write", "-w", action="store_true", help="write to the overlay instead of stdout")
    iv.add_argument("--json", "-j", action="store_true")
    iv.set_defaults(fn=cmd_inventory)

    dr = sub.add_parser("drift", help="[JSON] exit non-zero when the recorded snapshot and the box disagree")
    dr.add_argument("--json", "-j", action="store_true")
    dr.set_defaults(fn=cmd_drift)

    a = sub.add_parser("api", help="[JSON] raw data.lua page (escape hatch when AVM renames a page)")
    a.add_argument("page", help="e.g. overview, energy, netDev, wSet, homeNet, log")
    a.add_argument("--param", "-p", action="append", metavar="K=V", help="extra POST parameter")
    a.add_argument("--raw", action="store_true", help="accepted for symmetry; output is always raw JSON")
    a.set_defaults(fn=cmd_api)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:  # fritzconnection surfaces auth/TR-064 errors here
        die(f"{type(e).__name__}: {e} — is TR-064 enabled and the user allowed 'FRITZ!Box Settings'?")


if __name__ == "__main__":
    raise SystemExit(main())
