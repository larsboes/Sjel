#!/usr/bin/env bash
# apps/gpui-prototype/bench-scroll [page] — measure what one scroll frame costs the app.
#
# Starts ~/Applications/Sjel Desktop.app without focus, in a corner window above other apps
# (GPUI paints nothing while a window is covered). Opens
# sjel://<page> (default: capabilities), and lets the app scroll itself down and back up
# (SJEL_GPUI_BENCH_SCROLL, src/frames.rs). Prints per-frame CPU percentiles. macOS caps an
# inactive window near 30 fps, so the frame interval here is not the on-screen rate.
# Run ./install first: this measures the release build a person uses.
set -euo pipefail
[ "$(uname -s)" = Darwin ] || { echo "bench-scroll: macOS only" >&2; exit 1; }

APP="$HOME/Applications/Sjel Desktop.app"
PAGE="${1:-capabilities}"
out="$(mktemp -t sjel-frames)"
trap 'rm -f "$out"' EXIT

osascript -e 'tell application id "dev.sjel.desktop" to quit' >/dev/null 2>&1 || true
# A running copy would take the launch without the bench's environment.
for _ in $(seq 50); do pgrep -f "Sjel Desktop.app/Contents/MacOS" >/dev/null || break; sleep 0.1; done
# SJEL_GPUI_BENCH_NOTE=<record path> types into that note instead of scrolling (src/frames.rs).
bench="SJEL_GPUI_BENCH_SCROLL=1"
[ -n "${SJEL_GPUI_BENCH_NOTE:-}" ] && bench="SJEL_GPUI_BENCH_NOTE=$SJEL_GPUI_BENCH_NOTE"
open -g --env "SJEL_GPUI_FRAMES=$out" --env "$bench" --env SJEL_GPUI_NO_ACTIVATE=1 --env SJEL_GPUI_FLOAT=1 \
  --env "SJEL_GPUI_OPEN=sjel://$PAGE" ${SJEL_GPUI_OPAQUE:+--env SJEL_GPUI_OPAQUE=1} "$APP"
sleep 1
# The app quits itself when the bench ends.
for _ in $(seq 150); do pgrep -f "Sjel Desktop.app/Contents/MacOS" >/dev/null || break; sleep 0.1; done

python3 - "$out" <<'PY'
import sys
rows = [tuple(map(int, l.split())) for l in open(sys.argv[1]) if l.strip()]
if len(rows) < 10:
    sys.exit(f"bench-scroll: only {len(rows)} frames painted")
fresh = [row for row, prev in zip(rows[1:], rows) if row[0] != prev[0]]
build = [(built - start) / 1000 for start, built, _, _ in fresh]
cpu = [(end - start) / 1000 for start, _, end, _ in fresh]
def pct(values, p):
    values = sorted(values)
    return values[min(len(values) - 1, int(len(values) * p))]
def line(name, values):
    print(f"{name:<22} p50 {pct(values, .5):6.2f}  p95 {pct(values, .95):6.2f}  max {max(values):6.2f}  ms")
print(f"frames painted         {len(rows)}   (renders of the workspace: {len(fresh)})")
line("view build", build)
line("render→paint (CPU)", cpu)
print(f"frames over 8.3 ms CPU {sum(1 for c in cpu if c > 8.33)} of {len(cpu)}   (the 120 Hz budget)")
PY
