#!/usr/bin/env python3
"""energy-dashboard — configure the Home Assistant Energy Dashboard (pure Python 3 stdlib).

The Energy Dashboard preferences live behind HA's WebSocket API (energy/get_prefs,
energy/save_prefs) — the REST API does not expose them — so this tool speaks the
WebSocket protocol directly with a minimal stdlib client (no `websockets` dependency).

Split source of truth (mirrors the fritz skill): the non-secret HA_URL comes from the
committed overlay config (<overlay>/config/home-assistant.vars). The secret HA_TOKEN (a
long-lived access token) comes from Bitwarden at runtime — never hardcoded, never printed.
The WebSocket endpoint is derived from HA_URL (http->ws, https->wss, path /api/websocket).

Requires an unlocked Bitwarden session in $BW_SESSION (the user unlocks interactively;
this tool never sees the master password). See SKILL.md.

Source entities are never hardcoded — pass them as flags (or a --sources-file JSON array),
so nothing is pinned to one house's sensors.

Commands:
  show                      read and print the current energy sources (--json for raw prefs)
  set [flags]               write energy sources built from flags (or --sources-file)

`set` flags (each source is added only if its required entity is given):
  --solar-production ENTITY   solar production energy sensor (stat_energy_from)
  --solar-power ENTITY        optional instantaneous solar power sensor (stat_rate)
  --grid-import ENTITY        grid import energy sensor (stat_energy_from)
  --grid-export ENTITY        optional grid export energy sensor (stat_energy_to)
  --battery-from ENTITY       battery discharge energy sensor (stat_energy_from)
  --battery-to ENTITY         battery charge energy sensor (stat_energy_to)
  --sources-file PATH         raw energy_sources JSON array (bypasses the flags above)

`set` is idempotent and preserves what the UI already holds: existing grid price/cost
config and the solar Forecast.Solar entry are read back and merged, not wiped.
"""
import argparse
import base64
import json
import os
import socket
import ssl
import struct
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse

BW_ITEM = os.environ.get("HA_BW_ITEM", "home-assistant/ha")
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"

# Grid price/cost fields HA expects on a grid source; defaulted to null and then
# overlaid with whatever the instance already has so a write never wipes UI settings.
GRID_PRICE_KEYS = (
    "stat_cost", "entity_energy_price", "number_energy_price",
    "stat_compensation", "entity_energy_price_export", "number_energy_price_export",
)


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg: str) -> None:
    print(f"energy-dashboard: {msg}", file=sys.stderr)
    raise SystemExit(1)


# --- Split source of truth: non-secret config vs Bitwarden secret ----------

def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def bw_secret(field: str) -> str:
    """Fetch a single secret field from the Bitwarden item. Never prints the value."""
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool).")
    r = subprocess.run(["bw", "get", "item", BW_ITEM, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {BW_ITEM}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION passes the presence check above and `bw` still exits 0, printing a
    # plain-text complaint instead of JSON — so the parse, not the return code, is where a
    # locked vault actually surfaces. Say so, instead of raising JSONDecodeError at the caller.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {BW_ITEM}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in item.get("fields", [])}
    if not fields.get(field):
        die(f"bw item '{BW_ITEM}' is missing secret field: {field}")
    return fields[field]


# --- Minimal stdlib WebSocket client ----------------------------------------

class WS:
    """Tiny RFC 6455 client — text frames only, enough for the HA WS API. No deps."""

    def __init__(self, url: str, timeout: int = 15):
        u = urlparse(url)
        self.host = u.hostname
        self.port = u.port or (443 if u.scheme == "wss" else 80)
        self.path = (u.path or "/") + (("?" + u.query) if u.query else "")
        self.secure = u.scheme == "wss"
        self.timeout = timeout
        self.sock = None
        self._buf = b""

    def connect(self) -> None:
        try:
            raw = socket.create_connection((self.host, self.port), timeout=self.timeout)
        except OSError as e:
            die(f"cannot reach {self.host}:{self.port}: {e} (is HA_URL right and the host reachable?)")
        if self.secure:
            # create_default_context() verifies certs and hostnames but does not floor the
            # protocol version: TLS 1.0 and 1.1 stay permitted unless the OpenSSL build or a
            # system policy forbids them, which is not something a skill can assume about the
            # machine it lands on. Set the floor here so the guarantee travels with the script.
            ctx = ssl.create_default_context()
            ctx.minimum_version = ssl.TLSVersion.TLSv1_2
            raw = ctx.wrap_socket(raw, server_hostname=self.host)
        self.sock = raw
        key = base64.b64encode(os.urandom(16)).decode()
        handshake = (
            f"GET {self.path} HTTP/1.1\r\n"
            f"Host: {self.host}:{self.port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(handshake.encode())
        status = self._read_until(b"\r\n\r\n").split(b"\r\n", 1)[0]
        if b"101" not in status:
            die(f"WebSocket handshake failed: {status.decode(errors='replace')}")

    def _read_until(self, delim: bytes) -> bytes:
        while delim not in self._buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                die("connection closed during WebSocket handshake")
            self._buf += chunk
        head, self._buf = self._buf.split(delim, 1)
        return head + delim

    def _recv_exact(self, n: int) -> bytes:
        while len(self._buf) < n:
            chunk = self.sock.recv(4096)
            if not chunk:
                die("WebSocket connection closed unexpectedly")
            self._buf += chunk
        data, self._buf = self._buf[:n], self._buf[n:]
        return data

    def _send_frame(self, opcode: int, payload: bytes) -> None:
        header = bytearray([0x80 | opcode])  # FIN + opcode
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)          # mask bit + length
        elif n < 65536:
            header.append(0x80 | 126)
            header += struct.pack(">H", n)
        else:
            header.append(0x80 | 127)
            header += struct.pack(">Q", n)
        mask = os.urandom(4)
        header += mask
        header += bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        self.sock.sendall(bytes(header))

    def send_json(self, obj: dict) -> None:
        self._send_frame(0x1, json.dumps(obj).encode("utf-8"))

    def recv_text(self) -> str:
        while True:
            b0, b1 = self._recv_exact(2)
            opcode = b0 & 0x0f
            masked = b1 & 0x80
            length = b1 & 0x7f
            if length == 126:
                length = struct.unpack(">H", self._recv_exact(2))[0]
            elif length == 127:
                length = struct.unpack(">Q", self._recv_exact(8))[0]
            mask = self._recv_exact(4) if masked else b""
            payload = self._recv_exact(length)
            if masked:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:            # close
                die("WebSocket closed by server")
            if opcode == 0x9:            # ping -> pong, keep reading
                self._send_frame(0xA, payload)
                continue
            if opcode == 0xA:            # pong
                continue
            return payload.decode("utf-8")

    def close(self) -> None:
        try:
            if self.sock:
                self._send_frame(0x8, b"")
                self.sock.close()
        except OSError:
            pass


def ws_command(ws: WS, msg: dict) -> dict:
    """Send an id'd command, return its `result` payload; die on failure. Skips events."""
    ws.send_json(msg)
    while True:
        reply = json.loads(ws.recv_text())
        if reply.get("id") != msg.get("id"):
            continue  # unrelated event/message on the same socket
        if reply.get("type") == "result" and not reply.get("success", True):
            die(f"HA rejected {msg['type']}: {json.dumps(reply.get('error', reply))}")
        return reply.get("result", {})


def connect_authed() -> WS:
    (url,) = cfg("HA_URL")
    token = bw_secret("HA_TOKEN")
    u = urlparse(url)
    ws_url = f"{'wss' if u.scheme == 'https' else 'ws'}://{u.netloc}/api/websocket"
    ws = WS(ws_url)
    ws.connect()
    json.loads(ws.recv_text())                                   # auth_required
    ws.send_json({"type": "auth", "access_token": token})
    auth = json.loads(ws.recv_text())
    if auth.get("type") != "auth_ok":
        die(f"authentication failed (type={auth.get('type')}) — is HA_TOKEN valid?")
    return ws


# --- Source construction -----------------------------------------------------

def build_sources(args) -> list:
    """Build the energy_sources array from flags (or load it raw from --sources-file)."""
    if args.sources_file:
        try:
            data = json.load(open(args.sources_file, encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as e:
            die(f"cannot read --sources-file {args.sources_file}: {e}")
        if not isinstance(data, list):
            die("--sources-file must contain a JSON array of energy_sources")
        return data

    sources = []
    if args.solar_production:
        solar = {"type": "solar", "stat_energy_from": args.solar_production}
        if args.solar_power:
            solar["stat_rate"] = args.solar_power
        sources.append(solar)
    if args.grid_import:
        grid = {"type": "grid", "stat_energy_from": args.grid_import, "cost_adjustment_day": 0.0}
        for k in GRID_PRICE_KEYS:
            grid[k] = None
        if args.grid_export:
            grid["stat_energy_to"] = args.grid_export
        sources.append(grid)
    if args.battery_from or args.battery_to:
        if not (args.battery_from and args.battery_to):
            die("battery needs both --battery-from (discharge) and --battery-to (charge)")
        sources.append({"type": "battery",
                        "stat_energy_from": args.battery_from,
                        "stat_energy_to": args.battery_to})
    if not sources:
        die("no sources given — pass --solar-production / --grid-import / --battery-* or --sources-file")
    return sources


def preserve(new: list, current: list) -> list:
    """Merge instance-held settings the UI owns (solar forecast entry, grid prices)
    onto the freshly-built sources so a write never wipes them."""
    for cur in current:
        if cur.get("type") == "solar" and cur.get("config_entry_solar_forecast"):
            for n in new:
                if n["type"] == "solar":
                    n["config_entry_solar_forecast"] = cur["config_entry_solar_forecast"]
        if cur.get("type") == "grid":
            for n in new:
                if n["type"] == "grid":
                    for k in GRID_PRICE_KEYS:
                        if cur.get(k) is not None:
                            n[k] = cur[k]
    return new


def print_sources(sources: list) -> None:
    if not sources:
        print("  (no energy sources configured)")
        return
    for s in sources:
        t = s.get("type")
        if t == "solar":
            print(f"  solar   production -> {s.get('stat_energy_from', '-')}")
            if s.get("stat_rate"):
                print(f"  solar   power      -> {s['stat_rate']}")
        elif t == "grid":
            print(f"  grid    import     -> {s.get('stat_energy_from', '-')}")
            if s.get("stat_energy_to"):
                print(f"  grid    export     -> {s['stat_energy_to']}")
        elif t == "battery":
            print(f"  battery discharge  -> {s.get('stat_energy_from', '-')}")
            print(f"  battery charge     -> {s.get('stat_energy_to', '-')}")
        else:
            print(f"  {t}: {json.dumps(s)}")


# --- Commands ----------------------------------------------------------------

def cmd_show(args) -> int:
    ws = connect_authed()
    try:
        prefs = ws_command(ws, {"id": 1, "type": "energy/get_prefs"})
    finally:
        ws.close()
    if args.json:
        print(json.dumps(prefs, indent=2, ensure_ascii=False))
        return 0
    print_sources(prefs.get("energy_sources", []))
    return 0


def cmd_set(args) -> int:
    sources = build_sources(args)
    ws = connect_authed()
    try:
        current = ws_command(ws, {"id": 1, "type": "energy/get_prefs"})
        sources = preserve(sources, current.get("energy_sources", []))
        ws_command(ws, {"id": 2, "type": "energy/save_prefs",
                        "energy_sources": sources, "device_consumption": []})
    finally:
        ws.close()
    print("Energy Dashboard configured:")
    print_sources(sources)
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="energy-dashboard",
                                description="Configure the Home Assistant Energy Dashboard over the WebSocket API.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sh = sub.add_parser("show", help="read and print the current energy sources")
    sh.add_argument("--json", "-j", action="store_true", help="print raw prefs JSON")
    sh.set_defaults(fn=cmd_show)

    st = sub.add_parser("set", help="write energy sources built from flags or --sources-file")
    st.add_argument("--solar-production", help="solar production energy sensor (stat_energy_from)")
    st.add_argument("--solar-power", help="instantaneous solar power sensor (stat_rate)")
    st.add_argument("--grid-import", help="grid import energy sensor (stat_energy_from)")
    st.add_argument("--grid-export", help="grid export energy sensor (stat_energy_to)")
    st.add_argument("--battery-from", help="battery discharge energy sensor (stat_energy_from)")
    st.add_argument("--battery-to", help="battery charge energy sensor (stat_energy_to)")
    st.add_argument("--sources-file", help="raw energy_sources JSON array (bypasses the flags)")
    st.set_defaults(fn=cmd_set)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
