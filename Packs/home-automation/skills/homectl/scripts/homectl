#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"          # tomllib is stdlib from 3.11
# dependencies = ["pyyaml"]
# ///
"""homectl — MATERIALIZER for the Axon `home-assistant` capability.

The selected overlay ships the automation TEMPLATES (`capabilities/home-assistant/
automations/*.yaml.tmpl`) carrying only `%%TOKENS%%` — never a real entity ID — and the
component lockfile beside them. The real values live in ONE gitignored overlay file
(`config/home-assistant.vars`). homectl fills the templates from that map at build time
and vendors the pinned components.

Templates and lockfile sit in the overlay rather than in Axon because which automations
exist and which third-party components run describes one building, and the set of them is
an inventory even where every value is a token. Axon keeps the mechanism: service.toml,
TEMPLATING.md, the automation doctrine, the .example scaffolding.

Three subcommands:
  materialize  fill every template's %%TOKENS%% from the vars map -> deploy-ready YAML
  components   clone each pinned custom component at its ref, vendor it into the instance
  doctor       static coverage check (missing tokens / orphan vars / vars parse)

Token contract (see Packs/home-automation/skills/homectl/references/templating.md):
  %%NAME%%          scalar   -> the string value of vars[NAME], substituted inline
  %%LIST:NAME%%     sequence -> vars[NAME] (a YAML list) expanded into a YAML block sequence
  %%JSON:NAME%%     literal  -> vars[NAME] emitted as a compact JSON literal for Jinja to parse
HA's own `{{ }}` Jinja is left UNTOUCHED — it is not a %%token%%.

Derived projections (from the single OVERRIDE_MAP = [{entity, timer}] list):
  %%LIST:OVERRIDE_ENTITIES%%  -> the YAML sequence of just the `entity` values
  %%JSON:OVERRIDE_MAP%%       -> the JSON object {"<entity>": "<timer>", ...}

Doctrine: zero hardcoded paths (every path is an arg, defaulted from env or the script's
own location), and nothing instance-shaped is ever written into public Axon.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib
import urllib.request
import zipfile
from pathlib import Path

import yaml

# ── Path defaults (env-derived, all overridable via args — zero hardcoded paths) ──
# Fall back to this file's own position rather than a guessed checkout location: the script
# lives at <SJEL_ROOT>/Packs/home-automation/skills/homectl/scripts/homectl, which is true on
# every machine. The previous default was ~/Developer/Axon, a Mac-shaped path that does not
# exist on the family Pi (Axon sits at ~/Axon there), so every invocation without SJEL_ROOT
# died on a missing components.toml.
# parents[5] is the canonical depth. Guard it: a copy of this script somewhere flat (a scratch
# dir, a container /tmp) would otherwise die with an IndexError at import, before it can even
# say what it was looking for.
_PARENTS = Path(__file__).resolve().parents
_SELF_ROOT = _PARENTS[5] if len(_PARENTS) > 5 else _PARENTS[-1]
SJEL_ROOT = Path(os.environ.get("SJEL_ROOT") or _SELF_ROOT)
# Where the real values live. Resolved from the environment, else from axon.local.toml.
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        # The machine already declares its overlay in axon.local.toml; requiring the same
        # fact in the environment as well made homectl unusable from a plain shell on the
        # host that actually runs Home Assistant.
        local = SJEL_ROOT / "axon.local.toml"
        if local.is_file():
            with local.open("rb") as fh:
                raw = tomllib.load(fh).get("overlay")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; set `overlay` in axon.local.toml, "
                         "source tools/lib/paths.sh, or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


SJEL_HOME_ROOT = _home_overlay_root()

# The templates and the component lockfile live in the OVERLAY, not in public Axon. Both
# describe what a particular house has — which automations exist, which third-party
# components run — and the set of them is an inventory even though every value is a
# %%TOKEN%% and every pin is a public repo. Axon keeps the mechanism:
# service.toml, TEMPLATING.md, the doctrine, and the .example scaffolding.
DEF_CAPS = SJEL_HOME_ROOT / "capabilities/home-assistant"
DEF_VARS = SJEL_HOME_ROOT / "config/home-assistant.vars"
DEF_OUT = SJEL_HOME_ROOT / "build/home-assistant"          # instance-specific output — never public Axon
DEF_COMPONENTS = DEF_CAPS / "components.toml"
# Home Assistant's own config root inside the overlay — the directory bind-mounted to /config.
# Both vendor destinations hang off it. They used to hang off config/ directly, one level too
# high, so a vendor run wrote into a directory HA never reads and reported "new vendor" for a
# component that was already deployed.
DEF_HA_CONFIG = SJEL_HOME_ROOT / "config/home-assistant"
DEF_DEST = DEF_HA_CONFIG / "custom_components"
DEF_PACKAGES_DEST = DEF_HA_CONFIG / "integrations"  # HA packages: !include_dir_named integrations
DEF_WWW_DEST = DEF_HA_CONFIG / "www"  # served at /local/<file>; a dashboard resource points here

# A %%token%%: optional LIST:/JSON: kind prefix + an UPPER_SNAKE name.
TOKEN_RE = re.compile(r"%%(?:(LIST|JSON):)?([A-Z0-9_]+)%%")
# A line whose whole value is a single %%LIST:NAME%% token (e.g. `      entity_id: %%LIST:X%%`).
LIST_LINE_RE = re.compile(r"^(?P<pre>\s*[\w.\-]+:[ \t]*)%%LIST:(?P<name>[A-Z0-9_]+)%%[ \t]*$")


class MaterializeError(Exception):
    """A token could not be resolved / a value had the wrong shape — always names token + file."""


# ── vars loading + token resolution ──────────────────────────────────────────
def load_vars(path: Path) -> dict:
    with path.open(encoding="utf-8") as fh:
        data = yaml.safe_load(fh)
    if not isinstance(data, dict):
        raise MaterializeError(f"vars file {path} did not parse to a mapping")
    return data


def resolve(kind: str | None, name: str, vars: dict, where: str):
    """Resolve one token to its Python value. `where` = 'TOKEN in file' for errors.

    Handles the two DERIVED projections off OVERRIDE_MAP; everything else is a direct
    vars[name] lookup. Raises MaterializeError (naming token + file) on any miss/shape error.
    """
    # Derived: OVERRIDE_ENTITIES -> the entity list off OVERRIDE_MAP.
    if name == "OVERRIDE_ENTITIES":
        src = _require(vars, "OVERRIDE_MAP", where)
        return [_field(item, "entity", where) for item in _as_list(src, where)]
    # Derived: JSON:OVERRIDE_MAP -> the {entity: timer} dict off OVERRIDE_MAP.
    if name == "OVERRIDE_MAP" and kind == "JSON":
        src = _as_list(_require(vars, "OVERRIDE_MAP", where), where)
        return {_field(i, "entity", where): _field(i, "timer", where) for i in src}
    # Direct lookup.
    return _require(vars, name, where)


def source_var(name: str) -> str:
    """The vars key a token name ultimately reads from (for coverage/orphan checks)."""
    return "OVERRIDE_MAP" if name == "OVERRIDE_ENTITIES" else name


def _require(vars: dict, key: str, where: str):
    if key not in vars:
        raise MaterializeError(f"no var for token {where} (expected key '{key}' in the vars file)")
    return vars[key]


def _as_list(val, where: str) -> list:
    if not isinstance(val, list):
        raise MaterializeError(f"token {where}: expected a YAML list, got {type(val).__name__}")
    return val


def _field(item, key: str, where: str) -> str:
    if not isinstance(item, dict) or key not in item:
        raise MaterializeError(f"token {where}: list item {item!r} is missing '{key}'")
    return str(item[key])


# ── JSON literal emission (quote-context aware) ──────────────────────────────
def json_literal(obj, single_quote: bool) -> str:
    """Compact JSON literal. When the token sits inside a double-quoted YAML scalar we emit
    single-quote string delimiters so the JSON's own quotes don't terminate the YAML string
    early (Jinja parses single-quoted dict/list literals just as happily). ensure_ascii=False
    keeps umlauts (Hügel) literal so YAML round-trips them cleanly."""
    s = json.dumps(obj, ensure_ascii=False)  # default separators: ', ' and ': ' -> matches the contract
    if single_quote:
        if "'" in s:  # a data value contained a single quote — swapping would corrupt it
            raise MaterializeError(f"cannot single-quote JSON literal containing a single quote: {s}")
        s = s.replace('"', "'")
    return s


# ── template materialization ─────────────────────────────────────────────────
def strip_header(text: str) -> tuple[str, str]:
    """Split off the leading contiguous comment/blank legend block (top of file, never inside
    a block scalar). That header restates the token grammar — including the meta `%%NAME%%`
    placeholder, which has no instance var — so it must not reach the resolver or the output.
    Returns (header, body)."""
    lines = text.splitlines(keepends=True)
    i = 0
    while i < len(lines) and (not lines[i].strip() or lines[i].lstrip().startswith("#")):
        i += 1
    return "".join(lines[:i]), "".join(lines[i:])


def materialize_text(text: str, vars: dict, template_name: str) -> str:
    """Fill one template's body. Leading legend header is stripped and replaced with a
    generated-by note; every %%token%% in the body is resolved."""
    _, body = strip_header(text)
    out: list[str] = [f"# Generated by homectl from {template_name} — do not edit.\n"
                      f"# Edit the overlay template and vars, then re-materialize.\n"]

    for line in body.splitlines():
        m = LIST_LINE_RE.match(line)
        if m:
            # Whole-value LIST token: expand into a YAML block sequence, items indented to the
            # token's column (always deeper than the key -> unambiguously nests under it).
            pre, name = m.group("pre"), m.group("name")
            where = f"%%LIST:{name}%% in {template_name}"
            seq = resolve("LIST", name, vars, where)
            if not isinstance(seq, list):
                raise MaterializeError(f"token {where}: expected a YAML list, got {type(seq).__name__}")
            indent = " " * len(pre)
            out.append(pre.rstrip())                       # `      entity_id:`
            out.extend(f"{indent}- {item}" for item in seq)  # `      - switch.x`, ...
            continue

        # Inline substitution for scalar / JSON tokens (also hits tokens inside `message: >` Jinja).
        def repl(tok: re.Match, _line=line) -> str:
            kind, name = tok.group(1), tok.group(2)
            where = f"%%{(kind + ':') if kind else ''}{name}%% in {template_name}"
            obj = resolve(kind, name, vars, where)
            if kind == "JSON":
                inside_dquote = _line[: tok.start()].count('"') % 2 == 1
                return json_literal(obj, single_quote=inside_dquote)
            if kind == "LIST":
                # A LIST token that is NOT a whole-value line — no defined inline expansion.
                raise MaterializeError(f"token {where}: %%LIST%% used inline (only whole-value lines expand)")
            if not isinstance(obj, str):  # scalar must be a string value
                raise MaterializeError(f"token {where}: expected a scalar string, got {type(obj).__name__}")
            return obj

        out.append(TOKEN_RE.sub(repl, line))

    return "\n".join(out).rstrip("\n") + "\n"


def cmd_materialize(args) -> int:
    caps, vars_path, out = Path(args.caps), Path(args.vars), Path(args.out)
    tmpl_dir = caps / "automations"
    templates = sorted(tmpl_dir.glob("*.yaml.tmpl"))
    if not templates:
        print(f"error: no *.yaml.tmpl under {tmpl_dir}", file=sys.stderr)
        return 1

    vars = load_vars(vars_path)
    out_auto = out / "automations"
    out_auto.mkdir(parents=True, exist_ok=True)

    written = []
    for tmpl in templates:
        name = tmpl.name                       # e.g. irrigation-weather-skip.yaml.tmpl
        dest = out_auto / name[: -len(".tmpl")]  # -> irrigation-weather-skip.yaml
        try:
            filled = materialize_text(tmpl.read_text(encoding="utf-8"), vars, name)
        except MaterializeError as e:
            print(f"error: {e}", file=sys.stderr)
            return 1

        # Post-conditions: no %% token may survive, and it must parse as YAML.
        leftover = TOKEN_RE.search(filled) or ("%%" in filled)
        if leftover:
            print(f"error: {dest.name} still contains a %% token after materialization", file=sys.stderr)
            return 1
        try:
            yaml.safe_load(filled)
        except yaml.YAMLError as e:
            print(f"error: {dest.name} is not valid YAML after materialization: {e}", file=sys.stderr)
            return 1

        dest.write_text(filled, encoding="utf-8")
        written.append(dest)

    print(f"materialized {len(written)} automation(s) -> {out_auto}")
    for d in written:
        print(f"  {d.name}")
    print("verified: 0 %% tokens remain, every file parses as YAML.")
    return 0


# ── pinned custom components ─────────────────────────────────────────────────
def _clone_at_ref(repo: str, ref: str, workdir: Path) -> Path:
    """Clone `repo` at `ref` into workdir/src. `repo` may be `owner/name` shorthand or a URL.
    Fast path: --depth 1 --branch <ref>. Fallback: full clone + git checkout <ref> (for a SHA)."""
    url = repo if "://" in repo or repo.startswith("git@") else f"https://github.com/{repo}.git"
    src = workdir / "src"
    fast = subprocess.run(
        ["git", "clone", "--depth", "1", "--branch", ref, url, str(src)],
        capture_output=True, text=True,
    )
    if fast.returncode == 0:
        return src
    # Fallback: full clone then checkout (handles refs that aren't a branch/tag, e.g. a bare SHA).
    subprocess.run(["git", "clone", url, str(src)], check=True, capture_output=True, text=True)
    subprocess.run(["git", "-C", str(src), "checkout", ref], check=True, capture_output=True, text=True)
    return src


def _fetch_asset(repo: str, ref: str, asset: str, workdir: Path) -> Path:
    """Download a release asset and unpack it into workdir/src.

    Some components are not runnable from their repo tree. HACS at tag 2.0.5 is 95 KB of Python
    in `custom_components/hacs/` and a 19 MB `hacs.zip` release asset; the difference is the
    bundled frontend, without which its panel cannot render. For those, the release IS the
    artifact and the tree is only its source."""
    if not asset.endswith(".zip"):
        raise SystemExit(f"asset must be a .zip (got {asset!r})")
    url = f"https://github.com/{repo}/releases/download/{ref}/{asset}"
    src = workdir / "src"
    src.mkdir(parents=True, exist_ok=True)
    archive = workdir / asset
    # The URL is composed from operator-owned manifest values, not from anything fetched.
    with urllib.request.urlopen(url, timeout=120) as resp:  # nosemgrep: python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected
        archive.write_bytes(resp.read())
    with zipfile.ZipFile(archive) as zf:
        # A zip is free to name entries "../x"; refuse rather than write outside the destination.
        for name in zf.namelist():
            target = (src / name).resolve()
            if not str(target).startswith(str(src.resolve())):
                raise SystemExit(f"refusing {asset}: entry escapes the destination ({name})")
        zf.extractall(src)
    archive.unlink()
    return src


def _diff_summary(old: Path, new: Path) -> tuple[str, str]:
    """(verdict, human summary) of what vendoring WOULD change vs the committed snapshot.

    verdict is "new" (nothing there yet), "same", or "changed". This only looks; the caller
    decides. Separating the two is the point — the old version returned a string and the
    caller deleted the destination regardless, so you learned what you had overwritten
    after it was gone."""
    if not old.exists():
        n = sum(1 for _ in new.rglob("*") if _.is_file()) if new.is_dir() else 1
        return "new", f"new vendor ({n} file(s))"
    # Home Assistant writes __pycache__ into every component it loads. Counting that as a
    # divergence would block the guard below on every entry, forever, for a build artifact.
    r = subprocess.run(["diff", "-rq", "-x", "__pycache__", "-x", "*.pyc", str(old), str(new)],
                       capture_output=True, text=True)
    if not r.stdout.strip():
        return "same", "no change vs current snapshot"
    lines = [ln for ln in r.stdout.splitlines() if ln.strip()]
    return "changed", f"{len(lines)} path(s) changed:\n    " + "\n    ".join(lines[:12]) + (
        f"\n    … (+{len(lines) - 12} more)" if len(lines) > 12 else "")


def _swap_in(src: Path, dest: Path) -> None:
    """Put `src` at `dest` without ever leaving `dest` half-written.

    The obvious shape — delete dest, then copy — has a window where the deployed component
    is gone. That window is not theoretical: Home Assistant runs as root in its container
    and writes __pycache__/ into every component it loads, so shutil.rmtree hits a
    PermissionError partway through and leaves a directory with no manifest.json (#213).

    Renaming sidesteps it. os.rename on a directory needs write permission on the PARENT,
    not on the contents, so a root-owned __pycache__ inside is irrelevant. The old copy is
    moved aside, the new one is built at the real path, and only then is the old one swept
    up. A failure before the rename leaves the deployment untouched; a failure after it
    still has the old copy sitting next to it under a visible name."""
    stash = dest.with_name(dest.name + ".replaced")
    if stash.exists():
        shutil.rmtree(stash, ignore_errors=True)

    had_old = dest.exists()
    if had_old:
        os.rename(dest, stash)          # atomic; works over root-owned contents
    try:
        if src.is_dir():
            shutil.copytree(src, dest)
        else:
            shutil.copy2(src, dest)
    except Exception:
        # Put the deployment back exactly as it was before re-raising.
        if dest.exists():
            shutil.rmtree(dest, ignore_errors=True) if dest.is_dir() else dest.unlink()
        if had_old:
            os.rename(stash, dest)
        raise

    if had_old:
        if stash.is_dir():
            shutil.rmtree(stash, ignore_errors=True)
        else:
            stash.unlink(missing_ok=True)
        if stash.exists():
            # Root-owned leftovers we may not delete. Say so rather than pretend it is gone.
            print(f"    note: could not remove {stash} (leftover files you do not own); "
                  f"the new copy is in place", file=sys.stderr)


def cmd_components(args) -> int:
    comp_path = Path(args.components)
    # `kind` picks the destination. A Python integration lands in custom_components/<name>/;
    # a YAML package is one file that HA loads via `packages: !include_dir_named integrations`;
    # a Lovelace resource is one JS file in www/, which HA serves at /local/ for a dashboard to
    # load. All three answer the same question — which external code runs in this HA, at which
    # ref — so a frontend resource belongs in this manifest and not in a separate installer.
    dest_by_kind = {
        "component": Path(args.dest),
        "package": Path(args.packages_dest),
        "lovelace": Path(args.www_dest),
    }
    with comp_path.open("rb") as fh:
        manifest = tomllib.load(fh)

    selected = set(args.only or [])
    unknown = selected - {k for k, v in manifest.items() if isinstance(v, dict)}
    if unknown:
        print(f"error: --only names no such entry: {', '.join(sorted(unknown))}", file=sys.stderr)
        return 1

    ok = True
    for name, entry in manifest.items():
        if not isinstance(entry, dict):
            continue
        if selected and name not in selected:
            continue
        repo, ref = entry.get("repo"), entry.get("ref")
        kind = entry.get("kind", "component")
        if kind not in dest_by_kind:
            print(f"[{name}] error: unknown kind={kind!r} — expected one of "
                  f"{', '.join(repr(k) for k in dest_by_kind)}", file=sys.stderr)
            ok = False
            continue
        if not repo or not ref:
            print(f"[{name}] warning: missing repo/ref — skipped", file=sys.stderr)
            continue
        if repo == "UNTRACED":
            print(f"[{name}] warning: repo=UNTRACED (upstream not traced) — skipped", file=sys.stderr)
            continue
        rel = entry.get("file")
        if kind in ("package", "lovelace") and not rel:
            what = "the YAML package" if kind == "package" else "the built JS file"
            print(f"[{name}] error: kind={kind!r} needs `file` — {what} inside the repo", file=sys.stderr)
            ok = False
            continue

        dest_root = dest_by_kind[kind]
        # Not under --dry-run: creating the destination is already a write, and a wrong
        # --packages-dest would leave a stray empty directory behind in a run that promised
        # to touch nothing.
        if not args.dry_run:
            dest_root.mkdir(parents=True, exist_ok=True)

        asset = entry.get("asset")
        with tempfile.TemporaryDirectory(prefix=f"homectl-{name}-") as tmp:
            try:
                src = (_fetch_asset(repo, ref, asset, Path(tmp)) if asset
                       else _clone_at_ref(repo, ref, Path(tmp)))
            except subprocess.CalledProcessError as e:
                print(f"[{name}] error cloning {repo}@{ref}: {e.stderr or e}", file=sys.stderr)
                ok = False
                continue
            except (OSError, ValueError, zipfile.BadZipFile) as e:
                print(f"[{name}] error fetching {asset} from {repo}@{ref}: {e}", file=sys.stderr)
                ok = False
                continue

            if asset:
                # A release asset unpacks to exactly what belongs at the destination. There is no
                # custom_components/<name>/ to descend into, and no `file` to pick out.
                inner = src
                dest = dest_root / name
            elif kind == "component":
                # The component's code lives at custom_components/<name>/ inside the repo.
                inner = src / "custom_components" / name
                if not inner.is_dir():
                    # Some repos nest differently — locate any custom_components/<name>/.
                    found = next((p for p in src.rglob(f"custom_components/{name}") if p.is_dir()), None)
                    if found is None:
                        print(f"[{name}] error: custom_components/{name}/ not found in {repo}@{ref}", file=sys.stderr)
                        ok = False
                        continue
                    inner = found
                dest = dest_root / name
            else:
                inner = src / rel
                if not inner.is_file():
                    # Upstreams move their packages around; fall back to a basename search.
                    found = next((p for p in src.rglob(Path(rel).name) if p.is_file()), None)
                    if found is None:
                        print(f"[{name}] error: {rel} not found in {repo}@{ref}", file=sys.stderr)
                        ok = False
                        continue
                    inner = found
                dest = dest_root / Path(rel).name

            verdict, summary = _diff_summary(dest, inner)
            print(f"[{name}] {repo}@{ref} -> {dest}")
            print(f"    {summary}")

            if args.dry_run:
                print("    dry-run: nothing written")
                continue
            # A non-empty diff means the deployed copy is not this pin. Overwriting it
            # destroys whatever that difference was — local patches, a different upstream,
            # a half-version. Refuse and make the operator say so out loud.
            if verdict == "changed" and not args.force:
                print(f"[{name}] refusing to overwrite: the deployed copy differs from {ref}. "
                      f"Resolve the divergence, or re-run with --force if the pin is right.",
                      file=sys.stderr)
                ok = False
                continue

            try:
                _swap_in(inner, dest)
            except OSError as e:
                print(f"[{name}] error installing into {dest}: {e}", file=sys.stderr)
                ok = False
                continue
            print("    vendored" + (" (forced over a diff)" if verdict == "changed" else ""))

    print("\nNothing is fetched at HA runtime — this is the build-time vendor step. "
          "Review the diff, then commit snapshot + lockfile.")
    return 0 if ok else 1


# ── static doctor ────────────────────────────────────────────────────────────
def collect_tokens(caps: Path) -> dict[str, list[str]]:
    """Map each (kind,name) token -> the template files that use it, scanning header-stripped
    bodies only (so the legend's meta `%%NAME%%` is correctly ignored)."""
    used: dict[str, list[str]] = {}
    for tmpl in sorted((caps / "automations").glob("*.yaml.tmpl")):
        _, body = strip_header(tmpl.read_text(encoding="utf-8"))
        for kind, name in TOKEN_RE.findall(body):
            key = f"{kind + ':' if kind else ''}{name}"
            used.setdefault(key, [])
            if tmpl.name not in used[key]:
                used[key].append(tmpl.name)
    return used


def cmd_doctor(args) -> int:
    caps, vars_path = Path(args.caps), Path(args.vars)

    # 1. vars file parses?
    try:
        vars = load_vars(vars_path)
    except (yaml.YAMLError, MaterializeError) as e:
        print(f"FAIL: vars file does not parse: {e}", file=sys.stderr)
        return 1
    print(f"ok: vars file parses ({len(vars)} keys) — {vars_path}")

    used = collect_tokens(caps)

    # 2. every used token has a matching var (via its source key).
    missing = []
    for token, files in sorted(used.items()):
        name = token.split(":", 1)[-1]
        if source_var(name) not in vars:
            missing.append((token, files))
    if missing:
        print("FAIL: tokens with no matching var:")
        for token, files in missing:
            print(f"  %%{token}%%  (used in: {', '.join(files)})")
    else:
        print(f"ok: all {len(used)} distinct tokens resolve to a var")

    # 3. every var is used by some token (orphans are warnings, not failures).
    used_sources = {source_var(t.split(':', 1)[-1]) for t in used}
    orphans = sorted(k for k in vars if k not in used_sources)
    if orphans:
        print("warning: vars never referenced by any template (orphans):")
        for k in orphans:
            print(f"  {k}")
    else:
        print(f"ok: every var is referenced by a template ({len(vars)} vars)")

    return 1 if missing else 0


# ── CLI ──────────────────────────────────────────────────────────────────────
def main() -> int:
    p = argparse.ArgumentParser(
        prog="homectl",
        description="Materialize Home Assistant automation templates from an instance var map.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    m = sub.add_parser("materialize", help="fill templates -> deploy-ready automations/*.yaml")
    m.add_argument("--caps", default=str(DEF_CAPS), help=f"capability dir (default: {DEF_CAPS})")
    m.add_argument("--vars", default=str(DEF_VARS), help=f"overlay vars file (default: {DEF_VARS})")
    m.add_argument("--out", default=str(DEF_OUT),
                   help=f"output dir — instance/build, NEVER public Axon (default: {DEF_OUT})")
    m.set_defaults(func=cmd_materialize)

    c = sub.add_parser("components", help="clone + vendor pinned components, YAML packages and dashboard resources (build-time)")
    c.add_argument("--components", default=str(DEF_COMPONENTS), help=f"components.toml (default: {DEF_COMPONENTS})")
    c.add_argument("--dest", default=str(DEF_DEST), help=f"custom_components dir (default: {DEF_DEST})")
    c.add_argument("--packages-dest", default=str(DEF_PACKAGES_DEST),
                   help=f"HA packages dir for kind='package' (default: {DEF_PACKAGES_DEST})")
    c.add_argument("--www-dest", default=str(DEF_WWW_DEST),
                   help=f"www dir for kind='lovelace' (default: {DEF_WWW_DEST})")
    c.add_argument("--only", action="append", metavar="NAME",
                   help="vendor just this entry (repeatable). Default: every entry.")
    c.add_argument("--dry-run", action="store_true",
                   help="report what each entry would change and write nothing")
    c.add_argument("--force", action="store_true",
                   help="vendor even where the deployed copy differs from the pin — this "
                        "destroys the difference, so know what it was first")
    c.set_defaults(func=cmd_components)

    d = sub.add_parser("doctor", help="static token/var coverage check")
    d.add_argument("--caps", default=str(DEF_CAPS), help=f"capability dir (default: {DEF_CAPS})")
    d.add_argument("--vars", default=str(DEF_VARS), help=f"overlay vars file (default: {DEF_VARS})")
    d.set_defaults(func=cmd_doctor)

    args = p.parse_args()
    try:
        return args.func(args)
    except MaterializeError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
