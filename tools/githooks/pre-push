#!/bin/bash
# Scan outgoing commits, then run publication and cheap local CI checks.
set -u

scanner=1
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed — this push was NOT secret-scanned" >&2
  scanner=0
fi

status=0
seen=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case " $seen " in *" $local_sha "*) continue ;; esac
  seen="$seen $local_sha"
  [ "$scanner" -eq 1 ] || continue
  if ! gitleaks git --redact --no-banner --exit-code 1 \
    --log-opts="$local_sha --not --remotes" >&2; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: gitleaks found a secret in a commit being pushed — fix or remove it, then push again" >&2
  exit "$status"
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
[ -n "$seen" ] && [ -x "$repo_root/tools/ci-local" ] || exit 0
# Git's hook environment must not leak into scratch repositories created by checks.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
if ! (cd "$repo_root" && tools/check-publication-hygiene.sh) >&2; then
  echo "pre-push: publication hygiene failed" >&2
  exit 1
fi
if [ "${SJEL_SKIP_PUSH_CHECKS:-}" = 1 ]; then
  echo "pre-push: SJEL_SKIP_PUSH_CHECKS=1 — format and selected gates skipped; tests, clippy and builds remain in CI" >&2
  exit 0
fi
if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is missing — format and selected gates NOT run; publication hygiene still checked" >&2
  exit 0
fi
if ! (cd "$repo_root" && tools/ci-local fast) >&2; then
  echo "pre-push: local checks failed. Fix them, or use SJEL_SKIP_PUSH_CHECKS=1 to skip format and selected gates" >&2
  exit 1
fi
exit 0
