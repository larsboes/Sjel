#!/bin/bash
# pre-push — the secret check and the quick CI subset, run when a push does, not later.
#
# The public repo is covered by GitHub's own push protection (tools/sjel-cli/src/audit.rs states
# that as its reason for scanning the overlay at all), but a PRIVATE repository needs a paid plan
# for it, so nothing stopped a secret from leaving the overlay until tools/host-patch ran its
# daily audit. This is that same gitleaks scan, at the one moment it can still refuse.
#
# Scoped to the outgoing commits (`<sha> --not --remotes`), so it does not re-scan history that
# is already on a remote — the audit's whole-history half stays where it is.
#
# It never blocks on a missing scanner. A push is not the place to install one, and a hook that
# fails closed on a setup problem gets deleted rather than fixed.
#
# Installed by tools/install.sh via `core.hooksPath`, and run by git with the refs being pushed
# on stdin. bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

scanner=1
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed — this push was NOT secret-scanned" >&2
  scanner=0
fi

status=0
seen=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # A deleted ref carries no commits to scan.
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  # Two refs pushed from one commit are one range, and gitleaks is not free.
  case " $seen " in *" $local_sha "*) continue ;; esac
  seen="$seen $local_sha"
  [ "$scanner" -eq 1 ] || continue

  # `--exit-code` takes an INT in gitleaks 8.30.1, so it needs its value: bare, it swallows the
  # next flag and every push fails on the parse rather than on a secret.
  if ! gitleaks git --redact --no-banner --exit-code 1 \
    --log-opts="$local_sha --not --remotes" >&2; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: gitleaks found a secret in a commit being pushed — fix or remove it, then push again" >&2
  exit "$status"
fi

# The quick subset of CI, so a fmt or clippy slip fails here in seconds instead of on main
# minutes later. It checks the working tree, so another session's uncommitted edits can fail
# it; SJEL_SKIP_PUSH_CHECKS=1 skips it for one push. Only a Sjel checkout carries the tool.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
[ -n "$seen" ] && [ -x "$repo_root/tools/ci-local" ] || exit 0
if [ "${SJEL_SKIP_PUSH_CHECKS:-}" = 1 ]; then
  echo "pre-push: SJEL_SKIP_PUSH_CHECKS=1 — local checks skipped, CI still runs them" >&2
  exit 0
fi
if ! command -v bun >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; then
  echo "pre-push: bun or cargo is missing — local checks NOT run" >&2
  exit 0
fi
# Git exports GIT_DIR and its siblings to a hook. Tests that build scratch repositories would
# then act on this one, so the checks run without them.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
if ! (cd "$repo_root" && tools/ci-local fast) >&2; then
  echo "pre-push: local checks failed. Fix them, or push with SJEL_SKIP_PUSH_CHECKS=1 when the failure is not yours" >&2
  exit 1
fi
exit 0
