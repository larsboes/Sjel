{
  "name": "sjel-catalog-adapter-evaluation",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "../node_modules/.bin/svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test --preload ./integration.cases.ts client-state.test.ts",
    "build": "../node_modules/.bin/vite build --config vite.config.ts",
    "build:ssr": "../node_modules/.bin/vite build --config vite.config.ts --mode server-test",
