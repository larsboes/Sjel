#!/bin/bash
# tools/toolchain-check — is every host tool Sjel needs actually installed?
#
# Launcher only. The logic moved to tools/sjel-cli/src/toolchain.rs on 2026-10-02; this path
# stays so tools/install.sh, tools/doctor and tools/toolchain-scope.test.sh keep calling it
# unchanged. `tools/toolchain-check -h` prints the usage.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"       # SJEL_ROOT, SJEL_MACHINE_TOML, SJEL_*CAPS_DIR
# shellcheck source=tools/lib/sjel-cli.sh
. "$_here/lib/sjel-cli.sh"
sjel_cli_exec toolchain-check "$@"
