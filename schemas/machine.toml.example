# Shape of <overlay>/config/machine.toml — everything true of ONE deployment instance.
# Written by tools/install.sh, then maintained by tools/capability.sh (the capabilities
# line) and by hand (state mounts). Read by tools/lib/platform.sh, tools/capability.sh,
# tools/service-runner.sh, tools/update.sh and tools/doctor.
#
# Why it lives in the overlay and not in axon.toml: axon.toml is tracked and shared, so a
# field that differs between two machines cannot live there — one overlay is one instance,
# so this file has exactly one machine to describe. See
# the header above.
#
# Parsing contract: the scalars and the capabilities array go through tools/lib/toml.sh,
# which is single-line only (`key = "value"` / `key = ["a", "b"]`). The [[state_mount]]
# array-of-tables is beyond that parser on purpose and is read by tools/doctor via Bun.TOML
# — which is why doctor is TypeScript (CONTRIBUTING.md#cargo-and-bun-are-the-build-path).

# THIS FILE IS THE ONLY COPY. An overlay does not carry its own machine.toml.example:
# tools/install.sh writes a real machine.toml from the values it detects, and every overlay
# already commits that real file, so an example beside it is a second thing to update and
# the first to rot. Three such copies existed until 2026-08-04 and had already drifted —
# not in structure, only in which OS each one happened to name. tools/doctor now reports an
# overlay that grows one back.
#
# Pick the pair that matches the host; both are shown so nobody has to fork this file to
# describe their own machine.

# --- platform (required) --------------------------------------------------
# tools/lib/platform.sh reads these so capability scripts branch on them instead of
# assuming macOS.
#
#   macOS workstation:  os = "macos"    container_runtime = "docker"
#   Linux server:       os = "linux"    container_runtime = "docker"
#
# The two fields are independent and neither is inferred from the other; platform.sh reads each
# separately. Which daemon supplies the docker CLI is a further machine fact this file does not
# record — OrbStack, Docker Desktop, colima and a Linux daemon all answer to `docker`.
# `apple-container` was a third legal value until 2026-09-02, when Q75 retired it;
# upstreams.toml [apple-container] holds the dated verdict.
os = "linux"                       # "macos" | "linux" | "windows"
container_runtime = "docker"       # "docker" | "podman"

# --- enabled capabilities (required, may be empty) -----------------------
# Managed by tools/capability.sh enable/disable, which resolve each capability's
# service.toml `requires = [...]` transitively. Hand-editing is legal; tools/doctor
# re-checks that every name has a capabilities/<name>/ dir and that the set stays
# dependency-closed. Single line, per the toml.sh contract above.
capabilities = ["home-assistant", "vaultwarden"]

# Rejected alternative: tagging each [[state_mount]] with an owning machine
# (machines = ["mac"]) and leaving everything in axon.toml. Smaller diff, but it keeps every
# machine's facts in one shared file and makes each node's config grow with the node count —
# accumulating blocks that are inert everywhere except one place. And `capabilities` has no
# sensible per-machine encoding that way at all.

# --- local model runtime (optional) --------------------------------------
# Which inference backend this machine actually has. Read by tools/service-runner.sh, which
# exports it as SJEL_INFERENCE_BACKEND for every process it starts; libs/inference reads that
# and resolves roles against it.
#
# The value is a backend id from <overlay>/config/inference.json, never a URL — the address
# already has a home there (schema: libs/inference/inference.config.example.json). Absent
# section or absent key = each role keeps the backend it declares, which is the right answer
# for the machine the shared inference.json was written for.
#
# It moves a role only when BOTH hold, and each condition is a defect it prevents:
#   * the role's declared backend is loopback — a hosted provider answers from every machine,
#     so a reviewed cloud_* role is never dragged onto whatever this host runs;
#   * the role names a model for this backend under `on_backend` — a backend id on its own
#     would ask Ollama for an oMLX model name. A role that names none is simply unavailable
#     here, and consumers already degrade from that (scouting falls back to hash embedding).
#
# [inference]
# backend = "ollama"    # e.g. an Intel or Raspberry Pi host: no Metal, so no oMLX

# --- per-capability overrides (optional) ---------------------------------
# A capability's service.toml is tracked and shared, so it can only hold fields that are
# true of the capability everywhere. The ones that are not — where it binds, and where its
# backups go — are stated here per machine, and only the machine that differs states them.
# Absent section or absent key = the service.toml value stands.
#   ports         = [...]   read by tools/service-runner.sh, replaces the manifest array (containers)
#   port          = "n"     read by tools/service-runner.sh for kind=process, exported as SJEL_PORT
#   backup_target = "id"    read by tools/backup.sh, a systems.toml id
#   env           = [...]   read by tools/service-runner.sh, injected into this capability's
#                           boot-persistence unit (launchd plist / systemd unit) alongside PATH
#   provided_by   = "id"    read by tools/lib/external-ref.sh — see the section below. Not an
#                           override of a manifest field, but a statement that the manifest
#                           describes a deployment this machine does not own.
#
# [capability.vaultwarden]
# ports = ["127.0.0.1:8080:80"]   # localhost only; `tailscale serve` terminates TLS
# backup_target = "some-nas"      # a systems.toml id, and never this machine itself
#
# --- externally provided capabilities (optional) --------------------------
# `provided_by` says this machine CONSUMES a capability that another, independently managed
# overlay runs on another host (retired-tracker#169). `capabilities` above stays the answer to
# "what does this machine run", and a name must never appear in both — doctor reports that as
# an error, because a local copy held up by the runner while every client dials the remote one
# is two instances diverging in silence, each perfectly healthy on its own.
#
# The value is an id with a `url` in the overlay's config/systems.local.toml, not a URL. The
# address already has a home there, and the indirection carries provenance: the id names WHO
# provides it, and is free to differ from the capability name.
#
#   [capability.vaultwarden]
#   provided_by = "family-vault"
#
#   # ...and in config/systems.local.toml:
#   [family-vault]
#   url = "https://vault.example.ts.net"
#
# What that buys, and what it deliberately does not:
#   * `tools/capability.sh registry` emits the capability with scope = "external" and a resolved
#     `endpoint`, so no consumer works the address out for itself. Every other manifest field is
#     BLANKED there — a manifest describes how its OWNER runs the service, and projecting
#     `autostart` or `backup_target` onto a client would claim authority it does not have.
#   * sjel-status polls its health at that endpoint and reports it, read-only.
#   * `service-runner.sh`, `backup.sh` and sjel-status's start/stop REFUSE it by name.
#     Independently managed overlays stay separate operational authorities: lifecycle, secrets
#     and backups belong to whoever owns the host.
#   * an id that resolves to nothing is an error everywhere, never a quiet fall back to loopback
#     — which for a vault client means dialling whatever happens to answer on this machine.
#
# `env` exists because a supervisor unit could carry exactly one variable, PATH, so the only way
# to give a capability another was to hand-edit the GENERATED unit — which `service-runner.sh
# persistence-status` then reports as `stale` forever and `install-persistence` silently deletes.
# Declaring it here makes the value part of the declaration, so re-installing is lossless.
#
# NOT for secrets. A unit file sits unencrypted in the operator's home and is read by a supervisor
# that logs; a credential belongs in the capability's env_file, which comes from Vaultwarden
# (CONTRIBUTING.md#secrets).
#
# [capability.dashboard]
# env = ["__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=this-host.example.ts.net"]
#   # Vite rejects a request whose Host header it does not know, and a tailnet name is exactly
#   # such a host — machine-local by nature, so it cannot live in the tracked service.toml.

# --- state mounts (optional, repeatable) ---------------------------------
# Where a tool on this machine actually persists data. Axon records the tool's own default
# location, it never relocates it (CONTRIBUTING.md#state-mounts-record-reality).
# `tool` must match a systems.toml id, or doctor reports an undeclared system.
#   data_class = "public" | "personal" | "vault"
#   sync       = "git" | "restic" | "rsync" | "none"
#   direction  = "capture" (tool -> overlay backup) | "inject" (overlay -> tool) | "both"
#   monitor    = true | false

[[state_mount]]
tool = "some-tool"
path = "~/some/dir"
data_class = "personal"
sync = "none"
direction = "both"
monitor = true
