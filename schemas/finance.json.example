{
  "_note": "Private overlay template for <overlay>/config/finance.json. Replace placeholders locally. Public code never names an institution, account identifier or personal figure.",
  "obsidian": {
    "root": "<knowledge-base-root>"
  },
  "journal": "<finance-journal-path>",
  "investment_snapshot": "<finance-investment-snapshot-path>",
  "balance_snapshot": "<finance-balance-snapshot-path>",
  "csv_mappings": [
    {
      "label": "Synthetic semicolon export",
      "mapping": {
        "delimiter": ";",
        "decimal_separator": ",",
        "date_column": "Date",
        "amount_column": "Amount",
        "description_column": "Description",
        "categorization_columns": ["Statement label"],
        "reference_column": "Reference",
        "currency_column": "Currency",
        "default_currency": "EUR",
        "source_account": "assets:bank:checking",
        "default_outflow_account": "expenses:uncategorized",
        "default_inflow_account": "review:credit-or-refund",
        "categorization_rules": [
          {
            "description_contains_any": [],
            "description_starts_with_any": ["Synthetic settlement"],
            "field_equals_any": [],
            "direction": "inflow",
            "account": "assets:bank:checking",
            "confidence_basis_points": 10000
          },
          {
            "description_contains_any": ["Synthetic software"],
            "description_starts_with_any": [],
            "field_equals_any": [
              {"column": "Entry type", "values": ["PURCHASE"]}
            ],
            "direction": "outflow",
            "account": "expenses:software",
            "confidence_basis_points": 9500
          }
        ],
        "row_filter": {
          "column": "Entry type",
          "include_values": ["PURCHASE", "REFUND"]
        },
        "amount_sign": "as_provided",
        "amount_rounding": "reject",
        "date_formats": ["iso_year_month_day", "day_month_year_dots"],
        "row_policy": "strict"
      }
    }
  ],
  "investment_csv_mappings": [
    {
      "source_key": "synthetic-broker",
      "label": "Synthetic investment activity",
      "mapping": {
        "delimiter": ";",
        "decimal_separator": ",",
        "date_column": "Date",
        "instrument_column": "Instrument",
        "quantity_column": "Quantity",
        "activity_type_column": "Type",
        "position_activity_values": ["BUY", "SELL"],
        "non_position_activity_values": ["DIVIDEND"],
        "reference_column": "Reference",
        "price_column": "Price",
        "currency_column": "Currency",
        "default_currency": "EUR",
        "instrument_aliases": {
          "synthetic-source-id": "ACME"
        }
      }
    }
  ],
  "instruments": [
    {
      "instrument": "SYNTH-WORLD",
      "label": "Synthetic world equity",
      "asset_class": "equity",
      "ticker": "SYNTH"
    }
  ],
  "targets": {
    "currency": "EUR",
    "contribution_floor_cents": 25000,
    "price_freshness_days": 4,
    "risk_free_rate_bp": null,
    "allocations": [
      {
        "id": "synthetic-equity-world",
        "label": "Synthetic world equity",
        "scope": "asset_class",
        "instrument": null,
        "asset_class": "equity",
        "target_bp": 7000,
        "band_bp": 500,
        "rationale": "Synthetic rationale, one sentence.",
        "valid_from": "2026-09-01",
        "valid_until": null
      },
      {
        "id": "synthetic-bonds",
        "label": "Synthetic bonds",
        "scope": "asset_class",
        "instrument": null,
        "asset_class": "bond",
        "target_bp": 3000,
        "band_bp": 500,
        "rationale": "Synthetic rationale, one sentence.",
        "valid_from": "2026-09-01",
        "valid_until": null
      }
    ]
  },
  "comms_base_url": "http://127.0.0.1:8083",
  "commitments": [
    {
      "id": "synthetic-rent",
      "label": "Synthetic rent",
      "account": "expenses:housing:rent",
      "monthly_cents": 75000,
      "currency": "EUR",
      "valid_from": "2026-09-01",
      "valid_until": null
    }
  ],
  "planning": {
    "baseline_months": 3,
    "runway_target_months": 6,
    "journal_freshness_days": 45,
    "snapshot_freshness_days": 14,
    "source_expectations": [
      {
        "kind": "transactions",
        "id": "synthetic-card-feed",
        "label": "Synthetic card transactions",
        "account_prefixes": ["liabilities:card:synthetic"],
        "freshness_days": 45,
        "coverage": "complete"
      },
      {
        "kind": "holdings",
        "id": "synthetic-broker-feed",
        "label": "Synthetic broker holdings",
        "source_key": "synthetic-broker",
        "freshness_days": 14,
        "coverage": "partial"
      }
    ],
    "spending_rules": [
      {"account_prefix": "expenses:housing", "behavior": "fixed"},
      {"account_prefix": "expenses:food:groceries", "behavior": "variable"},
      {"account_prefix": "expenses:leisure", "behavior": "discretionary"}
    ],
    "subscription_account_prefixes": ["expenses:software:subscriptions"],
    "include_subscription_burn": true,
    "forecast_adjustments": [
      {
        "id": "synthetic-commute-change",
        "label": "Synthetic commute change",
        "monthly_cents": 5000,
        "currency": "EUR",
        "valid_from": "2026-09-01",
        "valid_until": null
      }
    ],
    "comparison_dates": ["2026-09-01"],
    "card_decision": {
      "annual_eligible_spend_cents": 1200000,
      "annual_fx_spend_cents": 100000,
      "usage_reviewed": false,
      "eligible_account_prefixes": ["liabilities:card:synthetic"],
      "ineligible_category_prefixes": [],
      "options": [
        {
          "id": "synthetic-card",
          "label": "Synthetic card",
          "annual_fee_cents": 60000,
          "currency": "EUR",
          "points_per_currency_unit_milli": 1000,
          "point_value_milli_cents": 500,
          "point_value_assumption": "Synthetic half-cent value per point",
          "fx_fee_basis_points": 200,
          "benefits": [
            {
              "id": "synthetic-credit",
              "label": "Synthetic annual credit",
              "annual_face_value_cents": 30000,
              "annual_personal_value_cents": 15000
            }
          ],
          "terms_checked_on": "2026-08-11",
          "source_urls": ["https://example.com/synthetic-card-terms"]
        }
      ]
    },
    "loyalty_balances": [
      {
        "id": "synthetic-points",
        "label": "Synthetic points",
        "points": 10000,
        "point_value_milli_cents": 500,
        "transferable": true,
        "assumption": "Synthetic valuation for schema documentation",
        "as_of": "2026-08-11",
        "expires_on": null,
        "transfer_path": "Synthetic points to synthetic miles",
        "source_urls": ["https://example.com/synthetic-points-terms"]
      }
    ]
  },
  "_commitment_note": "Commitments are forward-looking dated obligations, not historical transactions. All real labels, dates and amounts belong only in the private overlay.",
  "_planning_note": "Planning rules, comparison dates, card usage, personal benefit values, point balances and valuation assumptions are private. Public Sjel contains only the provider-neutral arithmetic and this synthetic shape.",
  "_mapping_note": "Only synthetic profiles belong in Sjel. Real source keys, profile labels, column mappings, instrument aliases and symbolic source accounts stay in the private overlay."
}
