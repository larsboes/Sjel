# Shape of a capabilities/<name>/service.toml, consumed by
# tools/service-runner.sh. This file IS the schema (single-line TOML only,
# see tools/lib/toml.sh) — copy it into a capability dir, fill it in, and
# that capability is fully OS/runtime-portable with zero new shell code.
#
# THREE KINDS, one manifest shape. `kind` selects which part of this file applies:
#
#   kind = "container"  (the default when the field is absent) — everything from
#                       `image` down to `backup_*`. The runtime runs it.
#   kind = "process"    — a host process this machine runs directly: a compiled
#                       binary, a dev server. See the "Process kind" section at the
#                       bottom. Nothing containerised, no image, no tag.
#   kind = "data"       — state with no process: a file this machine owns, declared
#                       so that exactly one manifest says how it is backed up. Only
#                       `name` and the `backup_*` fields apply; every lifecycle verb
#                       refuses it by name. See the "Data kind" section at the bottom.
#
# A spine component (today only dashboard/, CONTRIBUTING.md#three-architectural-nouns) may carry a service.toml
# at the repo root instead of under capabilities/ — same schema, always in the
# registry because the spine exists on every machine by definition.

# kind   = "process"                      # omit for a container

name     = "example"                      # container name, must be unique on the machine
image    = "someorg/example"              # image repo, no tag. A registry prefix is ALLOWED and
                                          # respected — "ghcr.io/org/thing", "localhost/mine".
                                          # Bare names resolve on Docker Hub. (Before 2026-07-26
                                          # the runner prefixed docker.io/ unconditionally, so a
                                          # ghcr reference silently became docker.io/ghcr.io/…;
                                          # see service-runner.sh's qualified_image.)
tag      = "stable"                       # REQUIRED, and it names a CHANNEL, not a version
                                          # (Q77, 2026-09-02). Prefer the publisher's own
                                          # rolling tag — "stable", "latest", "alpine" — so the
                                          # capability takes each upstream release the day it
                                          # exists. capabilities/container-refresh pulls every
                                          # declared image daily and recreates the container when
                                          # the digest moves.
                                          #
                                          # A version literal was the rule until Q77 and was
                                          # never a byte pin either: publishers rebuild under the
                                          # same tag. So the declared tag has never answered "what
                                          # is running" — ask the runtime for the digest instead
                                          # (`docker inspect <name> --format '{{.Image}}'`, ISA.md
                                          # C4). Write a literal only when an upstream publishes
                                          # no rolling tag, and say in a comment why.

# Optional — runtime dependencies on OTHER capabilities, by directory name.
# The dependency is on the capability's CONTRACT (HTTP surface + schema), never its
# code (CONTRIBUTING.md#schemas-and-dependency-direction). tools/capability.sh resolves this transitively on enable;
# tools/check-manifest-integrity.sh proves every target exists. NB: bare array line,
# no inline comment (toml_array contract).
# requires = ["postgres"]

# Optional — the capability's dashboard panel (shell model, CONTRIBUTING.md#three-architectural-nouns).
# The spine's dashboard/ discovers enabled capabilities via <overlay>/config/machine.toml
# and mounts
# each panel from the capability's own HTTP surface: http://127.0.0.1:<panel_port><panel_path>.
# panel_port is the HOST-published port (the host side of `ports` above), NOT the
# container-internal one — the dashboard dials the host. One panel per capability
# (scalar fields — deliberate doctrine, see tools/capability.sh/).
# A capability without these fields simply has no panel. Flat fields, not a [panel]
# section — single-line toml.sh contract.
# panel_port = "8080"
# panel_path = "/ui"
ports    = ["127.0.0.1:8080:80"]          # [host-ip:]host-port:container-port, repeatable
volumes  = ["data/example/data:/data"]    # host side is relative to the overlay root — EXCEPT an
                                          # absolute path, which is taken verbatim as a system path
                                          # the machine owns rather than the overlay ("/run/dbus:/run/dbus"
                                          # for a container needing the host message bus, "/etc/localtime:/etc/localtime").
                                          # Overlay-relative dirs are created on start; an absolute one
                                          # never is — if it is missing the host is not what the manifest
                                          # assumed, and a fabricated empty dir would mount fine and quietly
                                          # take the feature with it.
# Track non-secret defaults in `config/example.env.example` (tracked in this repo)
# and keep real runtime values in the selected overlay's .env file (private by
# convention). This split keeps capabilities reproducible without storing secrets.
env_file = "config/example.env"           # relative to the selected overlay; real values live there, never here

# Optional — host networking. When set (e.g. "host") the container joins the host network
# namespace instead of a bridge, and `ports` are NOT published (host mode binds the
# container's own ports directly). Required by capabilities needing LAN mDNS/service
# discovery — e.g. home-assistant finding Hue/Shelly/ESPHome. Omit for normal bridged
# capabilities. Honored on docker and podman, the two runtimes service-runner.sh accepts.
# network_mode = "host"

# Optional — Linux capabilities to grant beyond the runtime's default set, for an image
# that genuinely needs one (pihole's FTLDNS binds :53 and manages its own interface, so it
# needs NET_ADMIN). Bare names, no CAP_ prefix — docker's canonical form, which podman
# takes too. Grant the single capability the image
# documents; --privileged is not expressible here on purpose. NB: bare array line, no
# inline comment (toml_array contract).
# cap_add = ["NET_ADMIN"]

# `managed_volume = "true"` stood here until 2026-09-02, when Q75 retired it with
# apple-container. It existed for exactly one runtime property — apple-container's virtiofs
# bind mounts refused guest-side chown/chmod — and docker and podman share the host filesystem
# with real Unix ownership, so the field had nothing left to do. No manifest had declared it
# since capabilities/postgres retired (2026-08-27, PRD Q45). service-runner.sh deleted the
# PARSE along with the branch: a field read and then ignored would silently change where a
# capability's data lands.

# Optional — only if this capability is backed up by tools/backup.sh.
# Each completed archive embeds `axon-backup.toml` with this historical contract plus
# the pinned image identity. tools/restore.sh verifies that identity and restores only
# into an isolated destination; the active overlay is never a valid restore target.
# Overlay-relative host paths. A directory is copied by contents; a single FILE is
# copied as itself, which capabilities/finance needs — its canonical truth is one
# journal directory plus config/finance.json and a reviewed-holdings snapshot, and
# neither file has a directory of its own that would not also drag in every other
# capability's configuration.
# NB: no inline comment on the array line (toml_array wants it bare).
backup_paths  = ["data/example/data", "config/example.json"]
backup_sqlite = "data/example/data/db.sqlite3"  # a SQLite DB owned by the container: backup.sh holds the capability down and copies it COLD.
                                          # Never opened from the host while the container runs — SQLite's WAL needs every
                                          # connection on one host, and a virtiofs bind mount is not that (2026-07-25 outage).
# backup_sqlite_online = "data/axon/axon.db"
                                          # the same file copied OPEN, with `sqlite3 .backup`, and no service hold. Use this
                                          # one only when the readers are host processes on this machine — then every
                                          # connection IS on one host and the rule above is satisfied. capabilities/store
                                          # declares it because nine capabilities read that file at once: stopping all of
                                          # them to take a cold copy is an outage, not a backup. Mutually exclusive with
                                          # backup_sqlite; a UI reads which one is declared to say whether a run stops
                                          # anything.
backup_target = "backup-target"           # a generic systems.toml role; host/ssh_user/backup_root live in overlay systems.local.toml
backup_retain = "14"                      # keep the last N tarballs on the target (default 14)
# backup_container_paths = ["/config"]    # paths read from INSIDE the container, for data the invoking
                                          # user cannot read from the host. home-assistant runs as root and
                                          # owns .storage that way (auth store, user database), so a
                                          # host-side rsync fails on exactly the files that matter. Staged
                                          # as a tar rather than extracted, so ownership and modes survive:
                                          # restoring a root-owned auth store as the invoking user is the
                                          # kind of damage that only shows up during a restore. Container
                                          # paths, not overlay-relative ones. NB: bare array line.
                                          # (There was a `backup_pg_dumpall` here until PRD Q45 retired Postgres on
                                          # 2026-08-27. It ran pg_dumpall inside the container because a live cluster
                                          # cannot be raw-copied and its data dir was a managed volume with no host
                                          # path. Both reasons died with the capability that had them.)
backup_advise_days = "1"                  # how often this capability's data SHOULD be backed up.
backup_stale_days  = "7"                  # past this age the last backup counts as overdue, not merely due.
                                          # Two numbers because "you could" and "you have a problem" are
                                          # different answers, and a capability whose data changes hourly and
                                          # one that changes monthly do not share either. Read from the receipt
                                          # backup.sh writes (overlay backup/receipts/<cap>.json) to decide what
                                          # a surface shows. Declared ahead of any consumer on purpose, and
                                          # that is still half true: the dashboard has no backup trigger yet.
                                          # The scheduler this comment once called nonexistent now exists —
                                          # see `schedule` below — so a capability wanting an unattended
                                          # backup run declares it there, and these two fields stay what they
                                          # always were: what timely MEANS, not what runs. No default — a
                                          # capability that
                                          # declares a backup but no cadence is only ever reported as "last run
                                          # <age>", never as overdue, because nothing said what timely means.

freshness_advise_hours = "12"             # how often data SHOULD reach this capability.
freshness_stale_hours  = "24"             # past this age nothing is arriving, and that is a fault.
                                          # The same two-number shape as the backup pair above, and the same
                                          # reasoning: `stale` is not "a bit more than advise", it is the age
                                          # only reachable when the thing that should be feeding this is not
                                          # running. A 6h collector reaches 12h by missing two passes and 24h
                                          # by missing four.
                                          #
                                          # A capability that declares these serves `GET /__axon/freshness`
                                          # answering `{"last_arrival_at": <epoch seconds>}`, or `null` if
                                          # nothing ever arrived. sjel-status polls it; tools/doctor reports it.
                                          # The path is a convention, not a field, so one shape works for every
                                          # capability -- same namespace as ytalbum's `/__axon/idle`. It answers
                                          # before the inbound gate (libs/sjel-server/src/auth.rs), because one
                                          # integer about WHEN is liveness-shaped and a status page must not
                                          # need every capability's credential to draw itself.
                                          #
                                          # ARRIVAL, never the newest row. A source that publishes nothing for a
                                          # week is quiet, not broken; a contract keyed on the newest item would
                                          # call that a fault and teach the reader to skim. What this exists to
                                          # catch is a producer that stopped -- PRD D13, after nine days of an
                                          # empty Inbox passed with every check on the machine green.
                                          #
                                          # No default. A capability that declares neither is never reported as
                                          # stale, exactly as with the backup pair: nothing said what timely
                                          # means, so nothing may claim it was missed.

# ── Process kind ───────────────────────────────────────────────────────────
# Everything below applies ONLY to kind = "process". A process manifest declares
# none of the container fields above — the schema gate rejects a manifest carrying
# both, because "which half is real" must never be a guess.
#
# kind        = "process"
# command     = ["target/release/example-server"]
#                                           # argv ARRAY, never a shell string: the runner execs it
#                                           # directly, so nothing is word-split, glob-expanded or
#                                           # eval'd. Same reason comms shells out to yt-dlp with
#                                           # argument arrays only. A relative path resolves against
#                                           # the checkout the manifest came from, so a Rust
#                                           # capability names the workspace target dir the root
#                                           # Cargo.toml gives every member: target/release/<bin>.
# build       = ["cargo", "build", "--locked", "--release", "--bin", "example-server"]
#                                           # optional. Run when the artifact does not exist yet
#                                           # (first start after a clone), and unconditionally on
#                                           # `restart`. Runs IN `workdir` when one is declared, at
#                                           # the repo root otherwise — `bun run build` has to run
#                                           # where the package.json is, and cargo has to run where
#                                           # the workspace is. Nothing to compile: omit.
#                                           # --locked, so a start can never silently resolve a
#                                           # dependency version the lockfile does not name.
# panel_build = ["bun", "run", "build"]
#                                           # optional, and only for a capability that ships its own
#                                           # UI. Runs in <capability>/ui/ — fixed by
#                                           # CONTRIBUTING.md#placement-guide, so it is not a manifest
#                                           # fact — immediately BEFORE `build`, on the same
#                                           # trigger. Assumes ui/node_modules is installed; that
#                                           # install is an operator step (the capability's README),
#                                           # never a start-time one.
# build_output = "capabilities/example/ui/dist"
#                                           # optional, repo-relative — what `build` produces, and
#                                           # therefore how "already built" is decided. REQUIRED
#                                           # whenever command[0] is a bare interpreter (bun, uv):
#                                           # without it the runner tests command[0] for existence,
#                                           # a bare name on PATH always exists, and the declared
#                                           # build silently never runs. Omit when command[0] IS the
#                                           # built artifact (every Rust capability).
# workdir     = "capabilities/example"      # optional, relative to SJEL_ROOT; default the repo root
# port        = "8085"                      # the host port it listens on — one per process capability.
#                                           # Exported to the process as SJEL_PORT, so a capability that
#                                           # honours it binds exactly what the registry advertises and
#                                           # a machine-local override needs no second edit inside the
#                                           # capability's own config.
# health_path = "/health"                   # optional; the runner polls http://127.0.0.1:<port><path>
#                                           # to decide when a start actually succeeded, instead of
#                                           # trusting that a spawned pid means a listening server.
#                                           # LIVENESS: is the process there. Answer it without
#                                           # touching a dependency, or a start never completes.
# ready_path  = "/ready"                    # optional; READINESS: can it actually serve. Declare it
#                                           # when the capability needs something it does not control
#                                           # — a database, an external API — and answer it by
#                                           # touching that thing. sjel-status judges availability on
#                                           # this where it exists and falls back to health_path
#                                           # where it does not, so adding one changes what the
#                                           # dashboard reports and omitting one changes nothing.
#                                           # Not polled by the runner at startup: a capability that
#                                           # starts before its database is still a successful start.
# autostart   = "true"                      # optional. `service-runner.sh up` starts it; without it
#                                           # the capability is on-demand — dashboard starts it when
#                                           # you open its surface. Default: on-demand.
# full_disk_access = "true"                 # optional, macOS only. A scheduled run starts through
#                                           # the signed axon-fda-launcher, which holds Full Disk
#                                           # Access, instead of as /bin/bash. For a job that reads
#                                           # another app's iCloud container or lists iCloud Drive.
#                                           # Install: tools/fda-launcher/install.
# schedule    = "6h"                        # optional. Run this capability every N and let it EXIT —
#                                           # a collector sweep, a gate, anything periodic. Accepts
#                                           # <N>m, <N>h, <N>d and nothing else; not a cron
#                                           # expression, because both backends want a duration
#                                           # anyway (launchd StartInterval is seconds, systemd
#                                           # OnUnitActiveSec is a time span) and a second scheduling
#                                           # language in a manifest is a language to translate out
#                                           # of. `install-persistence` renders a launchd agent with
#                                           # StartInterval on macOS and a systemd --user timer plus
#                                           # its oneshot on Linux. The first run comes ~1min after
#                                           # boot rather than a whole interval later, and
#                                           # re-installing triggers a run.
#                                           #
#                                           # MUTUALLY EXCLUSIVE with autostart, and refused rather
#                                           # than resolved: a watchdog holds the process up
#                                           # continuously, which leaves an interval nothing to
#                                           # start. autostart = a service, schedule = a job.
#                                           #
#                                           # Declared in Axon because "every 6h" is a property of
#                                           # the capability. WHETHER it runs stays a per-machine
#                                           # fact in the overlay's enabled set, so a laptop can
#                                           # carry the declaration switched off while a homeserver
#                                           # runs it.
#
# Dashboard wiring (read by dashboard/vite.config.ts through the registry, so a port
# literal lives in exactly one file):
# proxy_extra = ["/api"]                    # optional. Extra browser-facing prefixes proxied to this
#                                           # capability UNSTRIPPED, for surfaces whose paths predate
#                                           # the uniform rule. Every process capability always gets
#                                           # /<name> proxied with the prefix stripped — that one is
#                                           # convention, not configuration, and needs no field.
# routes_absent = "upstream binary"         # optional, a reason. A process with a port serves
#                                           # GET /routes (libs/route-manifest, ISA ISC-34), or says
#                                           # here why it cannot: an upstream binary, a UI with no
#                                           # API of its own. tools/check-service-tomls.sh refuses a
#                                           # port with neither.
# proxy_api_only = "true"                   # optional. When the dashboard owns /<name> as a page,
#                                           # proxy only /<name>/api and still strip /<name>.
# panel_port  = "4242"                      # a capability that serves its OWN UI (CONTRIBUTING.md#three-architectural-nouns); the shell
# panel_path  = "/"                         # mounts it. Omit when the dashboard renders the widget.
# idle_timeout = "300"                      # optional, seconds. Stop this panel once nobody has looked
#                                           # at it for that long; sjel-status polls
#                                           # http://127.0.0.1:<panel_port>/__axon/idle and stops it via
#                                           # `service-runner.sh idle-stop` (no maintenance hold, so
#                                           # anything may start it again). A panel served by
#                                           # tools/panel-server.ts answers that endpoint and injects
#                                           # the visibility heartbeat that feeds it; one served by
#                                           # anything else never reports idle and is therefore never
#                                           # stopped — unreadable means in use, never "kill it".
#                                           # Ignored without panel_port, and on autostart capabilities:
#                                           # a capability the machine is meant to keep running is not
#                                           # idle by definition. NB: a window sitting behind another
#                                           # window reports hidden, so it counts as unread.

# ── Data kind ──────────────────────────────────────────────────────────────
# Everything below applies ONLY to kind = "data". The manifest declares state and
# nothing else: `name`, the `backup_*` contract, and no field a lifecycle verb would
# read. The schema gate rejects `image`, `tag`, `volumes`, `env_file`, `command`,
# `port`, `autostart` and `schedule` here, because nothing starts a file.
#
# It exists so that a file with several readers still has exactly ONE owner for the
# one question a file's owner has to answer: how is it backed up. capabilities/store
# is the case that created the kind — the shared SQLite database that replaced the
# Postgres container (PRD Q45, 2026-08-27) is read by nine capabilities, so no single
# capability could carry its contract without claiming the other eight's data.
#
# kind  = "data"
# name  = "store"
# backup_sqlite_online = "data/axon/axon.db"
# backup_target        = "backup-target"
# backup_advise_days   = "1"
# backup_stale_days    = "7"
#
# In the registry it appears like any other row, so a backup surface finds it without
# a second source. `tools/service-runner.sh` refuses start/stop/restart/status by name,
# answers `persistence-status` with `n/a`, and the whole-machine fan-out skips it.

# tools/service-runner.sh:
#   start <name>               -> container: dispatches by machine.toml's container_runtime
#                                  (docker | podman). process: execs `command`
#                                  and waits for health. Either way a no-op while a maintenance
#                                  hold is set, which is what stops the watchdog racing a
#                                  maintenance window
#   stop <name>                -> stop it AND hold it down (the hold expires, so a
#                                  crashed holder can't strand a capability offline)
#   restart <name>             -> stop, rebuild if `build` is declared, start
#   resume <name>              -> lift the hold and start
#   status <name>              -> pid/container state + live health, one line
#   up | down | status         -> no capability argument: the whole enabled set, started in
#                                  dependency order (`requires =`) and stopped in reverse
#   install-persistence <name> -> dispatches by machine.toml's os. A container capability
#                                  is skipped outright: both runtimes restart it natively
#                                  (--restart unless-stopped), so a unit would fight them
