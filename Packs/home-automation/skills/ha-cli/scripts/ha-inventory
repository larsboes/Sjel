#!/bin/bash
# ha-inventory.sh — write a deterministic, diff-friendly Home Assistant inventory
# from a live instance into overlay config.
#
#   Packs/home-automation/skills/ha-cli/scripts/ha-inventory [--overlay <path>] [--url <base>] [--token <value>] [--output <path>]
#   Packs/home-automation/skills/ha-cli/scripts/ha-inventory --help
#
# Contract:
# - Reads HA token from config/home-assistant.env if present (by capability manifest),
#   or from explicit --token.
# - Does not write anything unless the HA token is available and API calls succeed.
# - Writes a sorted JSON artifact suitable for git diff review.
# - Never prints token values.
#
# Output (default):
#   $SJEL_PERSONAL_ROOT/config/home-assistant.json
#
# Deterministic behavior is intentional: keys and arrays are sorted for stable
# diffs and easier overlay review.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# This needs three things tools/lib/{paths,toml}.sh used to hand over: SJEL_ROOT for
# the capability manifest, the overlay root, and toml_get. A deployed skill is a copy
# under ~/.claude/skills, so it cannot source the repo by relative path — resolve the
# same way homectl does, environment first and walk-up second, and vendor the one
# toml helper actually used here.
toml_get() {  # toml_get <key> <file> — empty output, exit 0, if key absent
  grep -E "^$1[[:space:]]*=" "$2" | sed -E "s/^$1[[:space:]]*=[[:space:]]*\"([^\"]*)\".*/\1/" || true
}

_resolve_axon_root() {
  if [ -n "${SJEL_ROOT:-}" ] && [ -f "$SJEL_ROOT/axon.toml" ]; then
    echo "$SJEL_ROOT"
    return
  fi
  local candidate="$SCRIPT_DIR"
  while [ "$candidate" != "/" ]; do
    if [ -f "$candidate/axon.toml" ]; then
      echo "$candidate"
      return
    fi
    candidate="$(dirname "$candidate")"
  done
}

_resolve_overlay_root() {
  local raw="${SJEL_HOME_ROOT:-${SJEL_OVERLAY_ROOT:-${SJEL_PERSONAL_ROOT:-}}}"
  if [ -z "$raw" ] && [ -n "${SJEL_ROOT:-}" ] && [ -f "$SJEL_ROOT/axon.local.toml" ]; then
    raw="$(toml_get overlay "$SJEL_ROOT/axon.local.toml")"
  fi
  echo "${raw/#\~/$HOME}"
}

usage() {
  sed -n '2,19p' "$0"
  exit 0
}

die() {
  echo "ha-inventory.sh: $*" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found"
}

require curl
require jq

SJEL_ROOT="$(_resolve_axon_root)"
[ -n "$SJEL_ROOT" ] || die "Axon checkout not found; export SJEL_ROOT=/path/to/Axon"
export SJEL_ROOT

OVERLAY_ROOT="$(_resolve_overlay_root)"
[ -n "$OVERLAY_ROOT" ] || die "overlay is unresolved; set \`overlay\` in axon.local.toml or export SJEL_OVERLAY_ROOT"
export SJEL_OVERLAY_ROOT="$OVERLAY_ROOT" SJEL_PERSONAL_ROOT="$OVERLAY_ROOT"

CAP_MANIFEST="$SJEL_ROOT/capabilities/home-assistant/service.toml"
[ -f "$CAP_MANIFEST" ] || die "home-assistant manifest missing: $CAP_MANIFEST"

OUTPUT_REL="config/home-assistant.json"
ENV_FILE_REL="$(toml_get env_file "$CAP_MANIFEST")"
[ -n "$ENV_FILE_REL" ] || ENV_FILE_REL="config/home-assistant.env"

HA_BASE_URL=""
HA_TOKEN=""
OUTPUT_FILE=""
OUTPUT_EXPLICIT=0

trim_quotes() {
  local v="$1"
  v="${v%$'\r'}"
  v="$(echo "$v" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  case "$v" in
    \"*\") v="${v#\"}"; v="${v%\"}";;
    \'*\') v="${v#\'}"; v="${v%\'}";;
  esac
  printf '%s' "$v"
}

read_env_var() {
  # read_env_var <file> <KEY>
  local file="$1" key="$2" line value
  [ -f "$file" ] || return 1
  while IFS= read -r line; do
    case "$line" in
      ""|"#"*) continue ;;
      export\ *) line="${line#export }" ;;
      *) ;;
    esac
    case "$line" in
      "$key"=*)
        value="${line#*=}"
        printf '%s' "$(trim_quotes "$value")"
        return 0
        ;;
    esac
  done < "$file"
  return 1
}

api_get_json() {
  # api_get_json <path> <out_file>
  local endpoint="$1" out="$2" code url
  url="${HA_BASE_URL%/}/api/${endpoint#/}"

  if ! code="$(curl -sS -m 30 -H "Authorization: Bearer $HA_TOKEN" \
    -H "Content-Type: application/json" -o "$out" -w '%{http_code}' "$url")"; then
    echo "ha-inventory: API call failed: $url" >&2
    return 1
  fi
  case "$code" in
    200) return 0 ;;
    401|403)
      echo "ha-inventory: API call unauthorized at $url (check HA_TOKEN permissions)" >&2
      return 1
      ;;
    *)
      echo "ha-inventory: API call failed at $url with HTTP $code" >&2
      return 1
      ;;
  esac
}

require_json_file() {
  # require_json_file <file> <endpoint_name>
  local file="$1" endpoint="$2"
  if ! jq empty "$file" >/dev/null 2>&1; then
    echo "ha-inventory: API response for $endpoint was not valid JSON" >&2
    return 1
  fi
}

read_count() {
  # read_count <json_path>
  jq -r "$1 // 0" "$OUTPUT_FILE" 2>/dev/null || echo 0
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --overlay)
      [ "$#" -ge 2 ] || die "--overlay needs a path argument"
      OVERLAY_ROOT="$2"
      shift 2
      ;;
    --url)
      [ "$#" -ge 2 ] || die "--url needs an URL"
      HA_BASE_URL="$2"
      shift 2
      ;;
    --token)
      [ "$#" -ge 2 ] || die "--token needs a value"
      HA_TOKEN="$2"
      shift 2
      ;;
    --output)
      [ "$#" -ge 2 ] || die "--output needs a file path"
      OUTPUT_FILE="$2"
      OUTPUT_EXPLICIT=1
      shift 2
      ;;
    --help)
      usage
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[ -n "${HA_BASE_URL}" ] || HA_BASE_URL="$(read_env_var "$OVERLAY_ROOT/$ENV_FILE_REL" HA_URL || true)"
[ -n "${HA_BASE_URL}" ] || HA_BASE_URL="$(read_env_var "$OVERLAY_ROOT/$ENV_FILE_REL" HA_BASE_URL || true)"
[ -n "${HA_BASE_URL}" ] || HA_BASE_URL="$(read_env_var "$OVERLAY_ROOT/$ENV_FILE_REL" HASS_URL || true)"
[ -n "${HA_BASE_URL}" ] || HA_BASE_URL="$(read_env_var "$OVERLAY_ROOT/$ENV_FILE_REL" HOME_ASSISTANT_URL || true)"
[ -n "${HA_BASE_URL}" ] || HA_BASE_URL="http://127.0.0.1:8123"

if [ -z "$HA_TOKEN" ]; then
  HA_TOKEN="$(read_env_var "$OVERLAY_ROOT/$ENV_FILE_REL" HA_TOKEN || true)"
fi

[ -n "$HA_TOKEN" ] || die "no HA token found. Provide --token or set HA_TOKEN in $OVERLAY_ROOT/$ENV_FILE_REL"

case "$HA_BASE_URL" in
  http://*|https://*) ;;
  *) HA_BASE_URL="http://$HA_BASE_URL" ;;
esac

if [ "$OUTPUT_EXPLICIT" -eq 0 ]; then
  OUTPUT_FILE="$OVERLAY_ROOT/$OUTPUT_REL"
fi

OUTPUT_DIR="$(dirname "$OUTPUT_FILE")"
mkdir -p "$OUTPUT_DIR"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT
STATES="$TMP_DIR/states.json"
DEVICES="$TMP_DIR/devices.json"
ENTITIES="$TMP_DIR/entities.json"
CONFIG="$TMP_DIR/config.json"
OUT_TMP="$TMP_DIR/inventory.json"

echo "ha-inventory: source    = $HA_BASE_URL"
echo "ha-inventory: overlay  = $OVERLAY_ROOT"
echo "ha-inventory: env file = $OVERLAY_ROOT/$ENV_FILE_REL"
echo "ha-inventory: output   = $OUTPUT_FILE"
echo

api_get_json "states" "$STATES"
api_get_json "config" "$CONFIG"
api_get_json "config/device_registry/list" "$DEVICES"
api_get_json "config/entity_registry/list" "$ENTITIES"

require_json_file "$STATES" "/states"
require_json_file "$CONFIG" "/config"
require_json_file "$DEVICES" "/config/device_registry/list"
require_json_file "$ENTITIES" "/config/entity_registry/list"

jq -nS --arg ts "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
  --arg base "$HA_BASE_URL" \
  --slurpfile states "$STATES" \
  --slurpfile devices "$DEVICES" \
  --slurpfile entities "$ENTITIES" \
  --slurpfile config "$CONFIG" \
  '
def by_entity_id:
  sort_by(.entity_id);

{
  generated_at: $ts,
  source: {
    base_url: $base
  },
  homeassistant: {
    config: ($config[0].config // null),
    version: $config[0].version,
    time_zone: ($config[0].time_zone // null),
    internal_url: ($config[0].internal_url // null),
    external_url: ($config[0].external_url // null),
    latitude: ($config[0].latitude // null),
    longitude: ($config[0].longitude // null)
  },
  summary: {
    entities: ($states[0] | length),
    automations: ([ $states[0][]? | select(.entity_id | startswith("automation.")) ] | length),
    devices: ($devices[0] | length),
    registry_entities: ($entities[0] | length)
  },
  inventory: {
    states: [ $states[0][] | {
      entity_id,
      domain: (.entity_id | split(".")[0]),
      state,
      friendly_name: (.attributes.friendly_name // null),
      last_changed: .last_changed,
      last_updated: .last_updated,
      attributes: {
        device_id: (.attributes.device_id // null),
        unit_of_measurement: (.attributes.unit_of_measurement // null),
        icon: (.attributes.icon // null),
        state_class: (.attributes.state_class // null)
      }
    } ] | by_entity_id,
    automations: [ $states[0][] | select(.entity_id | startswith("automation.")) | {
      entity_id,
      state,
      last_changed: .last_changed,
      last_updated: .last_updated,
      friendly_name: (.attributes.friendly_name // null),
      trigger_entity_id: (.attributes.trigger_entity_id // null),
      last_triggered: (.attributes.last_triggered // null)
    } ] | by_entity_id,
    devices: [ $devices[0][] | {
      id: .id,
      name: (.name // null),
      model: (.model // null),
      manufacturer: (.manufacturer // null),
      sw_version: (.sw_version // null),
      hw_version: (.hw_version // null),
      via_device_id: (.via_device_id // null),
      model_id: (.model_id // null),
      manufacturer_id: (.manufacturer_id // null)
    } ] | sort_by(.id),
    entity_registry: [ $entities[0][] | {
      entity_id,
      domain: (.domain // null),
      unique_id: (.unique_id // null),
      platform: (.platform // null),
      device_id: (.device_id // null),
      area_id: (.area_id // null),
      name: (.name // null),
      icon: (.icon // null)
    } ] | by_entity_id
  }
}
' > "$OUT_TMP"

if [ -f "$OUTPUT_FILE" ]; then
  old_entities="$(read_count '.summary.entities')"
  old_automations="$(read_count '.summary.automations')"
  old_devices="$(read_count '.summary.devices')"
  old_registry="$(read_count '.summary.registry_entities')"
else
  old_entities=0
  old_automations=0
  old_devices=0
  old_registry=0
fi

new_entities="$(jq -r '.summary.entities // 0' "$OUT_TMP")"
new_automations="$(jq -r '.summary.automations // 0' "$OUT_TMP")"
new_devices="$(jq -r '.summary.devices // 0' "$OUT_TMP")"
new_registry="$(jq -r '.summary.registry_entities // 0' "$OUT_TMP")"

echo "ha-inventory: summary"
echo "  entities       : $old_entities -> $new_entities"
echo "  automations    : $old_automations -> $new_automations"
echo "  devices        : $old_devices -> $new_devices"
echo "  registry items : $old_registry -> $new_registry"

if [ -f "$OUTPUT_FILE" ]; then
  cmp_old="$TMP_DIR/old_no_generated_at.json"
  cmp_new="$TMP_DIR/new_no_generated_at.json"
  jq -S 'del(.generated_at)' "$OUTPUT_FILE" > "$cmp_old"
  jq -S 'del(.generated_at)' "$OUT_TMP" > "$cmp_new"
  if cmp -s "$cmp_old" "$cmp_new"; then
    echo "ha-inventory: no inventory-content changes detected"
    exit 0
  fi
fi

mv "$OUT_TMP" "$OUTPUT_FILE"
echo "ha-inventory: updated -> $OUTPUT_FILE"
