#!/bin/bash
# tools/updates — every piece of software installed outside this checkout: who owns moving it,
# what has gone stale, and what nothing moves at all.
#
# Launcher only. The logic moved to tools/sjel-cli/src/updates/ on 2026-10-04; this path stays
# so `sjel update`, tools/audit and the dashboard keep calling it unchanged, and
# `tools/updates -h` prints the usage.
#
# It sources tools/lib/paths.sh, because the receipt this reads lives in the overlay
# (<overlay>/data/host-patch/last.json) and the overlay's location is resolved in one place —
# axon.local.toml, then axon.toml — never re-derived here.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"       # SJEL_ROOT, SJEL_OVERLAY_ROOT
# shellcheck source=tools/lib/sjel-cli.sh
. "$_here/lib/sjel-cli.sh"
sjel_cli_exec updates "$@"
