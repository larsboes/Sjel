#!/bin/bash
# capabilities/cv/cv — build CVs from the master file. Named after its capability, which puts
# this directory on PATH. Execs cv-cli; `cv` with no arguments prints usage.
# Portable shell only (CONTRIBUTING.md#portable-shell) — no bash-4-only syntax.
set -euo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"
export SJEL_ROOT SJEL_PERSONAL_ROOT

BIN="${CARGO_TARGET_DIR:-$SJEL_ROOT/target}/release/cv-cli"

# Rebuild when the binary is missing or older than its sources, so an edit never runs stale.
# Build output goes to stderr so `cv status --json | jq` still works.
if [ ! -x "$BIN" ] || [ -n "$(find "$_dir/src" "$_dir/Cargo.toml" -newer "$BIN" 2>/dev/null | head -1)" ]; then
  echo "cv: building cv-cli…" >&2
  (cd "$SJEL_ROOT" && cargo build --locked --release --bin cv-cli) >&2
fi

exec "$BIN" "$@"
