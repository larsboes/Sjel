# Shape of a Packs/<name>/pack.toml. A Pack is a togglable bundle of agent
# open agent skills (SKILL.md units) that Axon deploys into an active harness.
# This file IS the schema (single-line TOML only, see tools/lib/toml.sh):
# copy it into a pack dir, fill it in, drop the skills under skills/.
#
# Doctrine: skills are PUBLIC and stay in Axon. No personal value (host, path,
# key) is ever inlined in a skill — it is redacted to a placeholder, and the
# skill reads the real value at runtime from the overlay
# ($SJEL_PERSONAL_ROOT/config/<pack>.*). Harness adapters activate the same
# source: every adapter materializes COPIES — tools/packs-claude into Claude Code,
# tools/packs-codex into Codex — over the shared engine in tools/sjel-cli/src/harnesses/.

name         = "example"                 # pack id, must match the dir name
description  = "One line: what this pack lets an agent do."
skills       = ["example-skill"]         # dir names under this pack's skills/, repeatable
retired_skills = ["old-example-skill"]  # optional: prior names an adapter may remove only when it owns the installation
license      = "MIT"                      # SPDX id; add a LICENSE file in the pack only if it vendors third-party code under a different license
capabilities = ["printing"]              # optional: capabilities/<name> this pack drives
personal     = ["config/example.json"]   # optional: files relative to the selected overlay that skills read at runtime
links        = ["moonraker"]             # optional: systems.toml ids this pack relates to
deployer     = "packs-axon"              # optional: a dedicated tool owns this pack's destinations


# `deployer` names the one tool that owns this pack's destination directories.
# Set it and the generic adapters stop claiming the pack: neither packs-claude nor
# packs-codex will deploy it, and it stays out of every sweep and out of a `*`
# profile. The named tool still deploys it by asking for it explicitly.
# Without this field, one skill can be claimed by several mechanisms at once —
# each adapter's copy plus a dedicated deployer's ledger, all pointed at the same
# path, each reporting a different verdict for it.

# Every pack carries a short README.md: what it does, how to activate it, and —
# if any skill was adapted from an external source — an Attribution line naming
# it (respect its license). A separate LICENSE file only when vendored code
# demands one; otherwise the `license` field above is the whole story.

# Optional, convention-based (no TOML field): a pack MAY also carry an
# agents/ directory of Claude-Code-native subagent .md files
# (https://code.claude.com/docs/en/sub-agents). packs-claude deploys it as ONE
# owned unit at ~/.claude/agents/<name> if present -- deliberately not named here,
# since a Claude-Code-only concept doesn't belong in the neutral manifest shape
# (see CONTRIBUTING.md#harness-neutral-packs). See Packs/academic-writing/ for a
# worked example (5 review-lens agents + 3 adversarial-skeptic agents).
#
# A pack MAY likewise carry an extensions/ directory of pi-only .ts agent
# extensions. tools/packs-pi registers them in Pi's settings `extensions`
# array alongside the pack's skills; every other adapter ignores extensions/
# — a pi-exclusive concept, kept out of the neutral manifest shape for the
# same reason as agents/. See Packs/knowledge/ (quiz.ts).
#
# A pack MAY likewise carry Codex-only deployment fields under
# codex/<skill>/, matching their final paths inside the skill. The common case
# is codex/<skill>/agents/openai.yaml plus any Codex-only assets it references.
# tools/packs-codex merges this overlay over the shared skill while staging,
# but refuses a Codex-specific SKILL.md so the shared workflow stays canonical.

# NOTE ON A CONVENTION THAT WAS TRIED AND REMOVED (2026-09-17): a pack-level `shared/`
# directory, merged into every skill of the pack by the deployer, existed for one day and was
# deleted. It made the SOURCE skill incomplete — the file was absent in the repo and only
# materialized by the deployer, so the tree a human reads and reviews did not show a
# dependency the skill actually had, and any copy not made by this deployer broke at runtime —
# and it went to EVERY skill of the pack, so the one thing large enough to want it could not
# use it. Do not reintroduce it.
#
# The principle instead:
#   A skill must be able to RUN from its own directory. No shared/ files, no paths into a
#   sibling skill's tree.
#   A skill MAY POINT at a sibling by name for material it merely READS. That degrades
#   gracefully — the local text still says what to do — whereas a path fails hard. Copying
#   content to satisfy "self-contained" would be worse than the dependency.
#
# An invariant two skills must share is therefore a GATE, not a file. See
# tools/check-presentations-theme-contract.sh, which fails if a role one skill requires is not
# one the other's themes define.
#
# tools/packs-claude (tools/packs.sh is a shim over it, kept for older call sites):
#   status [name|--all]  -> source/install/drift state for materialized Claude skills
#   deploy <name>        -> copy a Pack into ~/.claude/skills with ownership state
#                           (and agents/ into ~/.claude/agents/<name>, if present)
#   adopt <name>         -> claim identical copies already in place, e.g. after the
#                           2026-08-09 migration off symlinks; refuses anything that differs
#   sync <name>|--all    -> update clean owned copies; refuse destination drift
#   remove <name>        -> remove only clean copies owned by that Pack
#
# `retired_skills` above is honoured by adapters that need it; a ledger-backed one
# does not, because it already knows what it deployed and `sync` removes a skill
# dropped from `skills` as stale.
#
# tools/packs-codex:
#   status [name|--all]  -> source/install/drift state for materialized Codex skills
#   deploy <name>        -> copy a Pack into ~/.agents/skills with ownership state
#   sync <name>|--all    -> update clean owned copies; refuse destination drift
#   remove <name>        -> remove only clean copies owned by that Pack
