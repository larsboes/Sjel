#!/usr/bin/env bash
# apps/gpui/ios/run-sim — build the iOS app, run it on a headless simulator, and print
# a screenshot path. Never opens Simulator.app, so it takes no focus.
#
# SJEL_IOS_SIM=<udid> picks an iPhone on the newest available iOS runtime.
#
# --join asks this Mac's LAN listener to register the app as a device. It passes the Mac's
# Bonjour name, the listener port (SJEL_LAN_PORT, default 8443) and the certificate's SHA-256,
# none of them secret, and leaves the simulator running: allow the device in the dashboard's
# Devices panel, then run this script again to see the signed result. With Bonjour discovery in
# the app (`host/Discovery.swift`) a browse finds the Mac instead, so this stays for a host that
# cannot browse.
#
# --tap runs the touch check (`host/UITests/JoinTap.swift`): it taps Join on the discovered Mac
# and takes a screenshot before and after, because GPUI paints its own pixels and a screenshot
# alone cannot show whether a finger reached it.
set -euo pipefail
join=false
tap=false
smoke=false
for arg in "$@"; do
  case "$arg" in
    --join) join=true ;;
    --tap) tap=true ;;
    --smoke) smoke=true ;;
    *) echo "ios/run-sim: unknown argument $arg" >&2; exit 1 ;;
  esac
done
[ "$(uname -s)" = Darwin ] || { echo "ios/run-sim: macOS only" >&2; exit 1; }
command -v xcodegen >/dev/null || { echo "ios/run-sim: needs xcodegen (brew install xcodegen)" >&2; exit 1; }

IOS_DIR="$(cd "$(dirname "$0")" && pwd)"
HOST="$IOS_DIR/host"
BUNDLE_ID="dev.sjel.ios"

if ! devices="$(xcrun simctl list devices available)"; then
  echo "ios/run-sim: CoreSimulator is unavailable; check device access before building" >&2
  exit 1
fi
export IPHONEOS_DEPLOYMENT_TARGET="$(sed -n 's/^ *iOS: *"\([^"]*\)".*/\1/p' "$HOST/project.yml")"
[[ "$IPHONEOS_DEPLOYMENT_TARGET" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "ios/run-sim: invalid iOS deployment target" >&2; exit 1; }
latest_devices="$(printf '%s\n' "$devices" | awk -v minimum="$IPHONEOS_DEPLOYMENT_TARGET" '
  /^-- iOS / { split($3, v, "."); version = v[1] * 1000000 + v[2] * 1000 + v[3] }
  /^ *iPhone/ && v[1] >= minimum {
    if (version > latest) { latest = version; devices = "" }
    if (version == latest) devices = devices $0 "\n"
  }
  END { printf "%s", devices }
')"
udid="${SJEL_IOS_SIM:-$(printf '%s\n' "$latest_devices" | sed -n 's/^ *iPhone[^(]*(\([0-9A-F-]\{36\}\)).*/\1/p' | head -1)}"
[ -n "$udid" ] || { echo "ios/run-sim: no available iPhone simulator" >&2; exit 1; }
if ! printf '%s\n' "$devices" | grep -Fq "($udid)"; then
  echo "ios/run-sim: selected simulator is unavailable: $udid" >&2
  exit 1
fi
if ! printf '%s\n' "$latest_devices" | grep -Fq "($udid)"; then
  echo "ios/run-sim: select an iPhone on the newest supported iOS runtime" >&2
  exit 1
fi

# SJEL_IOS_FEATURES adds cargo features to the Rust library.
(cd "$IOS_DIR" && cargo build --lib --target aarch64-apple-ios-sim ${SJEL_IOS_FEATURES:+--features "$SJEL_IOS_FEATURES"})
target_dir="$(cd "$IOS_DIR" && cargo metadata --no-deps --format-version 1 | sed -n 's/.*"target_directory":"\([^"]*\)".*/\1/p')"
rust_lib="$target_dir/aarch64-apple-ios-sim/debug/libsjel_gpui_ios.a"

(cd "$HOST" && xcodegen generate --quiet --spec project.yml)
xcodebuild -project "$HOST/SjelIOS.xcodeproj" -scheme SjelIOS -sdk iphonesimulator \
  -configuration Debug -derivedDataPath "$HOST/build" -quiet RUST_LIB="$rust_lib" build
app="$HOST/build/Build/Products/Debug-iphonesimulator/SjelIOS.app"

booted_here=false
if ! xcrun simctl list devices | grep -q "$udid) (Booted)"; then
  xcrun simctl boot "$udid"
  booted_here=true
fi
xcrun simctl bootstatus "$udid" -b >/dev/null

# The scanner asks for the camera the first time it opens. Answering that alert needs a hand on a
# screen this script never opens, so the answer is given here instead: a granted camera is what a
# phone that has already paired has anyway, and the tap check is about the finger reaching Scan.
xcrun simctl privacy "$udid" grant camera "$BUNDLE_ID" >/dev/null 2>&1 || true

if $tap || $smoke; then
  # xcodebuild boots and drives the simulator itself; nothing opens Simulator.app.
  results="${SJEL_IOS_RESULTS:-$(mktemp -d "${TMPDIR:-/tmp}/sjel-ios-tests.XXXXXX")}"
  mkdir -p "$results"
  selection=(-only-testing:SjelIOSUITests)
  appearances=(current)
  if $smoke; then
    selection=(-only-testing:SjelIOSUITests/NshScreens)
    appearances=(light dark)
    original_appearance="$(xcrun simctl ui "$udid" appearance)"
    trap 'xcrun simctl ui "$udid" appearance "$original_appearance" >/dev/null 2>&1' EXIT
  fi
  status=0
  for appearance in "${appearances[@]}"; do
    if [ "$appearance" != current ]; then xcrun simctl ui "$udid" appearance "$appearance"; fi
    result="$results/$appearance/tests.xcresult"
    mkdir -p "$results/$appearance"
    xcodebuild -project "$HOST/SjelIOS.xcodeproj" -scheme SjelIOS -sdk iphonesimulator \
      -configuration Debug -derivedDataPath "$HOST/build" -resultBundlePath "$result" \
      -destination "platform=iOS Simulator,id=$udid" -quiet RUST_LIB="$rust_lib" \
      "${selection[@]}" test || status=$?
    shots="$results/$appearance/screenshots"
    if [ -d "$result" ]; then
      xcrun xcresulttool export attachments --path "$result" --output-path "$shots" >/dev/null || {
        echo "ios/run-sim: could not export test attachments" >&2
        [ "$status" -ne 0 ] || status=1
      }
    fi
    echo "$result"
    [ ! -d "$shots" ] || find "$shots" -name '*.png' -print
  done
  exit "$status"
fi

xcrun simctl install "$udid" "$app"
if $join; then
  port="${SJEL_LAN_PORT:-8443}"
  pin="$(openssl s_client -connect "127.0.0.1:$port" </dev/null 2>/dev/null \
    | openssl x509 -outform DER 2>/dev/null | shasum -a 256 | cut -c1-64)"
  [ ${#pin} -eq 64 ] || { echo "ios/run-sim: no LAN listener on port $port" >&2; exit 1; }
  export SIMCTL_CHILD_SJEL_JOIN="$(scutil --get LocalHostName) $port $pin"
  booted_here=false
fi
xcrun simctl launch --terminate-running-process "$udid" "$BUNDLE_ID" >/dev/null
sleep 6
shot="${TMPDIR:-/tmp}/sjel-ios-$(date +%s).png"
xcrun simctl io "$udid" screenshot "$shot" >/dev/null
$booted_here && xcrun simctl shutdown "$udid"
echo "$shot"
