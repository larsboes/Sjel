#!/bin/bash
# tools/audit — the one command, and the only two scanners Sjel still runs itself.
#
# Launcher only. The logic moved to tools/sjel-cli/src/audit.rs on 2026-10-04; this path stays so
# the three callers do not change: `sjel update apply` runs it as its last step, tools/doctor
# reads the verdict it wrote into the host-patch receipt, and toolchain.toml's `workflow:audit`
# scope names the scanners it needs. `tools/audit -h` prints the usage.
#
# It sources tools/lib/paths.sh, because the private overlay's location is resolved in one place —
# axon.local.toml, then axon.toml — and this is the one tool that scans its git history.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"       # SJEL_ROOT, SJEL_PERSONAL_ROOT
# shellcheck source=tools/lib/sjel-cli.sh
. "$_here/lib/sjel-cli.sh"
sjel_cli_exec audit "$@"
