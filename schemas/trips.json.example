{
  "_note": "Private overlay template. Replace <knowledge-base-root> with this deployment's absolute or home-relative knowledge-store path, or set SJEL_TRIPS_OBSIDIAN_ROOT instead. The travel section feeds the flight routes: pivots are cities where sleeping is free or wanted (friends, family). The default flight origin is NOT here -- it is `hard.home_airports` on the traveler profile, because where the traveller lives is a fact about the traveller and this file held a second copy of it -- the pivot-routing search enumerates itineraries through them, which is exactly the knowledge no commercial engine has. Personal by nature: real pivots belong only in the overlay copy of this file.",
  "obsidian": {
    "root": "<knowledge-base-root>",
    "trips_dir": "Atlas/Events"
  },
  "travel": {
    "pivots": [
      { "name": "<who or where>", "iata": "<IATA>", "max_nights": 2 }
    ]
  }
}
