# Copy this file to `<overlay>/config/vaultwarden.env` and replace placeholders.
# Non-secret defaults are tracked for reproducibility; secrets are placeholders only.
# Keep all real values in the overlay/private file.

DOMAIN="vaultwarden.local"
ADMIN_TOKEN=<required: real ADMIN_TOKEN hash from tools/setup-secret.sh>
ROCKET_TLS={certs="/tls/cert.pem",key="/tls/key.pem"}
SIGNUPS_ALLOWED=false
