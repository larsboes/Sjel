#!/bin/bash
# Human-run bridge from one reviewed Vaultwarden Secure Note to the private,
# gitignored key file consumed by libs/inference. Secret bytes go directly
# from `bw get notes` into a mode-0600 temporary file and are never printed.
set -euo pipefail
set +x
umask 077

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
source "$TOOLS_DIR/lib/paths.sh"
source "$TOOLS_DIR/lib/external-ref.sh"
PRIVATE_ROOT="${SJEL_INFERENCE_KEY_OVERLAY:-$SJEL_PERSONAL_ROOT}"
if [ "$PRIVATE_ROOT" != "$SJEL_OVERLAY_ROOT" ]; then
  # An overlay override has to redirect EVERY overlay read, not only the ones this file makes
  # by hand. external-ref.sh resolves the reference through SJEL_OVERLAY_ROOT and
  # SJEL_MACHINE_TOML; leaving those pointed at the real overlay would answer with two
  # machines' facts mixed together — the scratch overlay's vaultwarden.env and the live
  # machine's provider declaration.
  SJEL_OVERLAY_ROOT="$PRIVATE_ROOT"
  SJEL_MACHINE_TOML="$PRIVATE_ROOT/config/machine.toml"
fi

usage() {
  echo "usage: materialize-inference-key <cohere|gemini|groq|nvidia-nim|opencode-go>" >&2
  exit 1
}

[ $# -eq 1 ] || usage
PROVIDER="$1"
case "$PROVIDER" in
  cohere) ITEM="inference-cohere-api-key" ;;
  gemini) ITEM="inference-gemini-api-key" ;;
  # The second public-tier provider (systems.toml [groq]). Same handling as every other entry
  # here -- only the item name is new, which is the point of keeping one bridge rather than a
  # script per provider.
  groq) ITEM="inference-groq-api-key" ;;
  nvidia-nim) ITEM="inference-nvidia-nim-api-key" ;;
  # The PAID fallback behind nvidia-nim's free tier (systems.toml [opencode-zen-go]). Nothing
  # about the handling differs: the bytes go from `bw get notes` into a mode-0600 file and are
  # never printed. Only the item name is new, which is the point of keeping one bridge.
  opencode-go) ITEM="inference-opencode-go-api-key" ;;
  *) usage ;;
esac

command -v bw >/dev/null 2>&1 || {
  echo "materialize-inference-key: Bitwarden CLI is not installed" >&2
  exit 1
}
command -v jq >/dev/null 2>&1 || {
  echo "materialize-inference-key: jq is not installed" >&2
  exit 1
}

# Which Vaultwarden this machine's CLI talks to, which is NOT the same fact as which vaultwarden
# capability this machine runs. A machine that only consumes the vault runs none, and reading the
# capability's own env_file DOMAIN there compares `bw` against a server that does not exist
# locally — which surfaced as "Bitwarden CLI is logged into a different server" on a CLI that was
# correctly logged into the vault's actual host.
#
# That reasoning now lives in tools/lib/external-ref.sh, generalized: a declared provider first,
# the capability's own server config only as the fallback for a machine that genuinely self-hosts.
# A dangling declaration is reported there and returns 2 — this tool must not soften that into a
# local address, which is why only 1 (nothing declared at all) gets a message of its own.
DOMAIN=""
REF_RC=0
# `|| REF_RC=$?` rather than `if ! DOMAIN=$(...)`, which would read the status of the negation
# instead of the resolver's and collapse "nothing declared" into "declared but broken".
DOMAIN="$(capability_endpoint vaultwarden DOMAIN)" || REF_RC=$?
# 2 is a dangling declaration; external-ref.sh has already said which id and which file.
if [ "$REF_RC" -eq 2 ]; then
  exit 1
fi
if [ "$REF_RC" -ne 0 ]; then
  echo "materialize-inference-key: no Vaultwarden declared for this machine." >&2
  echo "  Declare the vault your bw CLI uses in $SJEL_MACHINE_TOML:" >&2
  echo "    [capability.vaultwarden]" >&2
  echo "    provided_by = \"<id>\"      # an id with a url in config/systems.local.toml" >&2
  echo "  or configure the vaultwarden capability if this machine hosts it." >&2
  exit 1
fi

STATUS_JSON="$(bw status 2>/dev/null || true)"
CURRENT_SERVER="$(printf '%s' "$STATUS_JSON" | jq -r '.serverUrl // empty')"
VAULT_STATUS="$(printf '%s' "$STATUS_JSON" | jq -r '.status // "unauthenticated"')"
if [ "$CURRENT_SERVER" != "$DOMAIN" ]; then
  if [ "$VAULT_STATUS" != "unauthenticated" ]; then
    echo "materialize-inference-key: Bitwarden CLI is logged into a different server" >&2
    echo "run 'bw logout' yourself, then rerun this command; it will configure the active Axon Vaultwarden server" >&2
    exit 1
  fi
  bw config server "$DOMAIN" >/dev/null
  echo "materialize-inference-key: active Axon Vaultwarden server configured; run 'bw login' yourself, then rerun" >&2
  exit 1
fi

LOCKED_BY_US=0
BW_SESSION="${BW_SESSION:-}"
case "$VAULT_STATUS" in
  unauthenticated)
    echo "materialize-inference-key: run 'bw login' yourself first" >&2
    exit 1
    ;;
  locked)
    echo "Vault is locked — enter your master password for this run only:"
    BW_SESSION="$(bw unlock --raw)" || {
      echo "materialize-inference-key: unlock failed" >&2
      exit 1
    }
    export BW_SESSION
    LOCKED_BY_US=1
    ;;
  unlocked)
    [ -n "$BW_SESSION" ] || {
      echo "materialize-inference-key: export a current BW_SESSION and retry" >&2
      exit 1
    }
    ;;
  *)
    echo "materialize-inference-key: unexpected vault status" >&2
    exit 1
    ;;
esac

TARGET_DIR="$PRIVATE_ROOT/config/runtime-secrets"
TARGET="$TARGET_DIR/$ITEM"
TMP="$TARGET.tmp.$$"
cleanup() {
  [ -f "$TMP" ] && rm -f "$TMP"
  [ "$LOCKED_BY_US" = 1 ] && bw lock >/dev/null 2>&1 || true
  unset BW_SESSION
}
trap cleanup EXIT

bw sync --session "$BW_SESSION" >/dev/null
FOLDER_ID="$(bw list folders --session "$BW_SESSION" --nointeraction \
  | jq -r '.[] | select(.name=="Axon") | .id' | head -1)"
[ -n "$FOLDER_ID" ] || {
  echo "materialize-inference-key: Vaultwarden folder 'Axon' is missing" >&2
  exit 1
}
ITEM_ID="$(bw list items --folderid "$FOLDER_ID" --session "$BW_SESSION" --nointeraction \
  | jq -r --arg name "$ITEM" '.[] | select(.name==$name) | .id' | head -1)"
[ -n "$ITEM_ID" ] || {
  echo "materialize-inference-key: Secure Note '$ITEM' is missing from folder 'Axon'" >&2
  exit 1
}
ITEM_TYPE="$(bw get item "$ITEM_ID" --session "$BW_SESSION" --nointeraction | jq -r '.type')"
[ "$ITEM_TYPE" = 2 ] || {
  echo "materialize-inference-key: '$ITEM' must be a Secure Note" >&2
  exit 1
}

if [ -f "$TARGET" ]; then
  read -r -p "Replace the existing local $PROVIDER key file? [y/N]: " CONFIRM
  case "$CONFIRM" in
    [Yy]*) ;;
    *) echo "cancelled, nothing written"; exit 0 ;;
  esac
fi

mkdir -p "$TARGET_DIR"
bw get notes "$ITEM_ID" --session "$BW_SESSION" --nointeraction > "$TMP"
grep -q '[^[:space:]]' "$TMP" || {
  echo "materialize-inference-key: '$ITEM' has an empty Notes field" >&2
  exit 1
}
chmod 600 "$TMP"
mv "$TMP" "$TARGET"

echo "done — $PROVIDER credential materialized for local Axon runtime use"
echo "restart Comms before testing provider availability"
