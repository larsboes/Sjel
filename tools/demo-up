#!/usr/bin/env bash
# tools/demo-up — run the published demonstration's stack, against the demo overlay (#168).
#
# Points a single shell at demo/overlay, gives every capability a throwaway database, starts
# them through the ordinary service runner, then seeds and records. The operator's own overlay
# and axon.local.toml are never touched — see the SJEL_OVERLAY_ROOT override in tools/lib/paths.sh.
#
# THE COLLISION, and why this script refuses rather than coping. The demo capabilities listen on
# the SAME ports as a real installation's. They have to: `tools/capability.sh registry` reads
# ports from each service.toml and does not apply machine.toml's per-capability `port` override
# (only service-runner.sh does), so a demo overlay that moved its ports would be started on one
# number and recorded from another. Sharing the ports means a real stack that is already up would
# be silently adopted — service-runner sees a live pid file and returns "already up" — and the
# seeder would then POST invented rows into a real ledger. So this refuses to start when anything
# already answers, and says what to stop.
#
# That is one of three independent guards, because this is the failure that cannot be undone:
#   1. here — refuse to start on top of a running stack
#   2. tools/demo-seed — refuse unless the resolved overlay IS demo/overlay
#   3. tools/demo-seed — refuse any capability whose store already holds rows
#
#   tools/demo-up            start, seed, record
#   tools/demo-up start      start only
#   tools/demo-up down       stop the demo stack
#   tools/demo-up reset      delete the demo database
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SJEL_ROOT="$(cd "$_here/.." && pwd)"

# Set before paths.sh is sourced — that is the whole override.
export SJEL_OVERLAY_ROOT="$SJEL_ROOT/demo/overlay"
source "$_here/lib/paths.sh"

# The demo's own database file, inside the tree this script already clears per run. Nothing
# else needs configuring: since PRD Q45 (2026-08-27) a capability's store is a path, so the
# demo needs a path rather than a server, a user, a password and a database name. Overridable
# for a caller that wants the file somewhere else, which is what SJEL_DB_PATH already means.
DEMO_STATE="$SJEL_ROOT/demo/state"
DEMO_DB_PATH="${SJEL_DB_PATH:-$DEMO_STATE/axon.db}"

# Which capabilities the demo runs, read from the overlay rather than written twice.
#
# toml_array, not toml_get: toml_get unquotes a SCALAR and leaves an array line otherwise
# untouched, so `capabilities = ["a", "b"]` came back with the key still on the front and the
# word "capabilities" became the first thing this tried to start. Stripping brackets by hand
# was the mistake; toml.sh already has the function for this.
CAPABILITIES="$(toml_array capabilities "$SJEL_MACHINE_TOML")"
[ -n "$CAPABILITIES" ] || { echo "demo-up: no capabilities in $SJEL_MACHINE_TOML" >&2; exit 1; }

# One variable for the whole stack, not one per capability. Every capability resolves its
# store through sjel_config::database_path(), which reads SJEL_DB_PATH first — so this moves
# all of them onto a throwaway database without any of them carrying a demo branch. It used
# to be a loop exporting SJEL_<NAME>_DATABASE_URL, which existed because each capability had
# its own connection string; they share one file now, and cross-capability joins in the
# recorded corpus depend on that being true here too.
export SJEL_DB_PATH="$DEMO_DB_PATH"
# Finance keeps four things outside its database, each behind its own env var, and every one
# of them has to land inside the demo tree rather than in an overlay. Discovered the expensive
# way: a missing journal path is not a startup error, it is a 409 on the first write that
# needs one, six minutes into a CI run. So all of them are set together.
#
#   journal              the plaintext double-entry ledger, in hledger format, that the
#                        finance server parses and appends to itself
#   investment_snapshot  the reviewed holdings document
#   balance_snapshot     manual balances, which no bank export can know
#   obsidian root/dir    the vault tools/demo-seed writes fictional subscription notes into
export SJEL_FINANCE_JOURNAL="$DEMO_STATE/demo.journal"
export SJEL_FINANCE_INVESTMENT_SNAPSHOT="$DEMO_STATE/holdings.json"
export SJEL_FINANCE_BALANCE_SNAPSHOT="$DEMO_STATE/balances.json"
export SJEL_FINANCE_OBSIDIAN_ROOT="$SJEL_ROOT/demo/vault"
export SJEL_FINANCE_OBSIDIAN_DIR="subscriptions"

# The synthetic origin Comms, Scouting and Transit read from. Its address lives in demo.toml
# and is read from there rather than repeated here, so the port stays a one-place fact.
DEMO_ORIGIN="$(bun -e '
  const { loadManifest } = await import(`${process.env.SJEL_ROOT}/tools/lib/demo-endpoints.ts`);
  process.stdout.write(loadManifest().origin);
')"
DEMO_ORIGIN_PID=""

# Transit reads these three instead of bahn.de. Exported before the capability starts, because
# its HafasClient resolves them once at construction — set afterwards they would be ignored and
# the demo would quietly record a live timetable, which is the one thing it must not publish.
export SJEL_TRANSIT_FAHRPLAN_URL="$DEMO_ORIGIN/fahrplan"
export SJEL_TRANSIT_DBNAV_FAHRPLAN_URL="$DEMO_ORIGIN/dbnav/fahrplan"
export SJEL_TRANSIT_ORTE_URL="$DEMO_ORIGIN/orte"

# Scouting's source declaration is generated rather than tracked: it contains the origin's
# address, and that address has an owner already (demo.toml). A tracked copy would be the
# second place the port lives, and the one that silently disagrees. Same status as
# demo/fixtures and demo/state — a build product of the manifest, gitignored.
# Comms disables every mutating route when no api_secret_file is configured, /ingest included,
# so the demo needs one to be seedable at all. Generated per run rather than tracked: a literal
# token in this repository would be a credential in git even though nothing real accepts it, and
# the demo's determinism rule is about the corpus, not about a throwaway header. The value never
# reaches a fixture — it is a request header, and nothing records it.
write_comms_config() {
  local secret_file="$DEMO_STATE/comms-api-secret"
  openssl rand -hex 32 > "$secret_file"
  chmod 600 "$secret_file"
  # Exported for tools/demo-seed, which has to send it. One generator, one reader, no second
  # copy of the path for the two of them to disagree about.
  SJEL_DEMO_COMMS_TOKEN="$(cat "$secret_file")"
  export SJEL_DEMO_COMMS_TOKEN
  # Comms refuses to fetch a URL that resolves inside this machine — an ingested
  # link would otherwise drive any loopback-bound Axon API (Q74, see
  # capabilities/comms/src/media.rs check_destination). Every URL this demo seeds
  # is exactly that, on purpose: the origin is loopback so the published corpus
  # depends on no host anybody else owns. So the demo names its one origin here,
  # read from demo.toml rather than repeated, and the guard stays on for the
  # nine capability ports it does not name.
  cat > "$SJEL_ROOT/demo/overlay/config/comms.json" <<JSON
{
  "_note": "GENERATED by tools/demo-up. Do not edit; the token is regenerated on every run.",
  "api_secret_file": "$secret_file",
  "ingest_allowed_origins": ["$DEMO_ORIGIN"]
}
JSON
}

# Finance's synthetic instruments and target allocations. Generated, gitignored and
# regenerated on every run, for the same reason the two below are: a hand-editable file at
# an overlay config path in the public tree is the one shape where a real ISIN or a real
# allocation gets committed, and tools/check-site-payload.sh matches neither pattern.
#
# The two allocations sum to 10,000 bp on purpose: a cohort that does not add up emits a
# named caveat and no drift proposal at all, so a demo written carelessly would record an
# empty decisions inbox and look like a broken feature.
#
# The three instrument symbols are the CANONICAL names in tools/lib/demo-data.ts's
# `instruments` list, not the broker symbols beside them: the reviewed import resolves
# symbol to canonical through instrument_aliases, so the holdings projection is keyed on
# these. tools/demo-seed.test.ts asserts the two lists agree, because a silent rename here
# would produce a portfolio with three unclassified positions and no drift at all.
write_finance_targets() {
  cat > "$SJEL_ROOT/demo/overlay/config/finance.json" <<JSON
{
  "_note": "GENERATED by tools/demo-up. Do not edit; every value here is synthetic.",
  "instruments": [
    { "instrument": "NORDLYS-BROAD-INDEX", "label": "Nordlys Broad Index", "asset_class": "equity" },
    { "instrument": "TERRAVIA-SUSTAINABLE", "label": "Terravia Sustainable", "asset_class": "equity" },
    { "instrument": "KEYSTONE-SHORT-BOND", "label": "Keystone Short Bond", "asset_class": "bond" }
  ],
  "targets": {
    "currency": "EUR",
    "contribution_floor_cents": 10000,
    "price_freshness_days": 4,
    "allocations": [
      {
        "id": "demo-equity",
        "label": "Demo equity",
        "scope": "asset_class",
        "asset_class": "equity",
        "target_bp": 6000,
        "band_bp": 300,
        "rationale": "Synthetic demo policy.",
        "valid_from": "2020-01-01"
      },
      {
        "id": "demo-bond",
        "label": "Demo bonds",
        "scope": "asset_class",
        "asset_class": "bond",
        "target_bp": 4000,
        "band_bp": 300,
        "rationale": "Synthetic demo policy.",
        "valid_from": "2020-01-01"
      }
    ]
  }
}
JSON
}

write_scouting_source() {
  cat > "$SJEL_ROOT/demo/overlay/config/scouting.json" <<JSON
{
  "_note": "GENERATED by tools/demo-up from demo/demo.toml. Do not edit; edit [demo] origin there.",
  "sources": [
    {
      "id": "demo-origin",
      "adapter": "rss",
      "url": "$DEMO_ORIGIN/feed.xml",
      "doc": "demo/README.md",
      "enabled": true
    }
  ]
}
JSON
}

start_origin() {
  if occupied "${DEMO_ORIGIN##*:}"; then
    echo "demo-up: something already listens on the demo origin's port (${DEMO_ORIGIN##*:})" >&2
    exit 1
  fi
  # Output redirected and stdin closed, not inherited. A background child holding this
  # script's stdout open keeps the pipe alive after the script itself is done, so `demo-up
  # start` never appears to finish to anything reading it — a caller waits on a job that has
  # nothing left to say. Cost one ten-minute timeout to find.
  "$_here/demo-origin" >"$DEMO_STATE/origin.log" 2>&1 </dev/null &
  DEMO_ORIGIN_PID=$!
  # Three capabilities fetch from this during seeding and recording. Starting them against an
  # origin that is not up yet fails as an empty feed, which reads like a broken adapter.
  local waited=0
  until curl -fsS -o /dev/null "$DEMO_ORIGIN/health" 2>/dev/null; do
    waited=$((waited + 1))
    [ "$waited" -lt 40 ] || { echo "demo-up: demo-origin never answered on $DEMO_ORIGIN" >&2; exit 1; }
    sleep 0.25
  done
  echo "demo-up: origin on $DEMO_ORIGIN"
}

stop_origin() {
  if [ -n "$DEMO_ORIGIN_PID" ]; then
    kill "$DEMO_ORIGIN_PID" 2>/dev/null || true
    wait "$DEMO_ORIGIN_PID" 2>/dev/null || true
    DEMO_ORIGIN_PID=""
    return 0
  fi
  # `demo-up down` is usually a different shell from the one that ran `start`, so there is no
  # pid to remember. Ask the port instead — the same question refuse_if_running asks, and the
  # only one that survives across invocations.
  # `|| true` inside the substitution, not after it. With `set -e` an assignment takes the
  # command's exit status, and lsof exits non-zero when nothing is listening — which is the
  # ordinary case for `down`. Without this the whole script aborted right here and stopped
  # none of the capabilities, silently, because the origin happened to be down already.
  local pid
  pid="$(lsof -nP -iTCP:"${DEMO_ORIGIN##*:}" -sTCP:LISTEN -t 2>/dev/null | head -1 || true)"
  [ -n "$pid" ] || return 0
  kill "$pid" 2>/dev/null || true
}

occupied() {  # occupied <port> — something is already listening
  [ -n "$1" ] || return 1
  # -sTCP:LISTEN rather than a connect attempt: a connect would also succeed against a
  # half-open socket somewhere else on the network, and this question is about this host.
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# Exits non-zero on a name the registry does not know, rather than answering "" — an empty
# port makes occupied() false, which turns a bogus capability name into a silently skipped
# collision check. That is exactly how a parsing bug in CAPABILITIES above survived a local
# run of the guard: the guard reported the right five and said nothing about the sixth.
port_of() {  # port_of <capability>
  bun -e '
    const { registry } = await import(`${process.env.SJEL_ROOT}/tools/lib/demo-endpoints.ts`);
    const hit = registry().find((s) => s.name === process.argv[1]);
    if (!hit) {
      console.error(`demo-up: no capability named ${process.argv[1]} in the registry`);
      process.exit(1);
    }
    process.stdout.write(hit.port);
  ' "$1"
}

refuse_if_running() {
  local busy="" cap port
  for cap in $CAPABILITIES; do
    port="$(port_of "$cap")"
    if occupied "$port"; then busy="$busy  $cap (port $port)\n"; fi
  done
  [ -n "$busy" ] || return 0
  {
    echo "demo-up: something is already listening on the demo's ports:"
    echo ""
    printf "%b" "$busy"
    echo "The demo runs on the same ports a real installation does, so it cannot start"
    echo "alongside one — and starting anyway would let the seeder write into whatever is"
    echo "actually running there. Stop your stack first:"
    echo ""
    echo "  tools/service-runner.sh down"
    echo ""
  } >&2
  exit 1
}

# Deleting the file IS dropping the database. The sidecars go with it: a -wal left beside a
# deleted database is the next run's first write replayed into a file that no longer explains
# it. `start` clears the whole demo/state tree anyway, so this exists for the operator who
# wants the database gone without a restart.
reset_database() {
  rm -f "$DEMO_DB_PATH" "$DEMO_DB_PATH-wal" "$DEMO_DB_PATH-shm"
  echo "demo-up: deleted $DEMO_DB_PATH"
}

start_stack() {
  refuse_if_running
  # Cleared, not reused. A journal left over from a previous run would be appended to, and the
  # demo's whole claim is that its numbers descend from one fixed seed. Ahead of the origin
  # rather than after it, because the origin logs in here.
  rm -rf "$DEMO_STATE"
  mkdir -p "$DEMO_STATE"
  write_scouting_source
  write_comms_config
  write_finance_targets
  start_origin
  : > "$SJEL_FINANCE_JOURNAL"
  local cap
  for cap in $CAPABILITIES; do
    echo "demo-up: starting $cap"
    "$_here/service-runner.sh" start "$cap"
  done
}

stop_stack() {
  stop_origin
  local cap
  for cap in $CAPABILITIES; do
    "$_here/service-runner.sh" stop "$cap" --no-hold || true
  done
}

case "${1:-all}" in
  start)
    start_stack
    # `start` is the "leave it up so I can poke at it" path, so the origin stays too — three
    # capabilities are useless without it. Named rather than silent: it is a listener the
    # service runner does not know about, and `demo-up down` is what clears it.
    echo "demo-up: origin still listening on $DEMO_ORIGIN (pid $DEMO_ORIGIN_PID) — 'demo-up down' stops it"
    ;;
  down)  stop_stack ;;
  reset) reset_database ;;
  all)
    start_stack
    # The origin is a child of this shell, so it dies with it either way. Trapped anyway:
    # a seeding failure between here and the end would otherwise leave it listening, and the
    # next run's port check would refuse to start against its own leftover.
    trap stop_origin EXIT
    "$_here/demo-seed"
    "$_here/demo-record"
    stop_origin
    ;;
  *)
    echo "usage: demo-up [all|start|down|reset]" >&2
    exit 1
    ;;
esac
