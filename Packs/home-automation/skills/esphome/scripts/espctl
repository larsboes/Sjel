#!/usr/bin/env python3
"""espctl — build & OTA-flash ESPHome nodes via the `esphome` Docker container.

Node builds/flashes go through the container's own `esphome` CLI over SSH; the
ESPHome dashboard is polled directly for a quick reachability check. Node YAMLs
live on the host under the directory bind-mounted to /config in the container.

This skill has no secret: it reaches the container over SSH with key auth, not a
password. All connection facts are non-secret and come from the committed overlay
config (<overlay>/config/home-assistant.vars): ESPHOME_SSH (an ssh target such
as user@host), ESPHOME_URL (the dashboard base URL, e.g. http://host:6052), and
ESPHOME_CONTAINER (the container name). Any of these can be overridden per-run via
the matching $ESPHOME_* env var (env wins over the config file). The in-container
config dir is /config. See SKILL.md.

Commands:
  version              dashboard version (quick reachability check)
  nodes                list configured node YAMLs in the container
  logs NODE            stream a node's logs (Ctrl-C to stop)
  compile NODE         compile NODE.yaml (no flash)
  upload NODE          compile + OTA-flash NODE.yaml over WiFi
  run NODE             compile + upload + tail logs (esphome run)
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# Intentional cross-overlay reach: this administers the FAMILY home-assistant deployment,
# whose config lives in the axon-overlay overlay — which is not necessarily this machine's
# own active overlay. So it deliberately does NOT go through tools/lib/paths.sh /
# SJEL_PERSONAL_ROOT (that resolves only the active overlay); it reads axon-overlay directly
# via its own SJEL_HOME_ROOT env var. See CONTRIBUTING.md#public-core-and-private-overlays (three recognized overlays).
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"
CONFIG_DIR = "/config"


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg: str) -> None:
    print(f"espctl: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _http_base_url(raw: str, label: str) -> str:
    value = raw.strip().rstrip("/")
    parsed = urllib.parse.urlparse(value)
    if (parsed.scheme not in ("http", "https") or not parsed.hostname
            or parsed.username is not None or parsed.password is not None):
        die(f"{label} must be an http(s) URL with a host and no embedded credentials")
    return value


def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def conn() -> dict:
    """Resolve non-secret connection facts from the committed overlay ($ESPHOME_* env wins)."""
    keys = ("ESPHOME_SSH", "ESPHOME_URL", "ESPHOME_CONTAINER")
    env = {k: os.environ.get(k) for k in keys}
    need = [k for k in keys if not env[k]]
    vals = dict(zip(need, cfg(*need))) if need else {}
    return {k: env[k] or vals[k] for k in keys}


def _node_yaml(n: str) -> str:
    return n if n.endswith(".yaml") else f"{n}.yaml"


def _ssh_base(ssh_target: str, stream: bool) -> list:
    cmd = ["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
    if stream:
        cmd += ["-t"]
    return cmd + [ssh_target]


def docker_esphome(ssh_target: str, container: str, args: str, stream: bool = False):
    """Run `esphome ARGS` inside the container on the host over SSH."""
    cmd = _ssh_base(ssh_target, stream) + [f"docker exec {container} esphome {args}"]
    if stream:
        return subprocess.call(cmd)
    return subprocess.run(cmd, capture_output=True, text=True, timeout=900)


def cmd_version(args) -> int:
    url = _http_base_url(conn()["ESPHOME_URL"], "ESPHOME_URL")
    try:
        # The operator-owned base URL is constrained above; LAN/Tailnet hosts stay valid.
        with urllib.request.urlopen(f"{url}/version", timeout=6) as r:  # nosemgrep: python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected
            print("dashboard:", json.loads(r.read().decode()).get("version"))
    except (urllib.error.URLError, OSError) as e:
        die(f"esphome dashboard unreachable at {url}: {e}")
    return 0


def cmd_nodes(args) -> int:
    c = conn()
    cmd = _ssh_base(c["ESPHOME_SSH"], stream=False) + [
        f"docker exec {c['ESPHOME_CONTAINER']} sh -c 'ls {CONFIG_DIR}/*.yaml 2>/dev/null'"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    ys = [os.path.basename(x) for x in r.stdout.split()
          if x.endswith(".yaml") and not os.path.basename(x).startswith("secrets")]
    if not ys:
        print("(no node YAMLs yet — add one to the host's esphome config dir and sync it)")
        return 0
    for y in ys:
        print("  " + y)
    return 0


def cmd_logs(args) -> int:
    c = conn()
    return docker_esphome(c["ESPHOME_SSH"], c["ESPHOME_CONTAINER"],
                          f"logs {CONFIG_DIR}/{_node_yaml(args.node)}", stream=True)


def cmd_compile(args) -> int:
    c = conn()
    r = docker_esphome(c["ESPHOME_SSH"], c["ESPHOME_CONTAINER"],
                       f"compile {CONFIG_DIR}/{_node_yaml(args.node)}")
    sys.stdout.write(r.stdout[-2000:])
    if r.returncode != 0 and r.stderr:
        sys.stderr.write(r.stderr[-2000:])
    return r.returncode


def cmd_upload(args) -> int:
    c = conn()
    r = docker_esphome(c["ESPHOME_SSH"], c["ESPHOME_CONTAINER"],
                       f"upload {CONFIG_DIR}/{_node_yaml(args.node)}")
    sys.stdout.write(r.stdout[-2000:])
    if r.returncode != 0 and r.stderr:
        sys.stderr.write(r.stderr[-2000:])
    return r.returncode


def cmd_run(args) -> int:
    c = conn()
    return docker_esphome(c["ESPHOME_SSH"], c["ESPHOME_CONTAINER"],
                          f"run {CONFIG_DIR}/{_node_yaml(args.node)}", stream=True)


def main() -> int:
    p = argparse.ArgumentParser(
        prog="espctl",
        description="Build & OTA-flash ESPHome nodes via the esphome Docker container over SSH.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("version", help="dashboard version (reachability check)").set_defaults(fn=cmd_version)
    sub.add_parser("nodes", help="list configured node YAMLs").set_defaults(fn=cmd_nodes)

    for name, fn, helptext in (
        ("logs", cmd_logs, "stream a node's logs (Ctrl-C to stop)"),
        ("compile", cmd_compile, "compile NODE.yaml (no flash)"),
        ("upload", cmd_upload, "compile + OTA-flash NODE.yaml over WiFi"),
        ("run", cmd_run, "compile + upload + tail logs"),
    ):
        sp = sub.add_parser(name, help=helptext)
        sp.add_argument("node", help="node name (with or without .yaml)")
        sp.set_defaults(fn=fn)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:  # ssh/docker/urllib errors surface here
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
