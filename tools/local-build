#!/bin/bash
# tools/local-build — check admission or run an explicit build with battery defaults.
set -u
_here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=lib/local-build.sh
. "$_here/lib/local-build.sh"
if [ "${1:-}" = run ]; then
  shift
  [ "$#" -gt 0 ] || { echo "Usage: tools/local-build run <command> [args...]" >&2; exit 2; }
  local_build_prepare || exit $?
  exec "$@"
fi
[ "$#" -eq 0 ] || { echo "Usage: tools/local-build [run <command> [args...]]" >&2; exit 2; }
local_build_check
