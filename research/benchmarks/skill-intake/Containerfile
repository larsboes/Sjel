FROM golang:1.27.3@sha256:e519d3b0a5b285e5aa53ab9eef02bc6bbb9cb04608389b743a136a9ce75f0d1e AS go
FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
COPY --from=go /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv
ENV PATH="/usr/local/go/bin:/opt/scanner/.venv/bin:$PATH"
ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
WORKDIR /opt/scanner
COPY scanner/ .
RUN uv sync --frozen --no-dev --no-default-groups --no-editable
COPY runner.py /opt/runner.py
USER 65534:65534
ENV HOME=/tmp
ENTRYPOINT ["python", "/opt/runner.py"]
