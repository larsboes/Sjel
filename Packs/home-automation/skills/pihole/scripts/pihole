#!/usr/bin/env python3
"""pihole — Pi-hole v6 REST API client (pure Python 3 stdlib, no deps).

Pi-hole is a home DNS resolver + egress log + ad/tracker blocker. This wraps the
v6 REST API for status, per-device egress queries, top lists, and block control.

Split source of truth: the non-secret connection fact (PIHOLE_HOST) comes from the committed
overlay config (<overlay>/config/home-assistant.vars). The secret (PIHOLE_PASSWORD) comes from
Bitwarden at runtime — never hardcoded, never printed. Requires an unlocked Bitwarden session in
$BW_SESSION (the user unlocks interactively; this tool never sees the master password). See SKILL.md.

  PIHOLE_HOST      base URL / host of the Pi-hole (scheme optional; :port allowed) — from home-assistant.vars
  PIHOLE_PASSWORD  the admin/API password — from Bitwarden

Commands:
  status              queries/blocked today, active clients, blocking on/off
  top-domains [N]     most-queried allowed domains (default 20)
  top-blocked [N]     most-blocked domains (default 20)
  top-clients [N]     busiest clients — per-device query volume (default 20)
  egress IP [N]       recent domains one device queried — what it phones home to (default 100)
  recent [N]          recent queries across all clients (default 50)
  block-off [SECS]    pause blocking (default 300s; 0 = until block-on)
  block-on            resume blocking
  deny DOMAIN         add an exact deny (block this domain network-wide)
  allow DOMAIN        add an exact allow (whitelist)
"""
# `str | None` in a signature is evaluated at def time on 3.9 (macOS stock python3),
# which is what this ships against. Lazy annotations keep the modern syntax readable
# without pinning an interpreter — this file's contract is stdlib-only, no deps.
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BW_ITEM = os.environ.get("PIHOLE_BW_ITEM", "home-assistant/pihole")
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"

_CREDS = None
_SID = None


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg: str, code: int = 1) -> None:
    print(f"pihole: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _http_base_url(raw: str, label: str, default_scheme: str | None = None) -> str:
    value = raw.strip().rstrip("/")
    if default_scheme and "://" not in value:
        value = f"{default_scheme}://{value}"
    parsed = urllib.parse.urlparse(value)
    if (parsed.scheme not in ("http", "https") or not parsed.hostname
            or parsed.username is not None or parsed.password is not None):
        die(f"{label} must be an http(s) URL with a host and no embedded credentials")
    return value


def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def bw_secret(field: str) -> str:
    """Fetch a single secret field from the Bitwarden item. Never prints the value."""
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool).")
    r = subprocess.run(["bw", "get", "item", BW_ITEM, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {BW_ITEM}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION passes the presence check above and `bw` still exits 0, printing a
    # plain-text complaint instead of JSON — so the parse, not the return code, is where a
    # locked vault actually surfaces. Say so, instead of raising JSONDecodeError at the caller.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {BW_ITEM}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in item.get("fields", [])}
    if not fields.get(field):
        die(f"bw item '{BW_ITEM}' is missing secret field: {field}")
    return fields[field]


def bw_creds() -> dict:
    """Compose creds: non-secret host from the committed overlay config, password from Bitwarden.
    Secret values never touch stdout/stderr. Assumes `bw config server` was set once already."""
    global _CREDS
    if _CREDS is not None:
        return _CREDS
    (host,) = cfg("PIHOLE_HOST")
    _CREDS = {"PIHOLE_HOST": host, "PIHOLE_PASSWORD": bw_secret("PIHOLE_PASSWORD")}
    return _CREDS


def base_url() -> str:
    return _http_base_url(bw_creds()["PIHOLE_HOST"], "PIHOLE_HOST", default_scheme="http")


def _req(path, method="GET", payload=None, auth=True):
    url = f"{base_url()}/api/{path.lstrip('/')}"
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if auth:
        req.add_header("X-FTL-SID", sid())
    try:
        # PIHOLE_HOST is operator-owned and constrained before request construction.
        with urllib.request.urlopen(req, timeout=12) as resp:  # nosemgrep: python.lang.security.audit.dynamic-urllib-use-detected.dynamic-urllib-use-detected
            body = resp.read().decode()
            return json.loads(body) if body.strip() else {}
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code} {path}: {e.read().decode()[:200]}")
    except urllib.error.URLError as e:
        die(f"cannot reach Pi-hole at {base_url()}: {e.reason} (is the container up?)")


def sid() -> str:
    global _SID
    if _SID:
        return _SID
    pw = bw_creds()["PIHOLE_PASSWORD"]
    r = _req("auth", method="POST", payload={"password": pw}, auth=False)
    s = r.get("session") or {}
    if not s.get("valid"):
        die("Pi-hole auth failed — wrong PIHOLE_PASSWORD in the bw item?")
    _SID = s.get("sid")
    return _SID


def cmd_status(args) -> int:
    s = _req("stats/summary")
    q = s.get("queries", {})
    print(f"queries today:  {q.get('total','?')}")
    print(f"blocked:        {q.get('blocked','?')} ({q.get('percent_blocked','?')}%)")
    print(f"unique domains: {q.get('unique_domains','?')}")
    print(f"active clients: {(s.get('clients') or {}).get('active','?')}")
    b = _req("dns/blocking")
    print(f"blocking:       {b.get('blocking','?')}")
    return 0


def _print_top(rows) -> None:
    for it in rows:
        label = it.get("domain") or it.get("ip") or it.get("name", "")
        print(f"  {it.get('count', 0):6} {label}")


def cmd_top_domains(args) -> int:
    _print_top(_req(f"stats/top_domains?count={args.n}").get("domains", []))
    return 0


def cmd_top_blocked(args) -> int:
    _print_top(_req(f"stats/top_domains?blocked=true&count={args.n}").get("domains", []))
    return 0


def cmd_top_clients(args) -> int:
    _print_top(_req(f"stats/top_clients?count={args.n}").get("clients", []))
    return 0


def _print_queries(rows) -> None:
    for it in rows:
        dom = it.get("domain", "?")
        cli = (it.get("client") or {}).get("ip", "?")
        st = it.get("status", "")
        print(f"  {cli:16} {st:14} {dom}")


def cmd_egress(args) -> int:
    r = _req(f"queries?length={args.n}&client_ip={args.ip}")
    rows = r.get("queries", [])
    print(f"{len(rows)} recent queries from {args.ip}:")
    _print_queries(rows)
    return 0


def cmd_recent(args) -> int:
    _print_queries(_req(f"queries?length={args.n}").get("queries", []))
    return 0


def cmd_block_off(args) -> int:
    secs = args.secs
    _req("dns/blocking", method="POST", payload={"blocking": False, "timer": secs or None})
    print(f"blocking paused for {secs}s" if secs else "blocking paused (until block-on)")
    return 0


def cmd_block_on(args) -> int:
    _req("dns/blocking", method="POST", payload={"blocking": True, "timer": None})
    print("blocking resumed")
    return 0


def cmd_deny(args) -> int:
    _req("domains/deny/exact", method="POST", payload={"domain": args.domain})
    print(f"deny added: {args.domain}")
    return 0


def cmd_allow(args) -> int:
    _req("domains/allow/exact", method="POST", payload={"domain": args.domain})
    print(f"allow added: {args.domain}")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="pihole",
        description="Pi-hole v6 REST API client — DNS stats, per-device egress, block control.")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="queries/blocked today, active clients, blocking state") \
        .set_defaults(fn=cmd_status)

    td = sub.add_parser("top-domains", help="most-queried allowed domains")
    td.add_argument("n", nargs="?", type=int, default=20, help="rows (default 20)")
    td.set_defaults(fn=cmd_top_domains)

    tb = sub.add_parser("top-blocked", help="most-blocked domains")
    tb.add_argument("n", nargs="?", type=int, default=20, help="rows (default 20)")
    tb.set_defaults(fn=cmd_top_blocked)

    tc = sub.add_parser("top-clients", help="busiest clients (per-device query volume)")
    tc.add_argument("n", nargs="?", type=int, default=20, help="rows (default 20)")
    tc.set_defaults(fn=cmd_top_clients)

    eg = sub.add_parser("egress", help="recent domains one device queried (what it phones home to)")
    eg.add_argument("ip", help="device IP")
    eg.add_argument("n", nargs="?", type=int, default=100, help="rows (default 100)")
    eg.set_defaults(fn=cmd_egress)

    rc = sub.add_parser("recent", help="recent queries across all clients")
    rc.add_argument("n", nargs="?", type=int, default=50, help="rows (default 50)")
    rc.set_defaults(fn=cmd_recent)

    bo = sub.add_parser("block-off", help="pause blocking (default 300s; 0 = until block-on)")
    bo.add_argument("secs", nargs="?", type=int, default=300, help="seconds (default 300)")
    bo.set_defaults(fn=cmd_block_off)

    sub.add_parser("block-on", help="resume blocking").set_defaults(fn=cmd_block_on)

    dn = sub.add_parser("deny", help="add an exact deny (block this domain network-wide)")
    dn.add_argument("domain", help="domain to block")
    dn.set_defaults(fn=cmd_deny)

    al = sub.add_parser("allow", help="add an exact allow (whitelist)")
    al.add_argument("domain", help="domain to allow")
    al.set_defaults(fn=cmd_allow)

    args = p.parse_args()
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as e:  # network / JSON / API errors surface here
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
