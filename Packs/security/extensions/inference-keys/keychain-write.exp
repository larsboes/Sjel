#!/usr/bin/expect -f
#
# Write one secret into the login keychain without ever putting it in argv.
#
# `security add-generic-password -w` typed as the last option prompts twice on the
# TTY and ignores stdin, so the value cannot simply be piped in. Passing it as
# `-w <value>` instead would expose it to every process running as this user,
# because argv is world-readable via ps(1) for the lifetime of the call. So the
# value arrives here over stdin, is held in an expect variable, and is typed into
# the prompt by expect's pty.
#
# log_user 0 is not decoration: expect echoes the pty by default, and the whole
# point is that the secret never reaches stdout or a transcript.
#
# usage: <producer> | keychain-write.exp <service> <account>
#        exits 0 on success, 2 on empty stdin, 3 if the two prompts disagreed.

set timeout 30
log_user 0

set service [lindex $argv 0]
set account [lindex $argv 1]

if {[gets stdin secret] < 0 || $secret eq ""} {
    send_user "keychain-write: nothing on stdin; refusing to write an empty item\n"
    exit 2
}

# -U updates in place, so re-running the migration is idempotent rather than
# failing on an item that already exists.
spawn security add-generic-password -s $service -a $account -U -w
# The two prompts are not the same wording, which is easy to get wrong:
#   password data for new item:
#   retype password for new item:
# so the pattern matches the tail they share. A pattern anchored on the first
# wording alone matches prompt one and then sits until the timeout on prompt two.
expect {
    -re "for new item:" {
        send "$secret\r"
        exp_continue
    }
    "passwords don't match" {
        send_user "keychain-write: the two prompts did not match; nothing written\n"
        exit 3
    }
    eof
}

catch wait result
exit [lindex $result 3]
