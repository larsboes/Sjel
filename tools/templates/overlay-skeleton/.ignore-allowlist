# sjel-__OVERLAY_NAME__ — the reviewed allowlist. THIS is the file you edit.
#
# Everything is denied by default. Each line here un-ignores something you have looked at and
# decided is safe to track. Sjel's immutable hard blocks are appended below whatever you write,
# so a secret-shaped file stays out even if a line here would have let it in.
#
# After editing:  tools/ignore-policy render <this overlay>
# To verify:      tools/ignore-policy check  <this overlay>
#
# Never un-ignore a file that contains a real secret value.

# config/ — structure ONLY (never machine.toml, *.env, secrets.zsh, machine.zsh)
# No machine.toml.example here on purpose: the schema has exactly one home, Sjel's
# schemas/machine.toml.example. tools/install.sh writes a real machine.toml from detected
# values, so an overlay never needs an example of a file it already carries for real.
!/config/
/config/*
!/config/.gitkeep
!/config/shell/
/config/shell/*
!/config/shell/.gitkeep

# config/claude-code/ — the managed-policy fragment IS tracked, deliberately.
# It is the one config file here that must survive to a second machine: it carries this
# boundary's credential env var NAMES so `claude-code-config --managed` can deny them, and an
# untracked copy would silently not exist on the next node. Names and paths only — never a
# secret VALUE (Rule 13). The hard blocks still override if anything *secret*/*credential*/*.env
# ever lands in this directory.
!/config/claude-code/
/config/claude-code/*
!/config/claude-code/managed-settings.fragment.json
!/config/claude-code/managed-settings.fragment.json.example

# empty skeleton dirs — keep the placeholder, not the contents
!/memory/
/memory/*
!/memory/.gitkeep
!/plugins/
/plugins/*
!/plugins/.gitkeep
!/skills/
/skills/*
!/skills/.gitkeep
!/secrets/
/secrets/*
!/secrets/.gitkeep
!/documents/
/documents/*
!/documents/.gitkeep

# resources/backups/ — versioned on purpose (identity mirrors, staged artifacts).
# No secrets live here; the hard blocks still override for any *.env / *secret* / *credential*
# / *.token / .DS_Store that ever lands inside.
!/resources/
/resources/*
!/resources/backups/
!/resources/backups/**
