#!/usr/bin/env python3
"""wlanwatch — catch an intermittent WLAN fault in the act (macOS client side).

Spot checks cannot diagnose "it drops all the time": the interesting moment is exactly the one
you are not looking at. This runs until stopped and writes one timeline that the client link
and the router's own event log can both be read against.

Design note, learned the hard way. The obvious sampler — poll `system_profiler SPAirPortDataType`
every few seconds — does not work: that call takes ~13 s because it scans the whole RF
environment, so it would sleep through every drop shorter than its own runtime. Detection is
therefore driven by a 2 s gateway ping, which is instant; the expensive link snapshot runs on a
slow cadence AND is triggered immediately whenever the ping state flips, so a drop is both
noticed at once and described.

Streams, all into one tab-separated append-only file (safe to `tail -f`):
  PING   every PING_S    — one packet to the gateway; the drop detector
  LINK   every LINK_S    — band/channel/width/RSSI/noise/MCS/rate/PHY
  EVENT  on change       — loss started/ended, disconnect, band switch, channel change, RSSI collapse
  BOX    every BOXLOG_S  — new Fritz!Box event-log lines (needs $BW_SESSION; skipped without)

Usage:
    export BW_SESSION=$(bw unlock --raw)          # optional; enables the BOX stream
    scripts/wlanwatch ~/wlanwatch-$(date +%F).tsv

Write the output somewhere durable. A session scratchpad is not durable: one run of this tool
lost its whole capture that way.
"""
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/wlanwatch.tsv")
def _default_gateway():
    """The gateway to probe: $GATEWAY, else whatever the system actually routes through.
    Never a hardcoded address — this pack keeps house facts out of Axon."""
    if os.environ.get("GATEWAY"):
        return os.environ["GATEWAY"]
    try:
        out = subprocess.run(["route", "-n", "get", "default"],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"gateway:\s*(\S+)", out)
        if m:
            return m.group(1)
    except Exception:
        pass
    sys.exit("wlanwatch: no default gateway found — set $GATEWAY explicitly.")


GATEWAY = _default_gateway()
# The sibling `fritz` skill is found relative to this file rather than through
# a hardcoded checkout location. `.resolve()` also sees through the symlink that
# packs.sh plants in ~/.claude/skills.
FRITZ = os.environ.get(
    "FRITZ_BIN",
    str(Path(__file__).resolve().parents[2] / "fritz" / "scripts" / "fritz"))
PING_S = float(os.environ.get("PING_S", "2"))
LINK_S = float(os.environ.get("LINK_S", "60"))
BOXLOG_S = float(os.environ.get("BOXLOG_S", "60"))


def emit(kind, msg):
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\t{kind}\t{msg}"
    with open(OUT, "a") as f:
        f.write(line + "\n")
    print(line, flush=True)


def link():
    """Current association. Slow (~13 s) — call sparingly. Empty dict when not associated."""
    try:
        out = subprocess.run(["system_profiler", "SPAirPortDataType"],
                             capture_output=True, text=True, timeout=40).stdout
    except Exception:
        return {}
    parts = out.split("Current Network Information:")
    if len(parts) < 2:
        return {}
    b = parts[1].split("Other Local Wi-Fi Networks")[0]
    g = lambda p: (re.search(p, b) or [None, None])[1]
    ch = re.search(r"Channel:\s*(\d+)\s*\((\d)GHz,\s*(\d+)MHz\)", b)
    sig = re.search(r"Signal / Noise:\s*(-?\d+)\s*dBm\s*/\s*(-?\d+)\s*dBm", b)
    return {"phy": g(r"PHY Mode:\s*(\S+)"),
            "channel": ch.group(1) if ch else None,
            "band": ch.group(2) + "GHz" if ch else None,
            "width": ch.group(3) if ch else None,
            "rssi": int(sig.group(1)) if sig else None,
            "noise": int(sig.group(2)) if sig else None,
            "rate": g(r"Transmit Rate:\s*(\d+)"),
            "mcs": g(r"MCS Index:\s*(\d+)")}


def describe(d):
    if not d.get("band"):
        return "not associated"
    return (f"{d['band']} ch{d['channel']} {d['width']}MHz {d['rssi']}dBm "
            f"noise={d['noise']} MCS{d['mcs']} {d['rate']}Mb {d['phy']}")


def ping_ms():
    try:
        out = subprocess.run(["ping", "-c", "1", "-W", "1500", GATEWAY],
                             capture_output=True, text=True, timeout=5).stdout
        m = re.search(r"time=([\d.]+)", out)
        return float(m.group(1)) if m else None
    except Exception:
        return None


def box_log():
    """New lines from the router's event log. Silent no-op without credentials."""
    if not os.environ.get("BW_SESSION") or not os.path.exists(FRITZ):
        return []
    try:
        r = subprocess.run([FRITZ, "log", "--json"], capture_output=True, text=True, timeout=60)
        if r.returncode != 0:
            return []
        return [f"{e.get('date','')} {e.get('time','')} {e.get('msg','')}"
                for e in json.loads(r.stdout) if isinstance(e, dict)]
    except Exception:
        return []


def main():
    emit("START", f"gateway={GATEWAY} ping={PING_S}s link={LINK_S}s boxlog={BOXLOG_S}s out={OUT}")
    seen = set(box_log())          # prime, so the existing log is not replayed as new
    cur = link()
    emit("LINK", describe(cur))
    prev, losing, loss_start = cur, False, 0.0
    next_link, next_box = time.time() + LINK_S, time.time() + BOXLOG_S
    while True:
        rtt = ping_ms()
        forced = False
        if rtt is None and not losing:
            losing, loss_start = True, time.time()
            emit("EVENT", "LOSS STARTED — gateway not answering")
            forced = True
        elif rtt is not None and losing:
            emit("EVENT", f"LOSS ENDED after {time.time() - loss_start:.0f}s")
            losing, forced = False, True
        else:
            emit("PING", "LOSS" if rtt is None else f"{rtt:.1f}ms")

        if forced or time.time() >= next_link:
            next_link = time.time() + LINK_S
            cur = link()
            if not cur.get("band") and prev.get("band"):
                emit("EVENT", "DISCONNECTED — no association")
            elif cur.get("band") and not prev.get("band"):
                emit("EVENT", f"ASSOCIATED {describe(cur)}")
            elif cur.get("band") and prev.get("band"):
                if cur["band"] != prev["band"]:
                    emit("EVENT", f"BAND SWITCH {prev['band']} ch{prev['channel']} -> "
                                  f"{cur['band']} ch{cur['channel']} "
                                  f"({prev['rssi']} -> {cur['rssi']} dBm)")
                elif cur["channel"] != prev["channel"]:
                    emit("EVENT", f"CHANNEL CHANGE ch{prev['channel']} -> ch{cur['channel']}")
                elif (cur.get("rssi") is not None and prev.get("rssi") is not None
                      and cur["rssi"] - prev["rssi"] <= -12):
                    emit("EVENT", f"RSSI COLLAPSE {prev['rssi']} -> {cur['rssi']} dBm")
            emit("LINK", describe(cur))
            prev = cur

        if time.time() >= next_box:
            next_box = time.time() + BOXLOG_S
            for e in box_log():
                if e not in seen:
                    seen.add(e)
                    emit("BOX", e)
        time.sleep(PING_S)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        emit("STOP", "interrupted")
