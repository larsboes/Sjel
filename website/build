#!/usr/bin/env bash
# tools/build-site — assemble the public site.
#
#   site/
#     index.html          tools/generate-landing — what Sjel is, how it fits, the way into the docs
#     docs/               tools/generate-docs and tools/generate-site — reference pages, self-model
#     favicon.svg, hedgehog.png
#
# Reads only tracked files, so it needs no running capability. The payload gate at the end is
# not optional: nothing here uploads, so refusing to leave the bytes behind is the last check.
#
#   tools/build-site                 build into site/
#   tools/build-site --out <dir>
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SJEL_ROOT="$(cd "$_here/.." && pwd)"

OUT="$SJEL_ROOT/site"
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    -h|--help) echo "usage: build-site [--out <dir>]"; exit 0 ;;
    *) echo "build-site: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

rm -rf "$OUT"
mkdir -p "$OUT"

echo "build-site: landing page"
bun "$_here/generate-landing.ts" --out "$OUT"
cp "$_here/lib/site-favicon.svg" "$OUT/favicon.svg"
cp "$SJEL_ROOT/.github/assets/sjel-hedgehog.png" "$OUT/hedgehog.png"

echo "build-site: reference pages"
# No recording: the reference pages describe each unit's declared contract.
"$_here/generate-docs" --out "$OUT/docs" --fixtures "$OUT/.no-recording"

echo "build-site: self-model page"
"$_here/generate-site" --out "$OUT/docs" --name self-model.html

# GitHub Pages runs Jekyll unless told not to, and Jekyll drops directories that begin with `_`.
touch "$OUT/.nojekyll"

echo "build-site: hygiene gate"
"$_here/check-site-payload.sh" "$OUT"

echo "build-site: $(du -sh "$OUT" | cut -f1) in $OUT"
