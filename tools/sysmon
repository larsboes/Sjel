#!/bin/bash
# tools/sysmon — system resource overview. Adopted, not built (CONTRIBUTING.md#upstream-first):
# a thin launcher over two pinned upstreams
# (upstreams.toml: bottom, macmon), plus a report mode built from plain macOS commands
# since neither TUI has a non-interactive one-shot output.
#
#   tools/sysmon              interactive TUI (bottom/btm) -- CPU/mem/disk/net/proc, history graphs
#   tools/sysmon power         Apple Silicon power/thermal TUI (macmon) -- GPU/ANE, package power,
#                               thermal pressure. arm64 only.
#   tools/sysmon report        one-shot text snapshot (load, top CPU/mem, memory, swap, disk) --
#                               for cron, hooks, or piping into a notification
#   tools/sysmon storage       what is filling the disk and what is reclaimable --
#                               delegates to tools/storage/storage, which reads the overlay's
#                               storage-policy.toml. `report` answers "am I full",
#                               this answers "what is filling me".
#   tools/sysmon -h            this help
#
# Neither binary is installed by this script. Install the latest release (Q77, 2026-09-02 --
# upstreams.toml records no version, and toolchain.toml's min_version is a floor, not a target):
#   cargo install bottom --locked
#   cargo install macmon --locked
# bash 3.2-safe.
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"   # SJEL_ROOT, SJEL_PERSONAL_ROOT, toml_*

HELP="tools/sysmon — system resource overview.

  tools/sysmon              interactive TUI (bottom) — CPU/mem/disk/net/proc
  tools/sysmon power         Apple Silicon power/thermal TUI (macmon), arm64 only
  tools/sysmon report        one-shot text snapshot — verdict, load, top CPU/mem, memory, swap, disk
  tools/sysmon storage       what is filling the disk and what is reclaimable
  tools/sysmon -h            this help
"

# The advice names no version. It read upstreams.toml `pin` until 2026-09-02 (Q77), which
# told an operator to install a release older than the one cargo would have given them.
need_bin() {  # need_bin <bin-on-PATH> <crate-name>
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "sysmon: '$1' not installed. Run: cargo install $2 --locked" >&2
    exit 1
  fi
}

# The four sections below answer "what are the numbers". None answered "which of these is the
# problem", which is the question somebody with a slow Mac is actually asking, and answering it
# by hand means knowing to run storage, host-watch and macmon as well. This ranks them.
#
# Disk is ranked first because it is the only one of the three with a command that changes it,
# and because a nearly-full APFS volume slows everything else rather than only itself.
#
# Nothing here measures anything the sections below do not: the disk figures are one `df`, the
# load is the kernel's own average, and the memory signal is the pressure level rather than a
# decomposition -- so this cannot drift from the numbers printed underneath it.
pressure_label() {
  case "${1:-1}" in
    4|3) echo critical ;;
    2)   echo warn ;;
    *)   echo normal ;;
  esac
}

verdict() {
  local target="/" cores load1 dfree_gb pressure over key rest policy warn_gb crit_gb breached
  [ -d /System/Volumes/Data ] && target="/System/Volumes/Data"
  cores="$(sysctl -n hw.ncpu 2>/dev/null || echo 1)"
  load1="$(sysctl -n vm.loadavg | awk '{print $2}')"
  # Gibibytes, so this compares against the policy in the unit the policy is written in:
  # `tools/storage` reads `GB` as 1024³, and `df -g` reports in exactly those blocks.
  dfree_gb="$(df -g "$target" 2>/dev/null | tail -1 | awk '{print $4}')"
  # An unreadable `df` is not zero free space. The disk half of this verdict is skipped rather
  # than announced, for the reason `tools/storage` refuses on a probe it could not run.
  case "$dfree_gb" in
    ''|*[!0-9]*) dfree_gb="" ;;
  esac
  pressure="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || echo 1)"
  over="$(awk -v l="${load1:-0}" -v c="$cores" 'BEGIN { print (l > c) ? 1 : 0 }')"

  # The disk thresholds are the overlay policy's, read the same way tools/storage reads them,
  # rather than a percentage invented here. Two thresholds would drift, and the policy already
  # owns this question: `schemas/storage-policy.toml.example` is the contract. No policy and no
  # overlay means there is no declared line to breach, so this names no disk finding at all
  # rather than guessing one.
  #
  # `toml_get_in` unquotes a quoted value and returns an unquoted one as the whole `key = value`
  # line, which is the right answer for a string field and not one for a number, so the value is
  # cut at the `=` here. Either way a non-numeric result leaves the threshold unset.
  policy="${SJEL_OVERLAY_ROOT:-}/config/storage-policy.toml"
  warn_gb=""
  crit_gb=""
  if [ -f "$policy" ]; then
    warn_gb="$(toml_get_in thresholds free_warn_gb "$policy" 2>/dev/null | sed -E 's/^[^=]*=[[:space:]]*//' | head -1)"
    crit_gb="$(toml_get_in thresholds free_critical_gb "$policy" 2>/dev/null | sed -E 's/^[^=]*=[[:space:]]*//' | head -1)"
    case "$warn_gb" in ''|*[!0-9.]*) warn_gb="" ;; esac
    case "$crit_gb" in ''|*[!0-9.]*) crit_gb="" ;; esac
  fi

  # One primary, in that order. A load under the core count is work finishing, not a
  # shortage, so it is only a finding above it.
  key=""
  breached=""
  if [ -n "$dfree_gb" ] && [ -n "$crit_gb" ] && [ "$dfree_gb" -lt "${crit_gb%%.*}" ]; then
    key="disk"
    breached="${crit_gb}G critical line"
  elif [ -n "$dfree_gb" ] && [ -n "$warn_gb" ] && [ "$dfree_gb" -lt "${warn_gb%%.*}" ]; then
    key="disk"
    breached="${warn_gb}G line"
  fi
  [ -z "$key" ] && [ "$over" = "1" ] && key="cpu"
  [ -z "$key" ] && [ "$pressure" -ge 2 ] && key="memory"

  echo "Verdict"
  case "$key" in
    disk)
      echo "  disk is the one to fix — ${dfree_gb}G free, under the policy's ${breached}; \`tools/sysmon storage\` names each class and what is reclaimable"
      ;;
    cpu)
      echo "  cpu is the one to look at — load ${load1} on ${cores} cores; the Top CPU list below says who"
      ;;
    memory)
      echo "  memory is the one to look at — pressure $(pressure_label "$pressure"); see Top memory below"
      ;;
    *)
      if [ -z "$dfree_gb" ]; then
        echo "  nothing breached a line — load ${load1} on ${cores} cores, memory pressure $(pressure_label "$pressure") (disk not read)"
      elif [ -n "$warn_gb" ]; then
        echo "  nothing breached a line — ${dfree_gb}G free (the policy's line is ${warn_gb}G), load ${load1} on ${cores} cores, memory pressure $(pressure_label "$pressure")"
      else
        echo "  nothing breached a line — ${dfree_gb}G free, load ${load1} on ${cores} cores, memory pressure $(pressure_label "$pressure")"
      fi
      echo
      return
      ;;
  esac

  # What was ruled out, so a clean line is evidence rather than an omission.
  rest=""
  [ "$key" != "disk" ] && [ -n "$dfree_gb" ] && rest="${dfree_gb}G free on disk"
  if [ "$key" != "cpu" ]; then
    rest="${rest:+$rest · }load ${load1} on ${cores} cores"
  fi
  if [ "$key" != "memory" ]; then
    rest="${rest:+$rest · }memory pressure $(pressure_label "$pressure")"
  fi
  echo "  not the cause: $rest"
  echo
}

report() {
  echo "Sjel sysmon report · $(date '+%Y-%m-%d %H:%M:%S %Z')"
  echo

  verdict

  echo "Load & uptime"
  uptime | sed 's/^/  /'
  echo

  echo "Top CPU"
  ps aux -r | head -6 | tail -5 | awk '{printf "  %5s%%  %-8s %s\n", $3, $2, $11}'
  echo

  echo "Top memory"
  ps aux -m | head -6 | tail -5 | awk '{printf "  %5s%%  %-8s %s\n", $4, $2, $11}'
  echo

  # "Pages free" is not the opposite of used. On a warm macOS it sits near zero
  # because inactive and file-backed pages hold cached data the kernel hands back on
  # demand -- so total-minus-free reported 99% used on a machine memory_pressure
  # called 79% free. Use Activity Monitor's own decomposition instead:
  # used = app (anonymous minus purgeable) + wired + compressed, with cached files
  # shown separately because they are reclaimable, not consumed.
  #
  # Every field is read as $NF with non-digits stripped: vm_stat pads its columns
  # differently per field and ends each with a period, so a fixed column index is
  # the fragile choice. Absent fields stay 0, which keeps this working on macOS
  # versions predating "Anonymous pages".
  echo "Memory"
  vm_stat | awk \
    -v total="$(sysctl -n hw.memsize)" \
    -v praw="$(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null || echo 1)" '
    function num(s) { gsub(/[^0-9]/, "", s); return s + 0 }
    function h(b)   { return sprintf("%.1fG", b / 1073741824) }
    BEGIN { ps = 4096 }
    /page size of/ {
      if (match($0, /page size of [0-9]+/)) ps = substr($0, RSTART + 13, RLENGTH - 13) + 0
      next
    }
    /^Pages wired down:/             { wired = num($NF); next }
    /^Pages purgeable:/              { purge = num($NF); next }
    /^Anonymous pages:/              { anon  = num($NF); next }
    /^File-backed pages:/            { filed = num($NF); next }
    /^Pages occupied by compressor:/ { comp  = num($NF); next }
    END {
      app    = (anon - purge) * ps
      wiredb = wired * ps
      compb  = comp * ps
      cached = (filed + purge) * ps
      used   = app + wiredb + compb
      label  = (praw >= 4) ? "critical" : (praw >= 2) ? "warn" : "normal"
      printf "  used %s / %s (%d%%) — app %s, wired %s, compressed %s\n", \
        h(used), h(total), used * 100 / total, h(app), h(wiredb), h(compb)
      printf "  cached files %s (reclaimable on demand, not consumed)\n", h(cached)
      printf "  pressure %s\n", label
    }
  '
  echo

  echo "Swap"
  sysctl vm.swapusage | sed 's/^/  /'
  echo

  echo "Disk"
  # macOS Catalina+ APFS volume groups: / is the sealed, read-only System volume
  # (always small) -- /Users et al. actually live on /System/Volumes/Data. Report
  # that when present; fall back to / on Linux or pre-volume-group macOS.
  disk_target="/"
  [ -d /System/Volumes/Data ] && disk_target="/System/Volumes/Data"
  df -h "$disk_target" | tail -1 | awk -v t="$disk_target" '{printf "  %s: used %s / %s (%s full)\n", t, $3, $2, $5}'
}

cmd="${1:-tui}"
case "$cmd" in
  -h|--help)
    printf '%s' "$HELP"
    ;;
  tui)
    need_bin btm bottom
    exec btm
    ;;
  power|gpu)
    if [ "$(uname -m)" != "arm64" ]; then
      echo "sysmon power: macmon is Apple Silicon only (this machine is $(uname -m))" >&2
      exit 1
    fi
    need_bin macmon macmon
    exec macmon
    ;;
  report|snapshot)
    report
    ;;
  storage|disk)
    # Delegates rather than reimplements: storage owns the overlay policy, the du/df
    # arithmetic and the exit code. Pass the remaining args through so
    # `sysmon storage reclaim`, `--json` and the other verbs reach it unchanged.
    # The launcher is nested because a directory and an executable cannot share one name.
    shift
    exec "$_here/storage/storage" "$@"
    ;;
  *)
    echo "sysmon: unknown command '$cmd'" >&2
    printf '%s' "$HELP" >&2
    exit 2
    ;;
esac
