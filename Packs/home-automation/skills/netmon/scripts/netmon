#!/usr/bin/env python3
"""netmon — home LAN & traffic monitoring, run from the local host.

Scan/ports/baseline/diff work out of the box with `nmap` + the Python stdlib and need
no credentials. `traffic` reads Fritz!Box throughput over TR-064: the non-secret box
host/user come from the committed axon-overlay overlay config, and only FRITZBOX_PASSWORD
is fetched from Bitwarden at runtime (never hardcoded, never printed).
`dns`/`egress` read a resolver's query log over SSH. `passive` needs scapy + sudo.

Nothing is hardcoded to one house — non-secret config lives in the axon-overlay overlay
(config/home-assistant.vars via $SJEL_HOME_ROOT); the one secret comes from Bitwarden:
  - subnet:   --subnet or $NETMON_SUBNET, else NETMON_SUBNET from home-assistant.vars,
              else auto-derived from the primary interface (/24)
  - SSH:      $NETMON_SSH, else NETMON_SSH from home-assistant.vars — required only for dns/egress
  - resolver: $NETMON_DNS_CONTAINER (default "dnsmasq") — the container whose log is read
  - Fritz:    FRITZBOX_HOST / FRITZBOX_USERNAME from home-assistant.vars;
              FRITZBOX_PASSWORD from Bitwarden item $NETMON_BW_ITEM (default "home-assistant/netmon")

Commands:
  scan                 active host discovery (nmap -sn) + MAC + vendor
  ports HOST [--spec]  open-port scan of one host (default: --top-ports 100)
  baseline             save the current scan as the known-good baseline
  diff                 scan vs baseline -> new / missing hosts
  traffic              WAN throughput + totals (TR-064 via fritzconnection + bw creds)
  dns [CLIENT_IP]      top domains from the resolver's query log (egress visibility)
  egress IP            external domains a single device contacts (= dns for one client)
  passive [--secs N]   passive mDNS/SSDP/ARP listen (needs scapy + sudo)
"""
import argparse
import json
import os
import re
import socket
import subprocess
import sys
from pathlib import Path

CACHE = os.path.expanduser("~/.cache/netmon")
BASELINE = os.path.join(CACHE, "baseline.json")
BW_ITEM = os.environ.get("NETMON_BW_ITEM", "home-assistant/netmon")
def _home_overlay_root() -> Path:
    raw = os.environ.get("SJEL_HOME_ROOT") or os.environ.get("SJEL_OVERLAY_ROOT") or os.environ.get("SJEL_PERSONAL_ROOT")
    if not raw:
        raise SystemExit("home-automation overlay is unresolved; source tools/lib/paths.sh or set SJEL_HOME_ROOT")
    return Path(raw).expanduser()


VARS_FILE = _home_overlay_root() / "config/home-assistant.vars"

# Small best-effort offline OUI->vendor map (public manufacturer prefixes; mac-vendor-lookup
# covers the rest if installed). No house data — just IEEE-registered vendor blocks.
OUI = {
    "00:1a:22": "eQ-3/AVM", "34:31:c4": "AVM", "38:10:d5": "AVM", "c8:0e:14": "AVM",
    "9c:76:13": "Ring", "a8:e6:21": "Amazon", "e8:d8:7e": "Amazon", "44:65:0d": "Amazon",
    "64:c6:d2": "Epson", "78:42:1c": "Espressif", "d8:3a:dd": "RaspberryPi",
    "dc:a6:32": "RaspberryPi", "68:a4:0e": "BSH/Bosch", "2c:bc:bb": "Shelly",
    "e4:b0:63": "Shelly", "e4:65:b8": "Shelly", "00:17:88": "Philips Hue",
}


def _scalar(v: str) -> str:
    """Parse one vars-file value. A quoted value ends at its closing quote; an unquoted one
    ends at an inline ` #` comment. Naive quote-stripping swallows the comment into the value,
    which surfaces much later as an unexplained failure far from this line."""
    v = v.strip()
    if v[:1] in ('"', "'"):
        end = v.find(v[0], 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split(" #", 1)[0].strip()


def die(msg, code=1):
    print(f"netmon: {msg}", file=sys.stderr)
    raise SystemExit(code)


def cfg(*keys):
    """Read non-secret scalar values from the committed overlay vars file."""
    if not VARS_FILE.exists():
        die(f"config not found: {VARS_FILE} (the axon-overlay overlay's home-assistant.vars)")
    vals = {}
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        vals[k.strip()] = _scalar(v)
    missing = [k for k in keys if not vals.get(k) or vals[k].startswith("TODO-")]
    if missing:
        die(f"config missing/placeholder in {VARS_FILE}: {', '.join(missing)}")
    return [vals[k] for k in keys]


def cfg_opt(key):
    """Optional single value from the overlay vars file — None when the file, the key, or a
    real (non-TODO) value is absent. The env/flag override wins over this; the fallback when
    both are unset is auto-derivation (subnet) or an explicit error (ssh)."""
    if not VARS_FILE.exists():
        return None
    for line in VARS_FILE.read_text().splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith("-") or ":" not in s:
            continue
        k, _, v = s.partition(":")
        if k.strip() == key:
            v = _scalar(v)
            return v if v and not v.startswith("TODO-") else None
    return None


def bw_secret(field: str) -> str:
    """Fetch a single secret field from the Bitwarden item. Never prints the value."""
    session = os.environ.get("BW_SESSION")
    if not session:
        die("BW_SESSION not set — unlock Bitwarden first, e.g. "
            "`export BW_SESSION=$(bw unlock --raw)` (master password prompted by bw, not by this tool).")
    r = subprocess.run(["bw", "get", "item", BW_ITEM, "--session", session],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"`bw get item {BW_ITEM}` failed: {r.stderr.strip() or 'unknown error'} "
            f"(is the item name right and the session unlocked?)")
    # A stale BW_SESSION passes the presence check above and `bw` still exits 0, printing a
    # plain-text complaint instead of JSON — so the parse, not the return code, is where a
    # locked vault actually surfaces. Say so, instead of raising JSONDecodeError at the caller.
    try:
        item = json.loads(r.stdout)
    except ValueError:
        die(f"`bw get item {BW_ITEM}` returned no JSON: {r.stdout.strip()[:160] or '(empty)'} "
            "— the vault is probably locked; re-run `export BW_SESSION=$(bw unlock --raw)`.")
    fields = {f.get("name"): f.get("value") for f in item.get("fields", [])}
    if not fields.get(field):
        die(f"bw item '{BW_ITEM}' is missing secret field: {field}")
    return fields[field]


def have(mod):
    import importlib.util
    return importlib.util.find_spec(mod) is not None


def need(binary):
    if subprocess.run(["which", binary], capture_output=True).returncode != 0:
        die(f"`{binary}` not found on this host — install it first "
            f"(the target Pi ships without nmap; `sudo apt install nmap` or `brew install nmap`).")


def subnet():
    """Resolve the /24 to scan. Flag/env win, then the overlay config, then it is derived
    from the primary interface so nothing is pinned to one house's addressing."""
    s = os.environ.get("NETMON_SUBNET") or cfg_opt("NETMON_SUBNET")
    if s:
        return s
    try:
        # UDP connect sends no packets; it just picks the route/source address.
        u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            u.connect(("198.51.100.1", 1))  # RFC 5737 TEST-NET-2 — unroutable, never reached
            ip = u.getsockname()[0]
        finally:
            u.close()
        a, b, c, _ = ip.split(".")
        return f"{a}.{b}.{c}.0/24"
    except Exception:
        die("could not auto-derive the subnet — set NETMON_SUBNET (e.g. NETMON_SUBNET=10.0.0.0/24) "
            "or pass --subnet.")


def ssh_target():
    t = os.environ.get("NETMON_SSH") or cfg_opt("NETMON_SSH")
    if not t:
        die("dns/egress need an SSH target — set NETMON_SSH=user@resolver-host, or add "
            "NETMON_SSH to the axon-overlay home-assistant.vars (the host running the "
            "resolver whose query log is read).")
    return t


def norm_mac(mac):
    """macOS `arp` strips leading zeros (0:17:88...) — re-pad each octet to 2 hex digits."""
    if not mac:
        return ""
    return ":".join(o.zfill(2) for o in mac.lower().split(":"))


def vendor(mac):
    mac = norm_mac(mac)
    if not mac:
        return ""
    if have("mac_vendor_lookup"):
        try:
            from mac_vendor_lookup import MacLookup
            return MacLookup().lookup(mac)
        except Exception:
            pass
    return OUI.get(mac[:8], "")


def arp_table():
    out = subprocess.run(["arp", "-an"], capture_output=True, text=True).stdout
    return dict(re.findall(r"\((\d+\.\d+\.\d+\.\d+)\) at ([0-9a-f:]+)", out))


def scan_hosts(quiet=False):
    need("nmap")
    net = subnet()
    r = subprocess.run(["nmap", "-sn", net], capture_output=True, text=True, timeout=180)
    hosts, cur = [], None
    for line in r.stdout.splitlines():
        m = re.search(r"Nmap scan report for (?:(\S+) )?\(?(\d+\.\d+\.\d+\.\d+)\)?", line)
        if m:
            cur = {"ip": m.group(2), "host": m.group(1) or "", "mac": "", "vendor": ""}
            hosts.append(cur)
        mm = re.search(r"MAC Address: ([0-9A-Fa-f:]+) \((.*?)\)", line)
        if mm and cur:
            cur["mac"], cur["vendor"] = mm.group(1).lower(), mm.group(2)
    arp = arp_table()
    for h in hosts:
        if not h["mac"] and h["ip"] in arp:
            h["mac"] = arp[h["ip"]]
        h["mac"] = norm_mac(h["mac"])
        if not h["vendor"]:
            h["vendor"] = vendor(h["mac"])
    if not quiet:
        print(f"{len(hosts)} live hosts on {net}:")
        for h in sorted(hosts, key=lambda x: tuple(int(o) for o in x["ip"].split("."))):
            print(f"  {h['ip']:16} {h['mac']:18} {h['vendor'][:18]:18} {h['host']}")
    return hosts


def cmd_scan(args):
    scan_hosts()
    return 0


def cmd_ports(args):
    need("nmap")
    spec = args.spec if args.spec else ["--top-ports", "100"]
    r = subprocess.run(["nmap", *spec, args.host], capture_output=True, text=True, timeout=300)
    for line in r.stdout.splitlines():
        if re.match(r"\d+/(tcp|udp)", line) or "Nmap scan report" in line or "MAC Address" in line:
            print("  " + line)
    return 0


def cmd_baseline(args):
    os.makedirs(CACHE, exist_ok=True)
    hosts = scan_hosts(quiet=True)
    with open(BASELINE, "w") as fh:
        json.dump(hosts, fh, indent=1)
    print(f"baseline saved: {len(hosts)} hosts -> {BASELINE}")
    return 0


def cmd_diff(args):
    if not os.path.exists(BASELINE):
        die("no baseline yet — run: netmon baseline")
    base = {h["ip"]: h for h in json.load(open(BASELINE))}
    now = {h["ip"]: h for h in scan_hosts(quiet=True)}
    new = [now[ip] for ip in now if ip not in base]
    gone = [base[ip] for ip in base if ip not in now]
    print(f"NEW ({len(new)}):")
    for h in new:
        print(f"  + {h['ip']:16} {h['mac']:18} {h['vendor']} {h['host']}")
    print(f"MISSING ({len(gone)}):")
    for h in gone:
        print(f"  - {h['ip']:16} {h['mac']:18} {h['vendor']} {h['host']}")
    return 0


def cmd_traffic(args):
    if not have("fritzconnection"):
        die("`traffic` needs fritzconnection — install it, e.g. "
            "`pip install --break-system-packages fritzconnection` or `uv pip install fritzconnection`.")
    from fritzconnection.lib.fritzstatus import FritzStatus
    host, user = cfg("FRITZBOX_HOST", "FRITZBOX_USERNAME")
    fs = FritzStatus(address=host.replace("https://", "").replace("http://", ""),
                     user=user, password=bw_secret("FRITZBOX_PASSWORD"))
    up, down = fs.transmission_rate
    print(f"WAN now:   down {down*8/1e6:.2f} Mbit/s   up {up*8/1e6:.2f} Mbit/s")
    print(f"WAN total: down {fs.bytes_received/1e9:.1f} GB   up {fs.bytes_sent/1e9:.1f} GB")
    return 0


def _resolver_log():
    container = os.environ.get("NETMON_DNS_CONTAINER", "dnsmasq")
    r = subprocess.run(["ssh", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes", ssh_target(),
                        f"docker logs {container} --tail 5000 2>&1"],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        die(f"reading the resolver log over SSH failed: {r.stderr.strip() or 'unknown error'} "
            f"(is NETMON_SSH reachable and the '{container}' container running?)")
    return r.stdout


def cmd_dns(args):
    log = _resolver_log()
    q = re.findall(r"query\[[^\]]+\] (\S+) from (\d+\.\d+\.\d+\.\d+)", log)
    if not q:
        print("no query logging from the resolver. To enable full egress visibility:")
        print("  1) enable query logging on the resolver (dnsmasq: `log-queries` + `log-facility=-`)")
        print("  2) point the router's DHCP-advertised DNS server at this resolver so every")
        print("     device resolves through it, then restart the resolver and re-run")
        print("  (or deploy Pi-hole for a UI + per-client stats + egress allow/deny lists)")
        return 0
    from collections import Counter
    client = getattr(args, "client", None)
    rows = [(d, c) for d, c in q if (client is None or c == client)]
    dom = Counter(d for d, _ in rows)
    title = f"top domains for {client}" if client else "top domains (all clients)"
    print(f"{title} — {len(rows)} queries:")
    for d, n in dom.most_common(30):
        print(f"  {n:5} {d}")
    return 0


def cmd_egress(args):
    args.client = args.ip
    return cmd_dns(args)


def cmd_passive(args):
    if not have("scapy"):
        die("passive mode needs scapy: `pip install --break-system-packages scapy` (and sudo).")
    from scapy.all import sniff  # noqa
    seen = {}

    def cb(p):
        if p.haslayer("DNS") or p.haslayer("ARP"):
            seen[p.summary()] = seen.get(p.summary(), 0) + 1
    print(f"listening {args.secs}s (mDNS/SSDP/ARP)...")
    sniff(prn=cb, timeout=args.secs, filter="udp port 5353 or udp port 1900 or arp", store=0)
    for s, n in sorted(seen.items(), key=lambda x: -x[1])[:40]:
        print(f"  {n:4} {s}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="netmon", description="Home LAN & traffic monitoring.")
    p.add_argument("--subnet", help="CIDR to scan (overrides $NETMON_SUBNET and auto-derivation)")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("scan", help="active host discovery + MAC + vendor").set_defaults(fn=cmd_scan)

    po = sub.add_parser("ports", help="open-port scan of one host")
    po.add_argument("host")
    po.add_argument("--spec", nargs=argparse.REMAINDER, help="raw nmap spec (default: --top-ports 100)")
    po.set_defaults(fn=cmd_ports)

    sub.add_parser("baseline", help="save current scan as the baseline").set_defaults(fn=cmd_baseline)
    sub.add_parser("diff", help="scan vs baseline -> new/missing hosts").set_defaults(fn=cmd_diff)
    sub.add_parser("traffic", help="WAN throughput + totals (TR-064 + bw creds)").set_defaults(fn=cmd_traffic)

    dn = sub.add_parser("dns", help="top domains from the resolver's query log")
    dn.add_argument("client", nargs="?", help="optional client IP to filter to")
    dn.set_defaults(fn=cmd_dns)

    eg = sub.add_parser("egress", help="external domains one device contacts")
    eg.add_argument("ip")
    eg.set_defaults(fn=cmd_egress)

    pa = sub.add_parser("passive", help="passive mDNS/SSDP/ARP listen (scapy + sudo)")
    pa.add_argument("--secs", type=int, default=30)
    pa.set_defaults(fn=cmd_passive)

    args = p.parse_args()
    if args.subnet:
        os.environ["NETMON_SUBNET"] = args.subnet
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except subprocess.TimeoutExpired:
        die("a subprocess timed out (nmap/ssh) — check reachability and try again.")
    except Exception as e:
        die(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    raise SystemExit(main())
