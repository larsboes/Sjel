# Private overlay template for <overlay>/config/storage-policy.toml.
#
# tools/storage knows no path on this machine. What counts as a reclaimable class,
# what is protected, and what "low on space" means are all deployment facts, so they
# live here rather than in core Axon (CONTRIBUTING.md#public-core-and-private-overlays).
#
# Replace every <placeholder> and delete the classes this host does not have.

[thresholds]
# Exit 1 when free space drops below free_critical_gb; warn below free_warn_gb.
free_warn_gb = 100
free_critical_gb = 40
# Classes at or above this size are flagged in the report.
class_flag_gb = 5

# One [[class]] per thing that accumulates. `paths` accepts ~ and a single `*` segment.
#
# `reclaim` is the command --apply runs, and `apply` is what licenses it. Both are
# required together: `apply = true` with no `reclaim` is rejected as a policy bug
# rather than guessed at. Omit `apply` to keep a class report-only.
#
# The rule that keeps --apply safe: never `rm -rf` what a tool can clean itself. A
# named tool's own verb runs verbatim; the literal string `rm -rf` is special-cased
# to delete only the paths tools/storage measured, never a path the policy named.
#
# `cap_gb` is the size axis, and it is a GATE on `apply` rather than a separate verb:
# the class acts only when it is measured above the cap, and a class with no cap acts
# whenever it is asked (which is what every class did before this existed). It is also
# what makes a class safe to run unattended — `sjel storage reclaim --scheduled` acts
# only on classes whose own declaration bounds them, by size or by age, because an
# unbounded class is a person's decision.
#
# `older_than_days` removes the entries INSIDE each path that are older than N days,
# rather than the path itself. That is the cheap way to hold a build cache down: the
# alternative for a debug directory is dropping all of it at the cap, one full rebuild,
# every time it reaches the cap.

[[class]]
name = "package manager cache"
paths = ["~/<cache-dir>"]
reclaim = "<package-manager> cleanup --prune=all"
apply = true
regrows = true
note = "Refills on the next install. Safe to clear on any schedule."

[[class]]
name = "orphaned build output"
paths = ["<projects-root>/*/target"]
# No owning tool left to ask, so the recursive delete is the fallback. Opt in per
# class, never by default.
reclaim = "rm -rf"
apply = true

[[class]]
name = "<build-system> debug cache"
paths = ["~/<shared-target>/debug", "~/<shared-target>/*/debug"]
# Bounded by size, so this one may run from a schedule. `[[protected]]` the sibling
# that a running process execs from (release/) and the guard keeps the sweep off it.
reclaim = "rm -rf"
apply = true
cap_gb = 50

[[class]]
name = "<build-system> incremental state"
paths = ["~/<shared-target>/debug/incremental"]
# Bounded by age, so this may also run unattended. Keeps the cap above from being
# reached at all, which is the difference between a rare full rebuild and a regular one.
reclaim = "rm -rf"
apply = true
older_than_days = 3

[[class]]
name = "<model-server> KV cache"
paths = ["~/<cache-dir>"]
reclaim = "<curl-the-servers-own-cache-clear-endpoint>"
apply = true
note = "Unbounded by default in some versions; check the server's own config first."

[[class]]
name = "<something-large-you-only-want-to-see>"
paths = ["<path>"]
note = "No reclaim and no apply: reported, never touched."

# Paths that are measured and shown but never applied against, whatever a class says.
[[protected]]
path = "<path-holding-state-you-cannot-regenerate>"
reason = "<why losing this would be unrecoverable>"

# Long-running services this host expects to find. Reported so a cache that belongs
# to a service that is no longer installed is visible as an orphan. Each one is CHECKED
# against the machine, so `kind` picks the probe and `name` is what the probe matches on:
#
#   process         pgrep -f <name>          full command line, so argv[0] need not be the name
#   launchagent     launchctl print gui/<uid>/<name>   `name` is the launchd label
#   apple-container `container list`, matched by <name>  unverifiable if no `container` CLI
#
# Any other `kind` is unverifiable rather than absent, so a policy written for another init
# system does not read as a stopped service. A service already declared by systems.toml or a
# capability's service.toml does NOT belong here — tools/doctor checks those, and restating it
# is the second source of truth this file exists to avoid.
[[expected_service]]
name = "<service>"
kind = "<process|launchagent|apple-container>"
note = "<what it owns on disk>"
