# Shape of <overlay>/config/agentbox.toml — this machine's instance of the box.
# Single-line TOML only (tools/lib/toml.sh). Copy, fill in, keep out of Axon.
#
# What belongs here: which agent, which model, where the model answers, how much of
# the machine the box may use. What does NOT: the agent's version and checksum (that
# is capabilities/agentbox/profiles/<agent>/profile.toml, tracked and shared) and the
# model API key (that is the gitignored env file below, CONTRIBUTING.md#secrets).

agent = "pi"                     # a directory under capabilities/agentbox/profiles/

# --- the model endpoint on the host ---------------------------------------
# Left unset, the base URL is derived at run time: http://host.docker.internal:<model_port>/v1.
# That name is the host as docker sees it, so no subnet is hardcoded here and a daemon that
# renumbers its bridge changes nothing. It resolves ONLY in an `--online` box; the default
# box has no network at all (Q75, and capabilities/agentbox/README.md).
model_port = "8000"
# model_base_url = "http://<host>:<port>/v1"   # override, for an endpoint elsewhere

model_id             = "<the id your server advertises at /v1/models>"
model_name           = "<how it should read in the agent's model picker>"
model_context_window = "262144"
model_max_tokens     = "32768"

# --- credentials -----------------------------------------------------------
# Overlay-relative path to a gitignored env file holding the real value, and the
# variable inside it. Created by you, in your own terminal — never by an agent turn.
api_key_file = "config/agentbox.env"
api_key_var  = "AGENTBOX_MODEL_API_KEY"

# --- the box ---------------------------------------------------------------
# `network` stood here until 2026-09-02 (Q75). It named a host-only network the
# launcher created; docker has no equivalent, so the two modes are now built in and neither
# takes a name — `--network none` by default, the daemon's own bridge with --online.
#
# cpus is a CFS quota, not a vCPU count: the box still sees every host core in `nproc` and
# is throttled at this share. memory is a hard limit the box does see.
cpus    = "4"
memory  = "8G"
