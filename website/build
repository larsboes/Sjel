#!/usr/bin/env bash
# website/build — assemble the public site from tracked files.
#
#   site/
#     index.html        scripts/landing.ts    what Sjel is and how it fits together
#     docs/**           scripts/docs.ts       website/content/**/*.md, with a sidebar
#     reference/**      scripts/reference.ts  one page per unit; scripts/self-model.ts
#     favicon.svg, hedgehog.png
#
# Needs no running capability. Two gates run at the end: every internal link resolves
# (scripts/links.ts), and the payload carries nothing private (tools/check-site-payload.sh).
#
#   website/build                build into site/
#   website/build --out <dir>
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SJEL_ROOT="$(cd "$_here/.." && pwd)"

OUT="$SJEL_ROOT/site"
SERVE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    --serve) SERVE=1; shift ;;
    -h|--help) echo "usage: website/build [--out <dir>] [--serve]"; exit 0 ;;
    *) echo "website/build: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

rm -rf "$OUT"
mkdir -p "$OUT"

bun "$_here/scripts/landing.ts" --out "$OUT"
bun "$_here/scripts/docs.ts" --out "$OUT"
bun "$_here/scripts/reference.ts" --out "$OUT"
bun "$_here/scripts/self-model.ts" --out "$OUT"
bun "$_here/scripts/roadmap.ts" --out "$OUT"
cp "$_here/assets/favicon.svg" "$OUT/favicon.svg"
cp "$SJEL_ROOT/.github/assets/sjel-hedgehog.png" "$OUT/hedgehog.png"

# GitHub Pages runs Jekyll unless told not to, and Jekyll drops directories that begin with `_`.
touch "$OUT/.nojekyll"

bun "$_here/scripts/links.ts" "$OUT"
"$SJEL_ROOT/tools/check-site-payload.sh" "$OUT"

echo "website/build: $(du -sh "$OUT" | cut -f1) in $OUT"

if [ "$SERVE" -eq 1 ]; then
  exec bun "$_here/scripts/serve.ts" "$OUT" 8000
fi
