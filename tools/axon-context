#!/bin/bash
# sjel-context — emit bounded, current context for one Sjel target.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
SJEL_ROOT="$(cd "$TOOLS_DIR/.." && pwd)"
mode="${1:-}"
target="${2:-}"

usage() {
  echo "usage: sjel context with [capability] | on [unit-or-path]" >&2
  exit 1
}

print_path_if_present() {
  [ -e "$SJEL_ROOT/$1" ] && echo "read=$1"
}

context_with() {
  local registry row
  registry="$("$SJEL_ROOT/tools/capability.sh" registry)"
  echo "mode=with"
  echo "repo=$SJEL_ROOT"
  if [ -z "$target" ]; then
    echo "capabilities:"
    printf '%s\n' "$registry" | jq -r '.[] | "  \(.name)\tkind=\(.kind)\thttp=\(if .port == "" then "none" else "registered" end)"'
    echo "next=sjel capability list"
    return
  fi
  row="$(printf '%s\n' "$registry" | jq -c --arg name "$target" '.[] | select(.name == $name)' | head -n 1)"
  if [ -z "$row" ]; then
    echo "sjel context: unknown capability '$target'" >&2
    printf '%s\n' "$registry" | jq -r '.[].name' >&2
    exit 1
  fi
  echo "target=$target"
  echo "registry=$row"
  print_path_if_present "capabilities/$target/README.md"
  print_path_if_present "capabilities/$target/service.toml"
  capability_facts "$target"
  echo "next=sjel capability url $target"
}

# What an agent otherwise finds by grepping: routes, settings, config, log, and callers. Read from
# source and paths only, so it works whether or not the capability is running.
capability_facts() {
  local name="$1" src="$SJEL_ROOT/capabilities/$1/src" overlay="" file
  if [ -d "$src" ] && command -v rg >/dev/null; then
    local routes
    routes="$(rg --no-filename -o '\.route\(\s*"[^"]+",\s*(get|post|put|patch|delete)' "$src" 2>/dev/null |
      sed -E 's/.*"([^"]+)",[[:space:]]*([a-z]+)/route=\2 \1/' | sort -u)"
    printf '%s\n' "$routes" | head -40
    [ "$(printf '%s\n' "$routes" | wc -l)" -gt 40 ] &&
      echo "routes=first 40 of $(printf '%s\n' "$routes" | wc -l | tr -d ' '); rg '\.route\(' capabilities/$name/src"
    true
    rg --no-filename -o '"SJEL_[A-Z0-9_]+"' "$src" 2>/dev/null | tr -d '"' | sort -u |
      sed 's/^/env=/'
  fi
  overlay="$(. "$SJEL_ROOT/tools/lib/paths.sh" >/dev/null 2>&1 && printf '%s' "${SJEL_OVERLAY_ROOT:-}")"
  if [ -n "$overlay" ]; then
    for file in "$overlay/config/$name".*; do
      case "$file" in *.bak*) continue ;; esac
      [ -e "$file" ] && echo "config=$file"
    done
  fi
  echo "log=/tmp/sjel-$name.log"
  if command -v rg >/dev/null; then
    rg -l --fixed-strings "\"/$name/" "$SJEL_ROOT/apps/gpui/core/src" "$SJEL_ROOT/apps/gpui/ui/src" \
      "$SJEL_ROOT/apps/gpui/src" "$SJEL_ROOT/dashboard/src/lib" "$SJEL_ROOT/tools/sjel-cli/src" 2>/dev/null |
      sed "s|^$SJEL_ROOT/|client=|" | sort | head -12
  fi
}

unit_from_target() {
  case "$1" in
    capabilities/*|libs/*|Packs/*) printf '%s\n' "$1" | cut -d/ -f2 ;;
    dashboard/*|tools/*|schemas/*) printf '%s\n' "$1" | cut -d/ -f1 ;;
    *) echo "$1" ;;
  esac
}

context_on() {
  local normalized unit
  echo "mode=on"
  echo "repo=$SJEL_ROOT"
  git -C "$SJEL_ROOT" status --short --branch
  if [ -z "$target" ]; then
    "$SJEL_ROOT/tools/self" status
    echo "read=README.md"
    echo "next=sjel doctor"
    return
  fi
  normalized="${target#./}"
  if [ -e "$SJEL_ROOT/$normalized" ]; then
    unit="$(unit_from_target "$normalized")"
    echo "target=$normalized"
  else
    unit="$target"
    echo "target=$target"
  fi
  "$SJEL_ROOT/tools/self" explain "$unit" --json 2>/dev/null || echo "self=unavailable-for-$unit"
  print_path_if_present "capabilities/$unit/README.md"
  print_path_if_present "capabilities/$unit/service.toml"
  print_path_if_present "capabilities/$unit/Cargo.toml"
  print_path_if_present "libs/$unit/README.md"
  print_path_if_present "libs/$unit/Cargo.toml"
  print_path_if_present "Packs/$unit/README.md"
  print_path_if_present "Packs/$unit/pack.toml"
  print_path_if_present "$normalized"
  echo "next=sjel doctor"
}

case "$mode" in
  with) context_with ;;
  on) context_on ;;
  *) usage ;;
esac
