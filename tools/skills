#!/bin/bash
# tools/skills — install NON-PACK agent skills at the right scope.
#
# `add` and `update` are the launcher for tools/sjel-cli/src/intake/skills.rs: upstream's CLI
# (`npx skills`) runs once, inside a private stage; every staged skill directory is read into
# memory, gated by tools/intake (fixed rules plus model review, or an exact prior approval),
# and those same bytes are what gets installed. The project skills-lock.json takes the staged
# entry verbatim, so remote provenance survives. The gate is fail-closed: content nobody
# reviewed is held, never installed.
#
# The scope rule: system-wide skills are Sjel Packs and only Sjel Packs
# (tools/packs-pi deploy / tools/packs-claude deploy); everything else installs project-scoped,
# and `--global` is refused. Full reasoning: Packs/harness/README.md; open work and limits:
# docs/plans/packs.md.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -u

SJEL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
export SJEL_ROOT
# shellcheck source=tools/lib/toml.sh
. "$SJEL_ROOT/tools/lib/toml.sh"       # toml_get_in, for the missing-cargo install hint
# shellcheck source=tools/lib/sjel-cli.sh
. "$SJEL_ROOT/tools/lib/sjel-cli.sh"

read -r -d '' GLOBAL_RULE <<'EOF' || true
refusing --global: a system-wide skill must be a Sjel Pack.

  deploy a Pack:   tools/packs-pi deploy <pack>      (pi's registry)
                   tools/packs-claude deploy <pack>  (materialized copies + ledger)

  If you mean it anyway: npx skills add <package> -g   (tools/skills audit will report it)
EOF

usage() {
  cat <<'USAGE'
tools/skills — install non-Pack agent skills at the right scope, by driving `npx skills`.

  tools/skills add <package> [--skill <name>]... [--agent <id>]...
                            project-scoped install; defaults to agents pi + claude-code.
                            Stages once, gates the staged bytes (tools/intake), installs
                            exactly those bytes, exits 2 when held.
  tools/skills update      re-stages every source in skills-lock.json, gates it, and
                            updates only destinations that already hold the skill
  tools/skills list [--global] [--json]
                            what is installed, in this project or globally
  tools/skills audit       global skills no Sjel Pack owns; exit 1 if any
  tools/skills remove|find [...]
                            pass-through to the CLI (global removal allowed)

the scope rule:

  system-wide   Sjel Packs, and only Packs: tools/packs-pi deploy <pack>,
                tools/packs-claude deploy <pack>. These load in every session of
                every project.
  project-wide  everything else, gated through tools/intake before it installs.

  `--global` is refused. See Packs/harness/README.md for the full reasoning.
USAGE
}

cli() { npx --yes skills "$@"; }

# A global skill Sjel does not own is the violation the scope rule names. `source` is the
# discriminator: the CLI records where it installed a skill from and leaves it null for skills
# it merely sees in an agent directory — which is every skill a Pack deployed.
cmd_audit() {
  local findings
  findings="$(npx --yes skills list -g --json 2>/dev/null | python3 -c '
import json, sys
raw = sys.stdin.read()
start = raw.find("[")
if start < 0:
    sys.exit(0)
try:
    entries = json.loads(raw[start:])
except ValueError:
    sys.exit(0)
for entry in entries:
    if entry.get("source"):
        agents = ",".join(entry.get("agents") or []) or "-"
        print("%s\t%s\t%s" % (entry["name"], entry["source"], agents))
')"

  if [ -z "$findings" ]; then
    printf '✓ no skill is installed globally outside a Sjel Pack\n'
    return 0
  fi
  printf 'global skills that no Sjel Pack owns:\n'
  printf '%s\n' "$findings" | while IFS="$(printf '\t')" read -r name source agents; do
    printf '  %-34s source=%s  agents=%s\n' "$name" "$source" "$agents"
  done
  printf '\nThey load into every session of every project. Fix:\n'
  printf '%s\n' "$findings" | cut -f1 | while read -r name; do
    printf '  tools/skills remove -g -s %s -y\n' "$name"
  done
  return 1
}

cmd_list() {
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -g|--global|--json) args+=("$1") ;;
      *) printf 'tools/skills: unknown option for list: %s\n' "$1" >&2; exit 1 ;;
    esac
    shift
  done
  cli list ${args[@]+"${args[@]}"}
}

verb="${1:-}"
shift || true
case "$verb" in
  add)
    for a in "$@"; do
      case "$a" in
        -g|--global) printf '%s\n' "$GLOBAL_RULE" >&2; exit 1 ;;
      esac
    done
    sjel_cli_exec skills add "$@"
    ;;
  update|upgrade) sjel_cli_exec skills update "$@" ;;
  list|ls) cmd_list "$@" ;;
  audit) cmd_audit "$@" ;;
  remove|rm|find|init) cli "$verb" "$@" ;;
  -h|--help|help|"") usage ;;
  *) printf 'tools/skills: unknown command %s (try: tools/skills --help)\n' "$verb" >&2; exit 1 ;;
esac
