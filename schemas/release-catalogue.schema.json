{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sjel release catalogue",
  "description": "Release metadata served by the authenticated Sjel release channel. Package digests are used by the capability distributor.",
  "type": "object",
  "required": ["schema", "version", "source", "friend_ready", "assets", "capabilities"],
  "properties": {
    "schema": { "const": 1 },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "platform": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "dirty", "rebuilt"],
      "properties": {
        "repository": { "const": "https://github.com/larsboes/Sjel" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "rebuilt": { "type": "boolean" }
      }
    },
    "friend_ready": { "type": "boolean" },
    "signed": { "type": "boolean" },
    "notarized": { "type": "boolean" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "platform": { "type": "string" },
          "signed": { "type": "boolean" },
          "notarized": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capability": {
      "type": "object",
      "required": ["name", "version", "platform", "requires", "feature", "asset", "bytes", "sha256"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "platform": { "type": "string" },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" }
        },
        "feature": { "$ref": "#/$defs/feature" },
        "asset": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "title", "summary", "category", "recommend_topics", "data_access"],
      "properties": {
        "schema": { "const": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": { "type": "string", "minLength": 1, "maxLength": 40 },
        "recommend_topics": {
          "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" }
        },
        "data_access": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
