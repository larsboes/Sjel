#!/bin/bash
# tools/audit — the one command, and the only two scanners Axon still runs itself.
#
#   tools/audit        # no arguments, no flags
#
#   gitleaks     secret scan over this repository's git history AND the private overlay's.
#                GitHub secret scanning with push protection already covers the public repo;
#                the overlay is a private repository, where that is a paid feature, so the
#                overlay half is the one scan nothing else does.
#   osv-scanner  dependency CVEs over every lockfile here, reading osv-scanner.toml's dated
#                exceptions. Dependabot alerts watch the same lockfiles continuously; this is
#                the answer before a push rather than after it.
#
#                AND, in a second pass, the same CVEs against software installed OUTSIDE this
#                checkout: every node in the global npm tree, and every `cargo install`ed crate
#                with the transitive tree its own published Cargo.lock pins. That pass exists
#                because nothing else looks at them. osv-scanner's own `directory` plugin
#                cannot (measured 2026-10-03 on 2.6.0: 0 Extract calls, 1 dir visited, even
#                against a valid dpkg status file), and Dependabot reads lockfiles in this
#                repository only — so the class `tools/updates` is solely responsible for
#                moving was the class no scanner covered. The inventory comes from
#                `tools/updates --json --offline --inventory`, which reads `cargo install
#                --list` and `npm ls -g --json --all` for the report already; this adds no
#                second reader of either.
#
# NOT here: container images (.github/workflows/security.yml runs `grype registry:` against
# every image a service.toml declares, weekly and on push, whether or not this Mac is awake --
# report-only since Q77, with the Critical/High counts in that run's summary) and Axon's own
# source (.github/workflows/codeql.yml).
#
# Exit 0 clean · 1 a finding · 2 a scanner is not installed. A missing binary is a setup
# error, never a finding: it must not read as clean and must not read as a leak. A finding
# outranks a missing scanner, so a run with both exits 1. bash 3.2-safe.
set -u

_here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=tools/lib/paths.sh
. "$_here/lib/paths.sh"   # SJEL_ROOT, SJEL_PERSONAL_ROOT

case "${1:-}" in
  "")        ;;
  -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
  *)         echo "audit: takes no arguments (got '$1')" >&2; exit 2 ;;
esac

fail=0    # a scanner reported something
setup=0   # a scanner is not installed

echo "Axon audit · $(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)"

# ---- gitleaks: secret scan over Axon + the private overlay's git history ----
echo
echo "▸ gitleaks · secret scan (git history)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "  ⚠ gitleaks not installed — install: brew install gitleaks"
  setup=1
else
  # The overlay's path is never printed. A label is enough to act on, and this output reaches
  # terminals, transcripts and CI logs that the overlay's coordinate must not.
  scan_git_history() {
    label="$1"; repo="$2"
    if [ -z "$repo" ]; then echo "  · $label — not configured"; return; fi
    if [ ! -e "$repo" ]; then echo "  ✗ $label — not reachable"; fail=1; return; fi
    # A linked worktree has a .git FILE, not a directory, so ask git rather than test a path.
    if ! git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      echo "  ✗ $label — not a Git repository"; fail=1; return
    fi
    if gitleaks detect -s "$repo" --redact --no-banner --exit-code 1 >/dev/null 2>&1; then
      echo "  ✓ $label — clean"
    else
      rc=$?
      if [ "$rc" -eq 1 ]; then
        echo "  ✗ $label — leak(s) found (details withheld; run gitleaks there yourself for redacted triage)"
      else
        echo "  ? $label — gitleaks errored (exit $rc; details withheld)"
      fi
      fail=1
    fi
  }
  scan_git_history "Axon" "$SJEL_ROOT"
  scan_git_history "private overlay" "${SJEL_PERSONAL_ROOT:-}"
fi

# ---- osv-scanner: dependency CVEs over every lockfile in the repo ----
echo
echo "▸ osv-scanner · dependency CVEs"
if ! command -v osv-scanner >/dev/null 2>&1; then
  echo "  ⚠ osv-scanner not installed — install: brew install osv-scanner"
  setup=1
else
  # Build-artifact dirs stay out: generated, not code, and capabilities/*/target alone runs to
  # thousands of files (6879 measured in scouting/target). Same set .gitignore excludes.
  # to-integrate/ joins them for the reason .gitignore excludes it
  # (CONTRIBUTING.md#scratch-is-not-documentation): pre-git scratch holding whole vendored projects,
  # not Axon's code. bazel-* stays listed after PRD Q44 retired Bazel — the symlinks it left
  # still point at multi-gigabyte trees on existing checkouts.
  args="scan source -r --config $SJEL_ROOT/osv-scanner.toml"
  for d in target bazel-bin bazel-out bazel-testlogs node_modules to-integrate; do
    args="$args --experimental-exclude $d"
  done
  # osv-scanner enforces osv-scanner.toml's ignoreUntil dates itself and names a lapsed entry
  # under "unused ignores", which is why Axon carries no clock of its own any more.
  osv-scanner $args "$SJEL_ROOT"
  rc=$?
  case "$rc" in
    0) echo "  ✓ clean" ;;
    1) echo "  ✗ vulnerabilities found above"; fail=1 ;;
    *) echo "  ? osv-scanner errored (exit $rc)"; fail=1 ;;
  esac
fi

# ---- osv-scanner: dependency CVEs over globally installed software ----
# The second surface, and the one nothing else covers. The scan is the same binary and the
# same osv-scanner.toml, fed a CycloneDX SBOM built from the inventory `tools/updates` already
# keeps — a fourth scanner would be a fourth thing to keep current, and a second reader of
# `cargo install --list` would be the two-owners failure this repository has already paid for.
#
# Every branch that cannot scan says so and sets `setup`, never `fail`: an inventory that
# could not be read is not evidence that the software on this machine is clean.
echo
echo "▸ osv-scanner · globally installed (cargo install, npm -g)"
if ! command -v osv-scanner >/dev/null 2>&1; then
  echo "  ⚠ osv-scanner not installed — this surface was not scanned"
  setup=1
elif [ ! -x "$SJEL_ROOT/tools/updates" ]; then
  echo "  ⚠ tools/updates not reachable — this surface was not scanned"
  setup=1
elif ! command -v jq >/dev/null 2>&1; then
  echo "  ⚠ jq not installed — this surface was not scanned"
  setup=1
else
  # --offline asks for the INSTALLED versions, which is this pass's whole question. What is
  # newer than them is `sjel update`'s question, and asking a registry here would make the
  # audit depend on three of them.
  #
  # --inventory, not the default payload, and that is the difference between a gesture and a
  # scan: `rows` is the actionable view, and for npm it is the top level only. Measured on this
  # host, that is 13 packages against 1825 nodes in the tree, and a CVE does not stop at the
  # top level. The whole inventory is what this pass scans.
  globals_inv="$("$SJEL_ROOT/tools/updates" --json --offline --inventory 2>/dev/null || true)"

  globals_dir="$(mktemp -d "${TMPDIR:-/tmp}/sjel-globals.XXXXXX")"
  printf '%s' "$globals_inv" > "$globals_dir/inventory.json"
  globals_bom="$globals_dir/globals.cdx.json"
  jq -c '{
      bomFormat: "CycloneDX", specVersion: "1.5", version: 1,
      components: [ .inventory[]?
        | select(.ecosystem == "npm" or .ecosystem == "crates.io")
        | select(.name != "" and .version != "")
        | { type: "library", name: .name, version: .version,
            purl: (if .ecosystem == "crates.io"
                   then "pkg:cargo/\(.name)@\(.version)"
                   else "pkg:npm/\(.name | gsub("@"; "%40"))@\(.version)" end) }
      ] }' "$globals_dir/inventory.json" > "$globals_bom" 2>/dev/null
  globals_n="$(jq '.components | length' "$globals_bom" 2>/dev/null || echo 0)"

  # An installed crate's transitive tree is the Cargo.lock published inside it, because
  # `cargo install --locked` — the command `tools/updates` plans — resolves exactly that file.
  # Read rather than re-resolved, so what is scanned is what is installed. Copied into one
  # directory per crate because osv-scanner identifies a lockfile by its NAME, and each copy
  # is its own half of the scan.
  mkdir -p "$globals_dir/locks"
  jq -r '.inventory[]? | select(.ecosystem == "crates.io") | "\(.name)-\(.version)"' \
    "$globals_dir/inventory.json" 2>/dev/null | while read -r crate; do
    [ -n "$crate" ] || continue
    for lf in "${CARGO_HOME:-$HOME/.cargo}"/registry/src/*/"$crate"/Cargo.lock; do
      [ -f "$lf" ] || continue
      mkdir -p "$globals_dir/locks/$crate"
      cp "$lf" "$globals_dir/locks/$crate/Cargo.lock"
    done
  done
  globals_locks="$(find "$globals_dir/locks" -name Cargo.lock 2>/dev/null | wc -l | tr -d ' ')"

  if ! jq -e '.inventory | type == "array"' "$globals_dir/inventory.json" >/dev/null 2>&1; then
    echo "  ⚠ tools/updates returned no inventory — this surface was not scanned"
    setup=1
  elif [ "${globals_n:-0}" = "0" ]; then
    # A real state, not a failure: nothing was installed by either manager. Reported as such
    # rather than as "clean", because an empty SBOM proves nothing about the machine.
    echo "  · nothing installed by cargo or npm — nothing to scan"
  else
    echo "  · ${globals_n} installed package(s) and ${globals_locks} crate lockfile(s)"
    # -L, not --sbom: 2.6.0 deprecates --sbom in favour of -L and accepts a CycloneDX file
    # under either name (measured 2026-10-03). -r over the lockfile directory walks only the
    # copies made above, and each lockfile is named in the finding's SOURCE column so a
    # transitive hit says which installed crate carries it.
    #
    # --verbosity error, and the trade is real: at the default verbosity this pass also lists
    # osv-scanner.toml's entries as "unused ignores", because the crates they cover are in the
    # repository's build graph and not among this machine's installed ones. That listing
    # appears directly under a repository pass that just used them, and it reads as an
    # invitation to delete them. The cost of silencing it is that an exception applying to an
    # installed package would be swallowed rather than named — no current entry does (each
    # reason names a repository path), and the remedy for an installed finding is `sjel update`
    # rather than an exception. The finding table and the exit code are unaffected either way.
    osv-scanner scan source -r -L "$globals_bom" --config "$SJEL_ROOT/osv-scanner.toml" \
      --verbosity error "$globals_dir/locks"
    rc=$?
    case "$rc" in
      0) echo "  ✓ clean" ;;
      1) echo "  ✗ vulnerabilities found above"; fail=1 ;;
      *) echo "  ? osv-scanner errored (exit $rc)"; fail=1 ;;
    esac
  fi
  rm -rf "$globals_dir"
fi

echo
[ "$setup" -eq 1 ] && echo "── a scanner is not installed; its surface was not scanned ──"
if [ "$fail" -ne 0 ]; then
  echo "── audit: finding(s) — see above ──"
  exit 1
fi
[ "$setup" -ne 0 ] && exit 2
echo "── audit: clean ──"
exit 0
