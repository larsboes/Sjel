#!/bin/bash
# axon-context — emit bounded, current context for one Axon target.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
SJEL_ROOT="$(cd "$TOOLS_DIR/.." && pwd)"
mode="${1:-}"
target="${2:-}"

usage() {
  echo "usage: axon context with [capability] | on [unit-or-path]" >&2
  exit 1
}

print_path_if_present() {
  [ -e "$SJEL_ROOT/$1" ] && echo "read=$1"
}

context_with() {
  local registry row
  registry="$("$SJEL_ROOT/tools/capability.sh" registry)"
  echo "mode=with"
  echo "repo=$SJEL_ROOT"
  if [ -z "$target" ]; then
    echo "capabilities:"
    printf '%s\n' "$registry" | jq -r '.[] | "  \(.name)\tkind=\(.kind)\thttp=\(if .port == "" then "none" else "registered" end)"'
    echo "next=axon capability list"
    return
  fi
  row="$(printf '%s\n' "$registry" | jq -c --arg name "$target" '.[] | select(.name == $name)' | head -n 1)"
  if [ -z "$row" ]; then
    echo "axon context: unknown capability '$target'" >&2
    printf '%s\n' "$registry" | jq -r '.[].name' >&2
    exit 1
  fi
  echo "target=$target"
  echo "registry=$row"
  print_path_if_present "capabilities/$target/README.md"
  print_path_if_present "capabilities/$target/service.toml"
  echo "next=axon capability url $target"
}

unit_from_target() {
  case "$1" in
    capabilities/*|libs/*|Packs/*) printf '%s\n' "$1" | cut -d/ -f2 ;;
    dashboard/*|tools/*|schemas/*) printf '%s\n' "$1" | cut -d/ -f1 ;;
    *) echo "$1" ;;
  esac
}

context_on() {
  local normalized unit
  echo "mode=on"
  echo "repo=$SJEL_ROOT"
  git -C "$SJEL_ROOT" status --short --branch
  if [ -z "$target" ]; then
    "$SJEL_ROOT/tools/self" status
    echo "read=README.md"
    echo "next=axon doctor"
    return
  fi
  normalized="${target#./}"
  if [ -e "$SJEL_ROOT/$normalized" ]; then
    unit="$(unit_from_target "$normalized")"
    echo "target=$normalized"
  else
    unit="$target"
    echo "target=$target"
  fi
  "$SJEL_ROOT/tools/self" explain "$unit" --json 2>/dev/null || echo "self=unavailable-for-$unit"
  print_path_if_present "capabilities/$unit/README.md"
  print_path_if_present "capabilities/$unit/service.toml"
  print_path_if_present "capabilities/$unit/Cargo.toml"
  print_path_if_present "libs/$unit/README.md"
  print_path_if_present "libs/$unit/Cargo.toml"
  print_path_if_present "Packs/$unit/README.md"
  print_path_if_present "Packs/$unit/pack.toml"
  print_path_if_present "$normalized"
  echo "next=axon doctor"
}

case "$mode" in
  with) context_with ;;
  on) context_on ;;
  *) usage ;;
esac
