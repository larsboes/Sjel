{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axon.local/schemas/content-item.schema.json",
  "title": "Sjel Content Item",
  "description": "Canonical reader contract. Source adapters extend content without creating a second reader model.",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "id",
    "kind",
    "title",
    "url",
    "author",
    "summary",
    "content",
    "content_label",
    "day",
    "created_at",
    "status",
    "content_status",
    "data_class",
    "processing_policy",
    "cloud_processing",
    "relevance",
    "evaluation",
    "processing",
    "origins",
    "links",
    "digest",
    "mail",
    "calendar"
  ],
  "properties": {
    "schema_version": { "const": "content-item-v2" },
    "source": { "enum": ["feed", "mail", "calendar"] },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "url": {
      "type": "string",
      "format": "uri-reference",
      "description": "Where this item lives. An absolute URI for anything with an external home (a feed article, a Gmail deep link); a root-relative dashboard path for an item whose only home is Sjel itself, which is why this is uri-reference and not uri."
    },
    "author": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "content": { "type": ["string", "null"] },
    "content_label": { "type": "string", "minLength": 1 },
    "day": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "content_status": { "enum": ["full", "thin", "none", "unknown"] },
    "data_class": { "$ref": "#/$defs/dataClass" },
    "processing_policy": { "$ref": "#/$defs/processingPolicy" },
    "cloud_processing": { "$ref": "#/$defs/cloudProcessingState" },
    "relevance": {
      "type": "array",
      "items": { "$ref": "#/$defs/relevance" }
    },
    "evaluation": {
      "oneOf": [
        { "$ref": "#/$defs/evaluation" },
        { "type": "null" }
      ]
    },
    "processing": {
      "type": "array",
      "items": { "$ref": "#/$defs/processing" }
    },
    "origins": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin" }
    },
    "links": {
      "type": "array",
      "description": "Named ways out of this item: the source page, the mail that carried the ticket, a map, a vault note. Shared vocabulary rather than a per-capability payload key, because every source was about to invent it separately.",
      "items": { "$ref": "#/$defs/link" }
    },
    "digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "mail": {
      "oneOf": [
        { "$ref": "#/$defs/mailExtension" },
        { "type": "null" }
      ]
    },
    "calendar": {
      "oneOf": [
        { "$ref": "#/$defs/calendarExtension" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "dataClass": {
      "type": "object",
      "description": "Stored trust classification, ranked by how exposed the content is: c0 Public (published work) < c1 Mine (the operator's own notes, plans, drafts) < c2 Others (facts about named people — health, money, relationships, addresses) < c3 Secret (credentials, tokens, keys, recovery codes). The literal is what a row stores; the label is the word the product uses. An item that never had a class declared for it reads back as c1/legacy — the fail-closed default, not an absent field.",
      "required": ["value", "label", "rationale", "method", "version"],
      "properties": {
        "value": { "enum": ["c0", "c1", "c2", "c3"] },
        "label": { "enum": ["Public", "Mine", "Others", "Secret"] },
        "rationale": { "type": "string", "minLength": 1 },
        "method": { "$ref": "#/$defs/classificationMethod" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "classificationMethod": {
      "description": "Who decided, ranked: legacy (0, nobody did — a backfilled or undeclared row) < deterministic (10, a collector declaration or a rule) < model (20) < human (30). One vocabulary for every classification in the contract, shared with the processing tier so a reader compares two decisions without a translation table. The rank is what makes escalation-only expressible: a decision may only be replaced by one of equal or higher rank, and only a human may lower a class.",
      "enum": ["legacy", "deterministic", "model", "human"]
    },
    "processingPolicy": {
      "type": "object",
      "description": "Derived permission boundary; it records eligibility and never proves that pseudonymization occurred.",
      "required": ["local_processing", "cloud_handling", "pseudonymization_required", "rationale"],
      "properties": {
        "local_processing": { "enum": ["allowed", "blocked"] },
        "cloud_handling": { "enum": ["eligible", "pseudonymization_required", "blocked"] },
        "pseudonymization_required": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cloudProcessingState": {
      "type": "object",
      "description": "Local approval plus explicit cloud execution state. Only a running or later state implies a provider call.",
      "required": ["status", "preview_hash", "approved_at", "dispatch_status", "job_id", "provider_role", "queued_at", "provider_calls", "task", "started_at", "completed_at", "last_error", "result"],
      "properties": {
        "status": { "enum": ["not_prepared", "staged", "stale"] },
        "preview_hash": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] },
        "dispatch_status": { "enum": ["not_queued", "queued", "running", "succeeded", "failed"] },
        "job_id": { "type": ["string", "null"] },
        "provider_role": { "type": ["string", "null"] },
        "queued_at": { "type": ["string", "null"] },
        "provider_calls": { "type": "integer", "minimum": 0, "maximum": 5 },
        "task": { "type": ["string", "null"], "enum": ["content-analysis-v1", null] },
        "started_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] },
        "last_error": { "type": ["string", "null"] },
        "result": {
          "oneOf": [
            { "$ref": "cloud-content-analysis.schema.json" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "required": ["profile_key", "profile_label", "score", "rationale", "mode", "profile_revision"],
      "properties": {
        "profile_key": { "type": "string" },
        "profile_label": { "type": "string" },
        "score": { "type": "number" },
        "rationale": { "type": "string" },
        "mode": { "enum": ["reranked", "semantic", "lexical"] },
        "profile_revision": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["overall_score", "explanation", "mode", "item_revision", "context_revision", "evaluator_revision", "evaluated_at", "factors"],
      "properties": {
        "overall_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "explanation": { "type": "string" },
        "mode": { "type": "string" },
        "item_revision": { "type": "string" },
        "context_revision": { "type": "string" },
        "evaluator_revision": { "type": "string" },
        "evaluated_at": { "type": "string" },
        "factors": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": ["stage", "tier", "revision", "completed_at"],
      "properties": {
        "stage": { "type": "string" },
        "tier": { "type": "string" },
        "revision": { "type": "string" },
        "completed_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": ["source_id", "source_ref", "label"],
      "properties": {
        "source_id": { "type": "string" },
        "source_ref": { "type": "string" },
        "label": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["label", "kind", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "A hint for presentation (mail, source, ticket, map, vault). Deliberately open: a reader that meets an unknown kind still renders a working link."
        },
        "url": { "type": "string", "format": "uri-reference" }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "description": "What the local model wrote about this item, and what was asked of it. Distinct from summary, which is what the source itself said it is — a reader wanting the short version prefers digest.text and falls back to summary. text is null unless state is 'generated'; 'skipped_short' is a verdict about the source, not a failure.",
      "required": [
        "text",
        "state",
        "shape",
        "depth",
        "focus",
        "producer",
        "source_chars",
        "redactions",
        "attempts",
        "last_error",
        "diagram",
        "diagram_state",
        "diagram_error",
        "chart",
        "chart_state",
        "chart_error",
        "generated_at"
      ],
      "properties": {
        "text": { "type": ["string", "null"] },
        "state": {
          "enum": [
            "generated",
            "skipped_short",
            "remote_refused",
            "local_refused",
            "unconfigured",
            "http_error",
            "model_error",
            "capacity_aborted",
            "empty_response",
            "timeout"
          ]
        },
        "shape": {
          "enum": ["none", "brief", "standard", "sectioned"],
          "description": "The rung the length ladder landed on. Derived from source_chars, never chosen directly."
        },
        "depth": {
          "enum": ["standard", "detailed"],
          "description": "'detailed' moves the shape exactly one rung up the same ladder — it is not a separate instruction to the model."
        },
        "focus": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "The operator's focus terms, as typed, so a differently-shaped digest is explained rather than mysterious."
        },
        "producer": { "type": "string", "minLength": 1 },
        "source_chars": { "type": "integer", "minimum": 0 },
        "redactions": {
          "type": "integer",
          "minimum": 0,
          "description": "Entities the deterministic redactor removed before this text was written. Non-zero only for c2 and c3 content, where a digest could otherwise republish what the subject line was redacted for."
        },
        "attempts": { "type": "integer", "minimum": 0 },
        "last_error": { "type": ["string", "null"] },
        "diagram": {
          "type": ["string", "null"],
          "description": "Mermaid source, validated against the known diagram headers before it was stored."
        },
        "diagram_state": { "type": ["string", "null"] },
        "diagram_error": { "type": ["string", "null"] },
        "chart": {
          "oneOf": [
            { "$ref": "#/$defs/chartData" },
            { "type": "null" }
          ]
        },
        "chart_state": { "type": ["string", "null"] },
        "chart_error": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "chartData": {
      "type": "object",
      "description": "A chartable table pulled out of the item's source text. Deliberately not a chart specification: the reader compiles one, so a model never reaches the rendering layer. Every value appeared verbatim in the source before it was admitted, and one measure is the maximum by design — the figure palette is a low-chroma print palette that cannot carry categorical identity.",
      "required": ["title", "category_label", "measure_label", "unit", "mark", "note", "rows"],
      "properties": {
        "title": { "type": "string" },
        "category_label": { "type": "string" },
        "measure_label": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "mark": {
          "enum": ["bar", "line"],
          "description": "Derived from the categories, never chosen by a model: an ordered sequence of three or more gets a line, everything else bars."
        },
        "note": { "type": "string" },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "type": "object",
            "required": ["category", "value"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "value": { "type": "number" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "calendarExtension": {
      "type": "object",
      "description": "What only a calendar entry has: it occupies time, and the operator has taken a position on it. There is no score here on purpose — a decided item is not ranked.",
      "required": ["starts_at", "ends_at", "all_day", "commitment", "location", "notes", "entry_source", "rhythm_id"],
      "properties": {
        "starts_at": { "type": "string", "minLength": 1 },
        "ends_at": { "type": "string", "minLength": 1, "description": "Exclusive, as everywhere in calendar." },
        "all_day": { "type": "boolean" },
        "commitment": { "enum": ["possible", "planned", "committed"] },
        "location": { "type": ["string", "null"] },
        "notes": {
          "type": ["string", "null"],
          "description": "The operator's own note — why they care. Distinct from `summary`, which describes what the thing is. No machine writes this."
        },
        "entry_source": {
          "type": "string",
          "minLength": 1,
          "description": "Which adapter contributed the row (manual, luma, google) — not the item's `source`, which is always `calendar`. A reader needs it to know which actions are honest: an entry imported from Google must not offer to export back to Google."
        },
        "rhythm_id": {
          "type": ["string", "null"],
          "description": "Set when the entry was materialized from a rhythm. A rhythm instance is not exported individually, and any patch detaches it from its rhythm."
        }
      },
      "additionalProperties": false
    },
    "mailExtension": {
      "type": "object",
      "required": ["category", "rationale", "classification_method", "classification_version", "gmail_action", "gmail_action_at", "purge_after", "gmail_location", "gmail_observed_at", "gmail_sync_status", "gmail_sync_action", "gmail_sync_error"],
      "properties": {
        "category": { "enum": ["aktiv", "issue", "feed", "werbung", "belege", "steuern", "sonstiges"] },
        "rationale": { "type": "string" },
        "classification_method": { "$ref": "#/$defs/classificationMethod" },
        "classification_version": { "type": "string" },
        "gmail_action": { "type": ["string", "null"], "enum": ["archive", "trash", "restore", null] },
        "gmail_action_at": { "type": ["string", "null"] },
        "purge_after": { "type": ["string", "null"] },
        "gmail_location": { "type": ["string", "null"], "enum": ["inbox", "archive", "trash", "missing", null] },
        "gmail_observed_at": { "type": ["string", "null"] },
        "gmail_sync_status": { "type": ["string", "null"], "enum": ["synced", "queued", "retrying", "attention", null] },
        "gmail_sync_action": { "type": ["string", "null"], "enum": ["archive", "trash", "restore", null] },
        "gmail_sync_error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "mail" } }, "required": ["source"] },
      "then": { "properties": { "mail": { "$ref": "#/$defs/mailExtension" } } },
      "else": { "properties": { "mail": { "type": "null" } } }
    },
    {
      "if": { "properties": { "source": { "const": "calendar" } }, "required": ["source"] },
      "then": { "properties": { "calendar": { "$ref": "#/$defs/calendarExtension" } } },
      "else": { "properties": { "calendar": { "type": "null" } } }
    },
    {
      "comment": "A source without a ranking pipeline must leave the ranking empty rather than synthesise one. This is the constraint that kept score: 0.0 and matched_focus: 'Scholarship Profile' off real calendar entries.",
      "if": { "properties": { "source": { "const": "calendar" } }, "required": ["source"] },
      "then": {
        "properties": {
          "relevance": { "type": "array", "maxItems": 0 },
          "evaluation": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
