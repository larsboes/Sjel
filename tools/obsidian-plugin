#!/bin/bash
# tools/obsidian-plugin — build a Pack's Obsidian plugin, and install it into the vault.
#
#   tools/obsidian-plugin <name> build     rebuild Packs/*/plugins/<name>/dist/main.js from src/
#   tools/obsidian-plugin <name> install   build, then copy into the active vault's .obsidian/plugins/
#
# Builds the plugins that have src/main.ts: interactive (knowledge Pack), pi-learn (learning Pack).
# The first line of dist/main.js records the SHA-256 of src/. tools/obsidian-plugin.test.ts
# fails when src/ changes without a rebuild. Install keeps the previous bundle in
# .obsidian/<name>-plugin.prev.XXXXXX/, outside the plugins folder. Existing backups remain.
# bash 3.2-safe (CONTRIBUTING.md#portable-shell).
set -euo pipefail

SJEL_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

usage() { echo "usage: tools/obsidian-plugin <name> build|install" >&2; exit 2; }

NAME="${1:-}"
[ -n "$NAME" ] || usage
PLUGIN=""
for dir in "$SJEL_ROOT"/Packs/*/plugins/"$NAME"; do
  [ -f "$dir/src/main.ts" ] && PLUGIN="$dir"
done
[ -n "$PLUGIN" ] || { echo "no Pack plugin named '$NAME' with src/main.ts" >&2; exit 2; }

src_hash() {
  (cd "$PLUGIN" && find src -name '*.ts' | LC_ALL=C sort | xargs cat) | shasum -a 256 | cut -d' ' -f1
}

build() {
  tmp="$(mktemp -d)"
  # Desktop-only plugins reach Node built-ins (child_process) through Electron's require.
  bun build "$PLUGIN/src/main.ts" --target browser --format cjs --external obsidian \
    --external child_process --outfile "$tmp/main.js" >/dev/null
  mkdir -p "$PLUGIN/dist"
  { echo "// src-sha256: $(src_hash)"; cat "$tmp/main.js"; } > "$PLUGIN/dist/main.js"
  rm -rf "$tmp"
  echo "built $PLUGIN/dist/main.js"
}

install_plugin() {
  vault="$(python3 "$SJEL_ROOT/Packs/knowledge/skills/obsidian/scripts/vault" root)"
  dest="$vault/.obsidian/plugins/$NAME"
  prev=""
  mkdir -p "$dest"
  if [ -f "$dest/main.js" ]; then
    prev="$(mktemp -d "$vault/.obsidian/$NAME-plugin.prev.XXXXXX")"
    for file in main.js manifest.json styles.css; do
      [ ! -f "$dest/$file" ] || cp "$dest/$file" "$prev/"
    done
  fi
  cp "$PLUGIN/dist/main.js" "$PLUGIN/manifest.json" "$PLUGIN/styles.css" "$dest/"
  echo "installed into $dest; reload the plugin in Obsidian to activate it"
}

case "${2:-}" in
  build) build ;;
  install) build && install_plugin ;;
  *) usage ;;
esac
