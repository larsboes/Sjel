#!/bin/bash
# capabilities/host-firewall — a default-deny host firewall for a Linux node, rendered from
# the active overlay's declaration (Axon#193).
#
# Axon did not ship a host-firewall capability, so a consumer had to assemble both the rules
# and the deployment logic in its private overlay — even though almost none of that behaviour
# is specific to a machine. What IS machine-specific is exactly four things: which interface
# faces the network, which interfaces are trusted, which sources may connect, and which ports
# they may reach. Those are inputs. Everything else — the default-deny posture, the
# established/related accept, loopback, the ICMP subset IPv6 cannot live without, and the
# ordering that makes all of it correct — is the same everywhere and belongs here.
#
#   host-firewall render     the complete effective ruleset, to stdout. Changes nothing.
#   host-firewall check      validate the overlay's inputs, and the ruleset if nft is present
#   host-firewall apply      install the ruleset behind a countdown that rolls back on silence
#   host-firewall rollback   restore the ruleset saved by the last apply
#   host-firewall status     what is loaded right now
#
# Exit 0 = ok, 1 = violation/refusal, 2 = usage error. bash 3.2-safe (README.md#portable-shell).
#
# LOCKOUT RECOVERY — the contract, because a firewall is the one capability that can sever the
# hand applying it. `apply` never installs a ruleset permanently in one step:
#
#   1. the current ruleset is saved to <overlay>/data/host-firewall/previous.nft
#   2. the new ruleset is installed
#   3. a detached countdown restores the saved ruleset after confirm_seconds
#   4. `host-firewall confirm` cancels the countdown; anything else — a dropped SSH session,
#      a closed laptop, a rule that blocked the operator — lets it fire
#
# So the failure mode of a wrong rule is "the connection comes back in a minute", not "drive
# to the machine". That property is why apply exists here rather than as an `nft -f` in a
# runbook. Applying to a real host and proving its effective policy are still the overlay's
# work, per Axon#193 — this file owns the shape and the safety, not the rollout.

set -u

_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=../../tools/lib/paths.sh
source "$_dir/../../tools/lib/paths.sh"

CONFIG="${SJEL_HOST_FIREWALL_CONFIG:-$SJEL_PERSONAL_ROOT/config/host-firewall.toml}"
STATE="$SJEL_PERSONAL_ROOT/data/host-firewall"
SAVED="$STATE/previous.nft"

die()  { echo "host-firewall: $*" >&2; exit 2; }
usage() { sed -n '2,20p' "$0"; }

require_config() {
  [ -f "$CONFIG" ] || die "no config at $CONFIG
  Copy capabilities/host-firewall/host-firewall.toml.example there and fill it in for this
  machine. Axon ships no interface, network or port — a default would be a guess about your
  topology, and the wrong guess here is a lockout."
  WAN="$(toml_get wan_interface "$CONFIG")"
  [ -n "$WAN" ] || die "$CONFIG declares no wan_interface"
  ALLOW_PING="$(toml_get allow_ping "$CONFIG")"; ALLOW_PING="${ALLOW_PING:-true}"
}

# --- render ------------------------------------------------------------------
#
# One nftables inet table, so v4 and v6 share one policy rather than drifting apart — the
# classic way an IPv6 hole outlives the IPv4 rule that was supposed to close it.
#
# Rule ORDER is the correctness argument, not style:
#   1. established/related first, so an accepted connection's return traffic never re-derives
#      permission from a later rule (and so a mistake below cannot kill the session applying it)
#   2. loopback, unconditionally
#   3. ICMP/ICMPv6 — the required subset before any drop
#   4. trusted interfaces
#   5. the declared ports, source-scoped
#   6. everything else falls off the end into the table's `policy drop`
render() {
  local iface net port proto p
  require_config

  echo "#!/usr/sbin/nft -f"
  echo "# Generated by capabilities/host-firewall from ${CONFIG##*/}. Do not edit by hand:"
  echo "# 'host-firewall apply' re-renders, and a hand edit is lost without being noticed."
  echo
  echo "table inet axon_filter"
  echo "delete table inet axon_filter"
  echo
  echo "table inet axon_filter {"
  echo "  chain input {"
  echo "    type filter hook input priority filter; policy drop;"
  echo
  echo "    # 1. return traffic for connections already permitted. First, deliberately: this"
  echo "    #    is also what keeps the session running 'apply' alive while later rules load."
  echo "    ct state established,related accept"
  echo "    ct state invalid drop"
  echo
  echo "    # 2. loopback is never filtered. Never an input either — a host that cannot talk"
  echo "    #    to itself fails in ways that look like anything but a firewall."
  echo "    iif lo accept"
  echo
  echo "    # 3. ICMP. Not a courtesy: without these, IPv6 neighbour discovery fails and path"
  echo "    #    MTU discovery breaks on both families, which presents as random stalls."
  echo "    icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, nd-router-solicit, packet-too-big, time-exceeded, parameter-problem, destination-unreachable } accept"
  echo "    icmp   type { destination-unreachable, time-exceeded, parameter-problem } accept"
  if [ "$ALLOW_PING" = "true" ]; then
    echo "    icmp   type echo-request accept   # allow_ping = true"
    echo "    icmpv6 type echo-request accept   # allow_ping = true"
  else
    echo "    # allow_ping = false — echo-request is not accepted (the required subset above still is)"
  fi
  echo

  echo "    # 4. trusted interfaces — the boundary for these is the network, not this filter."
  for iface in $(toml_array trusted_interfaces "$CONFIG"); do
    echo "    iifname \"$iface\" accept"
  done
  echo

  echo "    # 5. declared ports, scoped to declared sources."
  for p in $(toml_array permitted_ports "$CONFIG"); do
    port="${p%%/*}"; proto="${p##*/}"
    net_count=0
    for net in $(toml_array permitted_networks "$CONFIG"); do
      net_count=$((net_count + 1))
      case "$net" in
        *:*) echo "    ip6 saddr $net iifname \"$WAN\" $proto dport $port accept" ;;
        *)   echo "    ip  saddr $net iifname \"$WAN\" $proto dport $port accept" ;;
      esac
    done
    # No declared source is not a silent "any": it is rendered as one, and `check` warns.
    [ "$net_count" -eq 0 ] && echo "    iifname \"$WAN\" $proto dport $port accept   # any source — permitted_networks is empty"
  done
  for p in $(toml_array public_ports "$CONFIG"); do
    port="${p%%/*}"; proto="${p##*/}"
    echo "    iifname \"$WAN\" $proto dport $port accept   # public_ports: any source, declared deliberately"
  done
  echo
  echo "    # 6. anything not matched above meets 'policy drop' at the top of this chain."
  echo "  }"
  echo
  echo "  chain forward { type filter hook forward priority filter; policy drop; }"
  echo "  # output is deliberately NOT filtered: a default-deny egress policy on a host that"
  echo "  # runs containers and package managers is a maintenance burden that gets disabled"
  echo "  # within a week, and a rule everyone disables is worse than no rule."
  echo "  chain output  { type filter hook output  priority filter; policy accept; }"
  echo "}"
}

cmd_render() { render; }

# --- check -------------------------------------------------------------------

cmd_check() {
  local violations=0 p port proto net
  require_config
  echo "host-firewall · ${CONFIG##*/}"

  for p in $(toml_array permitted_ports "$CONFIG") $(toml_array public_ports "$CONFIG"); do
    port="${p%%/*}"; proto="${p##*/}"
    case "$proto" in tcp|udp) ;; *) echo "  ✗ '$p' — protocol must be tcp or udp" >&2; violations=$((violations + 1)) ;; esac
    case "$port" in ''|*[!0-9]*) echo "  ✗ '$p' — port is not a number" >&2; violations=$((violations + 1)) ;; esac
  done

  net="$(toml_array permitted_networks "$CONFIG" | grep -c .)"
  if [ "$net" -eq 0 ] && [ "$(toml_array permitted_ports "$CONFIG" | grep -c .)" -gt 0 ]; then
    echo "  ⚠ permitted_networks is empty — every permitted_port is reachable from any source."
    echo "    That may be what you want; it is not what the field name suggests, so it is said out loud."
  fi

  # The strongest check available without touching the host: hand the rendered ruleset to nft
  # in check-only mode. Absent nft, say the check did not run rather than let silence read as
  # a pass — the same rule the advisory gate follows.
  if command -v nft >/dev/null 2>&1; then
    if render | nft -c -f - 2>/dev/null; then
      echo "  ✓ nft parses the rendered ruleset (nft -c, nothing loaded)"
    elif [ "$(id -u)" -ne 0 ]; then
      # nft -c still opens netlink, which an unprivileged user cannot; that is not a verdict
      # on the ruleset. Say so, the same way the nft-absent branch does.
      echo "  ○ nft present but check needs root — ruleset syntax unchecked, not passed (re-run as root for the verdict)"
    else
      echo "  ✗ nft rejects the rendered ruleset:" >&2
      render | nft -c -f - 2>&1 | sed 's/^/      /' >&2
      violations=$((violations + 1))
    fi
  else
    echo "  ○ nft not installed — ruleset syntax unchecked, not passed (this is a macOS host, or a node without nftables)"
  fi

  [ "$violations" -eq 0 ] && { echo "host-firewall: inputs valid"; return 0; }
  echo "host-firewall: $violations violation(s)" >&2
  return 1
}

# --- apply / rollback --------------------------------------------------------

cmd_apply() {
  local confirm_seconds="${1:-60}"
  command -v nft >/dev/null 2>&1 || die "nft not installed — this capability applies to a Linux host with nftables"
  [ "$(id -u)" -eq 0 ] || die "apply needs root. Axon does not escalate on your behalf; re-run:
  sudo $0 apply"
  cmd_check >/dev/null || die "inputs are invalid — refusing to apply. Run 'host-firewall check'."

  mkdir -p "$STATE"
  nft list ruleset > "$SAVED" 2>/dev/null || : > "$SAVED"
  echo "host-firewall: saved current ruleset → $SAVED"

  render | nft -f - || die "load failed — nothing changed"
  echo "host-firewall: ruleset loaded"

  # Detached, so it survives this shell dying — which is precisely the case it exists for.
  ( sleep "$confirm_seconds"
    if [ -f "$STATE/confirmed" ]; then rm -f "$STATE/confirmed"; exit 0; fi
    nft -f "$SAVED" 2>/dev/null
    logger -t host-firewall "rolled back: not confirmed within ${confirm_seconds}s" 2>/dev/null
  ) >/dev/null 2>&1 &

  echo
  echo "  ⏳ Rolling back in ${confirm_seconds}s unless you confirm. If you are locked out, wait."
  echo "     Confirm with:  $0 confirm"
}

cmd_confirm() {
  mkdir -p "$STATE"
  : > "$STATE/confirmed"
  echo "host-firewall: confirmed — the countdown will not roll back"
}

cmd_rollback() {
  [ -f "$SAVED" ] || die "no saved ruleset at $SAVED — nothing to roll back to"
  [ "$(id -u)" -eq 0 ] || die "rollback needs root: sudo $0 rollback"
  nft -f "$SAVED" || die "restore failed"
  echo "host-firewall: restored the ruleset saved at the last apply"
}

cmd_status() {
  if command -v nft >/dev/null 2>&1; then
    nft list table inet axon_filter 2>/dev/null || echo "host-firewall: axon_filter is not loaded"
  else
    echo "host-firewall: nft not installed on this host"
  fi
  [ -f "$SAVED" ] && echo "host-firewall: a rollback point exists at $SAVED"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true
case "$cmd" in
  render)   cmd_render ;;
  check)    cmd_check ;;
  apply)    cmd_apply "$@" ;;
  confirm)  cmd_confirm ;;
  rollback) cmd_rollback ;;
  status)   cmd_status ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$cmd'" ;;
esac
