#!/usr/bin/env bash
# tools/phone-install — build the iPhone app from this tree and install it on a paired iPhone.
#
# Before 2026-09-25 no script or document said how the phone app was built, and the command
# had to be inferred from the artifacts in dashboard/src-tauri/gen/apple/build.
#
#   tools/phone-install            build, then install on the one paired physical iPhone
#   tools/phone-install <udid>     build, then install on that device
#   tools/phone-install --no-build install the last built IPA
#
# The build is a debug build, signed by the team in dashboard/src-tauri/tauri.conf.json. It
# builds the working tree, so uncommitted changes ship too: the script says so and continues.
# The wireless link to the phone drops now and then (seen 2026-09-25: "Connection reset by
# peer"), so the install is tried twice.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DASH="$ROOT/dashboard"
IPA="$DASH/src-tauri/gen/apple/build/arm64/Sjel.ipa"

build=1
device=""
for arg in "$@"; do
  case "$arg" in
    --no-build) build=0 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) device="$arg" ;;
  esac
done

if [ -n "$(git -C "$ROOT" status --porcelain -- dashboard)" ]; then
  echo "phone-install: dashboard/ has uncommitted changes; they are in this build" >&2
fi

if [ "$build" = 1 ]; then
  log="$(mktemp -t sjel-ios-build)"
  echo "phone-install: building (log: $log)"
  if ! (cd "$DASH" && cargo tauri ios build --debug) >"$log" 2>&1; then
    tail -30 "$log" >&2
    echo "phone-install: build failed; full log: $log" >&2
    exit 1
  fi
fi
[ -f "$IPA" ] || { echo "phone-install: no IPA at $IPA; run without --no-build" >&2; exit 1; }

if [ -z "$device" ]; then
  # The UDID column of a paired, physical iPhone. Exactly one, or ask for it.
  matches="$(xcrun devicectl list devices 2>/dev/null \
    | grep -E 'iPhone' | grep -E 'physical' | grep -E 'available \(paired\)' || true)"
  count="$(printf '%s' "$matches" | grep -c . || true)"
  if [ "$count" != 1 ]; then
    echo "phone-install: found $count paired physical iPhones; pass a UDID:" >&2
    xcrun devicectl list devices >&2
    exit 1
  fi
  device="$(printf '%s\n' "$matches" | grep -oE '[0-9A-F]{8}-[0-9A-F]{16}|[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}' | head -1)"
fi

out=""
for attempt in 1 2; do
  if out="$(xcrun devicectl device install app --device "$device" "$IPA" 2>&1)"; then
    echo "phone-install: installed $(basename "$IPA") ($(date -r "$IPA" '+%Y-%m-%d %H:%M')) on $device"
    exit 0
  fi
  echo "phone-install: install attempt $attempt failed" >&2
done
printf '%s\n' "$out" | tail -8 >&2
exit 1
